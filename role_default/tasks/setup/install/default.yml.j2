# Install: Manage basic resource setup, such as packages or service users.

---
- name: "Setup | Install | Default | Remove unwanted packages (e.g., to prevent conflicts or resolve incompatibilities)"
  ansible.builtin.package:
    name: "{{ '{{ __' + role_name + '_packages_removal }}' }}"
    state: "absent"
  when:
    - __{{ role_name }}_packages_removal is ansible.builtin.defined
    - (__{{ role_name }}_packages_removal | ansible.builtin.length) > 0

- name: "Setup | Install | Default | Install or upgrade packages"
  ansible.builtin.package:
    name: "{{ '{{ __' + role_name + '_packages_install }}' }}"
    state: "{{ '{{' }} 'latest' if ({{ role_name }}_autoupgrade | ansible.builtin.bool) else 'present' {{ '}}' }}"
  when:
    - __{{ role_name }}_packages_install is ansible.builtin.defined
    - (__{{ role_name }}_packages_install | ansible.builtin.length) > 0

- name: "Setup | Install | Default | Remove unwanted files and directories (e.g., to prevent conflicts or resolve incompatibilities)"
  ansible.builtin.file:
    path: "{{ '{{' }} __{{ role_name }}_removal_path_item {{ '}}' }}"
    state: "absent"
  when:
    - __{{ role_name }}_paths_removal is ansible.builtin.defined
    - (__{{ role_name }}_paths_removal | ansible.builtin.length) > 0
  loop: "{{ '{{ __' + role_name + '_paths_removal }}' }}"
  loop_control:
    loop_var: "__{{ role_name }}_removal_path_item"

- name: "Setup | Install | Default | Neutralize distribution config files (overwrite to survive package updates)"
  ansible.builtin.copy:
    dest: "{{ '{{' }} __{{ role_name }}_neutralize_item['key'] {{ '}}' }}"
    content: |
      {{ '{%' }} set prefix = __{{ role_name }}_neutralize_item['value'] {{ '-%}' }}
      {{ '{%' }} set path = __{{ role_name }}_neutralize_item['key'] {{ '-%}' }}
      {{ '{{' }} prefix {{ '}}' }} Managed by Ansible (foundata.{{ role_name }}.run)
      {{ '{{' }} prefix {{ '}}' }}
      {{ '{{' }} prefix {{ '}}' }} Content intentionally cleared. The original distribution file conflicted
      {{ '{{' }} prefix {{ '}}' }} with configuration managed by the foundata.{{ role_name }}.run role.
      {{ '{{' }} prefix {{ '}}' }}
      {{ '{{' }} prefix {{ '}}' }} To restore the original file content, reinstall the owning package:
      {{ '{%' }} if (ansible_facts['os_family'] | ansible.builtin.lower) == 'debian' {{ '%}' }}
      {{ '{{' }} prefix {{ '}}' }}   dpkg -S '{{ '{{' }} path {{ '}}' }}'  # find the package that owns this file
      {{ '{{' }} prefix {{ '}}' }}   apt-get install --reinstall <package>  # reinstall it to restore the original
      {{ '{%' }} elif (ansible_facts['os_family'] | ansible.builtin.lower) == 'suse' {{ '%}' }}
      {{ '{{' }} prefix {{ '}}' }}   rpm -qf '{{ '{{' }} path {{ '}}' }}'  # find the package that owns this file
      {{ '{{' }} prefix {{ '}}' }}   zypper install --force <package>  # reinstall it to restore the original
      {{ '{%' }} elif (ansible_facts['os_family'] | ansible.builtin.lower) == 'redhat' {{ '%}' }}
      {{ '{{' }} prefix {{ '}}' }}   rpm -qf '{{ '{{' }} path {{ '}}' }}'  # find the package that owns this file
      {{ '{{' }} prefix {{ '}}' }}   dnf reinstall <package>  # reinstall it to restore the original
      {{ '{%' }} else {{ '%}' }}
      {{ '{{' }} prefix {{ '}}' }}   Use your package manager to find the owning package and reinstall it.
      {{ '{%' }} endif {{ '%}' }}
    owner: "root"
    group: "root"
    mode: "u=rw,g=r,o=r" # 0644
  when:
    - __{{ role_name }}_paths_neutralize is ansible.builtin.defined
    - (__{{ role_name }}_paths_neutralize | ansible.builtin.length) > 0
  loop: "{{ '{{' }} __{{ role_name }}_paths_neutralize | ansible.builtin.dict2items {{ '}}' }}"
  loop_control:
    loop_var: "__{{ role_name }}_neutralize_item"
    label: "{{ '{{' }} __{{ role_name }}_neutralize_item['key'] {{ '}}' }}"
