#cloud-config
# cloud-init user-data of a Molecule test instance (NoCloud datasource).
# Rendered per platform by the create-libvirt.yml playbook. The "#cloud-config"
# marker above must stay on the very first line, cloud-init requires it there.
users:
  - name: "molecule"
    shell: "/bin/bash"
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    ssh_authorized_keys:
      - "{{ '{{' }} lookup('ansible.builtin.file', molecule_ephemeral_directory ~ '/id_ed25519.pub') {{ '}}' }}"
ssh_pwauth: false
package_update: true
packages:
  - "qemu-guest-agent"
runcmd:
  - ["systemctl", "enable", "--now", "qemu-guest-agent"]
