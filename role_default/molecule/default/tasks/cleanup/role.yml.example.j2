# Execute the role against all driver-created instances (cleanup / absent)
#
# SPDX-FileCopyrightText: {{ company | default('FIXME your organization') }}
# SPDX-License-Identifier: GPL-3.0-or-later

- name: "Molecule | Cleanup | Include the {{ role_name }} role"
  ansible.builtin.include_role:
    name: "{{ role_name }}"
  vars:
    {{ role_name }}_state: "absent"
