# Configuration for the Ansible Molecule "default" scenario.
#
# See the official documentation for details on this file and all settings:
# https://docs.ansible.com/projects/molecule/configuration/
#
# Each platform selects its backend via the "type" key: "podman" (container,
# the default when omitted) or "libvirt" (QEMU/KVM virtual machine). Use VM
# platforms for tests containers cannot cover (kernel settings, nested
# virtualization, Podman inside the test target, ...). Mixed scenarios are
# possible. See molecule/README.md for requirements and usage details.

---

driver:
  name: "default"
  options:
    managed: true
    # Resolved per instance from the instance config written by the create
    # playbooks, so "molecule login" works for containers and VMs alike.
    login_cmd_template: "{login_cmd}"


# Target platforms for testing
platforms:
  # Platform keys by backend type:
  #
  # type: "podman" (default when omitted) - containers using the foundata
  # Integration Test Target (ITT) images which aim to replicate a "VM-like"
  # testing environment and provide a fully functional systemd:
  #   image (required):          OCI image reference
  #   systemd (optional):        run a systemd entrypoint, usually true
  #
  # type: "libvirt" - QEMU/KVM virtual machines from vendor cloud images via a
  # session libvirt daemon (no root privileges needed):
  #   image (required):          URL of a cloud image (qcow2, cloud-init inside)
  #   ssh_port (required):       unique local port for the SSH port forward
  #   image_checksum (optional): e.g. "sha512:...", off by default (trust in
  #                              vendor and TLS, like the ":latest" ITT images)
  #   memory (optional):         RAM in MiB, default 2048
  #   vcpus (optional):          default 2
  #   disk_size (optional):      virtual disk size, default "10G"
  #
  # A commented "libvirt" alternate follows each container platform; swap the
  # active entry per platform to switch the backend.

  # Debian 13 (Trixie)
  - name: "molecule-debian13"
    image: "quay.io/foundata/debian13-itt:latest"
    systemd: true
