# ansible-lint YAML checks (see adjacent .ansible-lint). Details, reasoning:
# https://foundata.com/en/guidelines/ansible-playbooks/

---
extends: "default"

{# skeleton-variant: changelog-ignore #}
{# end skeleton-variant #}
rules:
  document-start:
    present: true
    level: "error"
  indentation:
    spaces: 2
    indent-sequences: true
  empty-lines:
    max: 2
    max-start: 0
    max-end: 0
  empty-values:
    forbid-in-block-mappings: true
    forbid-in-flow-mappings: true
    forbid-in-block-sequences: true
  new-line-at-end-of-file: "enable"
  new-lines:
    type: "unix"
  line-length:
    max: 160
  truthy:
    allowed-values:
      - "true"
      - "false"
    level: "error"
  quoted-strings:
    quote-type: "double"
    required: false
    allow-quoted-quotes: true

  comments:
    min-spaces-from-content: 1
  braces:
    min-spaces-inside: 1
    max-spaces-inside: 1
    min-spaces-inside-empty: 0
    max-spaces-inside-empty: 0
  brackets:
    forbid: "non-empty"
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
