# Role meta data
#
# SPDX-FileCopyrightText: {{ company | default('FIXME your organization') }}
# SPDX-License-Identifier: GPL-3.0-or-later

---
galaxy_info:
  role_name: "{{ role_name }}"
  description: {{ description | to_json(ensure_ascii=False) }}
  license: "GPL-3.0-or-later" # See https://spdx.org/licenses/ for valid IDs and syntax.
  author: {{ author | to_json(ensure_ascii=False) }}
  company: {{ company | to_json(ensure_ascii=False) }}

  standalone: true # This role not part of a collection (useful hint for ansible-lint)
  # Notable ansible-core control-node compatibility anchors:
  # - v2.12: Ubuntu 22.04 LTS
  # - v2.14: RHEL 9, Debian 12
  # - v2.16: RHEL 10, AAP 2.5-2.7 (default EE), Ubuntu 24.04 LTS
  # - v2.18: SLES 16
  # - v2.19: Debian 13
  # - v2.20: Ubuntu 26.04 LTS, Fedora 44
  # Raising this floor is a breaking release.
  min_ansible_version: "{{ min_ansible_version }}"
  # min_ansible_container_version:

  # repository_url: "{{ repository_url }}"
  # github_branch: "main"
  # documentation_url: "{{ documentation_url }}"
  # issue_tracker_url: "{{ issue_tracker_url }}" # Use only if the issue tracker is separate from the repository.
  # homepage_url: "{{ homepage_url }}"
  galaxy_tags: [] # Remove the "[]" when adding values to this list. Tags are single alphanumeric words, with a maximum of 20 tags.

# Roles that this role requires to be installed.
dependencies: []
