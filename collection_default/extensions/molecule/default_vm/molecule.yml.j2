# Configuration for the Ansible Molecule "default_vm" scenario.
#
# See the official documentation for details on this file and all settings:
# https://docs.ansible.com/projects/molecule/configuration/
#
# This scenario uses libvirt (qemu:///session) with QEMU/KVM to create and
# manage a virtual machine based testing environment. See
# extensions/molecule/README.md for requirements and usage details.

---

driver:
  name: "default"
  options:
    managed: false
    # Placeholders are resolved from the instance config written by the
    # create-libvirt.yml playbook.
    login_cmd_template: >-
      ssh {address} -l {user} -p {port} -i {identity_file}
      -o IdentitiesOnly=yes -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null
    ansible_connection_options:
      ansible_connection: "ssh"


# Target platforms for testing
platforms:
  # Using vendor cloud images (qcow2, cloud-init included). Platform keys:
  #   image_url (required):      URL of the cloud image
  #   ssh_port (required):       unique local port for the SSH port forward
  #   image_checksum (optional): e.g. "sha512:...", off by default (trust in
  #                              vendor and TLS, like the ":latest" ITT images)
  #   memory (optional):         RAM in MiB, default 2048
  #   vcpus (optional):          default 2
  #   disk_size (optional):      virtual disk size, default "10G"

  # Debian 13 (Trixie)
  - name: "molecule-debian13"
    image_url: "https://cloud.debian.org/images/cloud/trixie/latest/debian-13-genericcloud-amd64.qcow2"
    ssh_port: 2201
  # Debian 12 (Bookworm)
  - name: "molecule-debian12"
    image_url: "https://cloud.debian.org/images/cloud/bookworm/latest/debian-12-genericcloud-amd64.qcow2"
    ssh_port: 2202

  # Ubuntu 26.04 LTS (Resolute Raccoon)
  - name: "molecule-ubuntu2604"
    image_url: "https://cloud-images.ubuntu.com/resolute/current/resolute-server-cloudimg-amd64.img" # .img == qcow2
    ssh_port: 2203
  # Ubuntu 24.04 LTS (Noble Numbat)
  - name: "molecule-ubuntu2404"
    image_url: "https://cloud-images.ubuntu.com/noble/current/noble-server-cloudimg-amd64.img" # .img == qcow2
    ssh_port: 2204
  # Ubuntu 22.04 LTS (Jammy Jellyfish)
  - name: "molecule-ubuntu2204"
    image_url: "https://cloud-images.ubuntu.com/jammy/current/jammy-server-cloudimg-amd64.img" # .img == qcow2
    ssh_port: 2205

  # AlmaLinux 10 (best effort RHEL 10 (Red Hat Enterprise Linux))
  - name: "molecule-almalinux10"
    image_url: "https://repo.almalinux.org/almalinux/10/cloud/x86_64/images/AlmaLinux-10-GenericCloud-latest.x86_64.qcow2"
    ssh_port: 2206
  # AlmaLinux 9 (best effort RHEL 9 (Red Hat Enterprise Linux))
  - name: "molecule-almalinux9"
    image_url: "https://repo.almalinux.org/almalinux/9/cloud/x86_64/images/AlmaLinux-9-GenericCloud-latest.x86_64.qcow2"
    ssh_port: 2207

  # CentOS Stream 10
  - name: "molecule-centosstream10"
    image_url: "https://cloud.centos.org/centos/10-stream/x86_64/images/CentOS-Stream-GenericCloud-10-latest.x86_64.qcow2"
    ssh_port: 2208
  # CentOS Stream 9
  - name: "molecule-centosstream9"
    image_url: "https://cloud.centos.org/centos/9-stream/x86_64/images/CentOS-Stream-GenericCloud-9-latest.x86_64.qcow2"
    ssh_port: 2209

  # Fedora 44 (no "latest" alias upstream; release images are immutable, bump the URL on new releases)
  - name: "molecule-fedora44"
    image_url: "https://download.fedoraproject.org/pub/fedora/linux/releases/44/Cloud/x86_64/images/Fedora-Cloud-Base-Generic-44-1.7.x86_64.qcow2"
    ssh_port: 2210
  # Fedora 43 (no "latest" alias upstream; release images are immutable, bump the URL on new releases)
  - name: "molecule-fedora43"
    image_url: "https://download.fedoraproject.org/pub/fedora/linux/releases/43/Cloud/x86_64/images/Fedora-Cloud-Base-Generic-43-1.6.x86_64.qcow2"
    ssh_port: 2211

  # openSUSE Leap 16.0 (unversioned alias alongside build-suffixed files)
  - name: "molecule-opensuseleap160"
    image_url: "https://download.opensuse.org/distribution/leap/16.0/appliances/Leap-16.0-Minimal-VM.x86_64-Cloud.qcow2"
    ssh_port: 2212


# Ansible dependencies (collections, roles) of this Molecule scenario
dependency:
  name: "galaxy"
  enabled: true
  options:
    requirements-file: "${MOLECULE_SCENARIO_DIRECTORY}/requirements.yml"
    ignore-certs: false
    ignore-errors: false


# Configuration parameters for Ansible to provision test infrastructure and
# enable Molecule to execute test scenarios against the provisioned environment.
# See the following for more information:
# https://docs.ansible.com/projects/molecule/configuration/#provisioner
# https://docs.ansible.com/projects/molecule/configuration/#molecule.interpolation.Interpolator.interpolate
provisioner:
  name: "ansible"
  inventory:
    links:
      hosts: "inventory/hosts.yml"
  config_options:
    defaults:
      # If roles are not found by Molecule, try to run molecule with an adjusted
      # MOLECULE_GLOB environment variable instead of setting roles_path and/or
      # collections_path. See molecule/README.md#faq-role-path-detection for details.
      verbosity: ${ANSIBLE_VERBOSITY:-0} # noqa
      display_args_to_stdout: ${ANSIBLE_DISPLAY_ARGS_TO_STDOUT:-false} # noqa
      # set forks >= number of test platforms for better performance
      forks: ${ANSIBLE_FORKS:-12} # noqa
      host_key_checking: false
      retry_files_enabled: false
    connection:
      pipelining: true
  playbooks:
    create: "../shared/playbooks/create-libvirt.yml"
    prepare: "../shared/playbooks/prepare.yml"
    converge: "../shared/playbooks/converge.yml"
    side_effect: "../shared/playbooks/side_effect.yml"
    verify: "../shared/playbooks/verify.yml"
    cleanup: "../shared/playbooks/cleanup.yml"
    destroy: "../shared/playbooks/destroy-libvirt.yml"


verifier:
  name: "ansible"
  enabled: true
