# Uninstall: Manage basic resource removal, such as packages or service users.
#
# SPDX-FileCopyrightText: {{ company | default('FIXME your organization') ~ (' <' ~ company_url ~ '>' if company_url | default('') else '') }}
# SPDX-License-Identifier: GPL-3.0-or-later

---
- name: "Setup | Uninstall | Remove packages"
  ansible.builtin.package:
    name: "{{ '{{ __run_' + collection_name + '_packages_uninstall }}' }}"
    state: "absent"
  when:
    - __run_{{ collection_name }}_packages_uninstall is ansible.builtin.defined
    - (__run_{{ collection_name }}_packages_uninstall | ansible.builtin.length) > 0
