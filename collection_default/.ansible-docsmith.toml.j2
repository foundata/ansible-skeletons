# DocSmith configuration for this project. Details:
# https://foundata.com/en/projects/ansible-docsmith/

[markdown_formatter]
command = [
  "rumdl", "fmt", "--config", "{config_dir}/.rumdl.toml",
  "--deny-config-warnings", "--no-cache", "--stderr",
  "--stdin-filename", "{readme}", "-",
]
mode = "stdin"
