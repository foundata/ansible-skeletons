"""Checks of this collection. ``nox -l`` lists them, DEVELOPMENT.md explains them.

A plain ``nox`` runs the default sessions. The formatting ones, for import
order, generated documentation and Markdown, rewrite first and then check. With
``CI=true`` in the environment they only check and fail on what a rewrite would
have changed. ``ansible-lint`` only reports, with or without ``CI=true``.

Arguments after ``--`` go to the session's tool unchanged, for example
``nox -s molecule -- test --platform-name molecule-debian13``.

Sessions defined here are foundata's own. The others come from antsibull-nox
and are configured in antsibull-nox.toml.
"""

import atexit
import hashlib
import json
import os
import re
import shutil
import signal
import socket
import stat
import sys
import tempfile
import time
from pathlib import Path

import nox

try:
    import antsibull_nox
    import antsibull_nox.sessions
except ImportError:
    print("Install antsibull-nox in the same Python environment as nox.")
    sys.exit(1)

import yaml  # a dependency of antsibull-nox

# Prefer Podman when both Podman and Docker are installed. Docker is still used
# when it is the only one. Override through the environment, for example with
# ANTSIBULL_NOX_CONTAINER_ENGINE=auto-prefer-docker.
os.environ.setdefault("ANTSIBULL_NOX_CONTAINER_ENGINE", "auto-prefer-podman")

# uv creates and fills the session environments much faster than virtualenv
# and pip. Without uv, nox falls back to virtualenv; --default-venv-backend
# on the command line still chooses another backend.
nox.options.default_venv_backend = "uv|virtualenv"

# Python's multiprocessing binds Unix sockets below TMPDIR (its forkserver is
# the default from Python 3.14 on), and Linux allows 108 bytes for a socket
# path. Below a deep checkout the sessions' TMPDIR is too long for that, so the
# sessions see a short link to the same directory instead, in a private
# directory below XDG_RUNTIME_DIR (or /var/tmp). Files stay on disk; the links
# go when their owning invocation ends. Orphans require explicit recovery.
TMPDIR_LIMIT = 64
"""Longest TMPDIR that leaves room for the socket names below it."""
_SHORT: list[tuple[Path, int, int]] = []

# Without TMPDIR, Python and antsibull-nox use /tmp, often a small tmpfs, for
# example for the collection copies that ansible-test runs in. The sessions use
# the user's private directory below /var/tmp instead, nox-<uid>, which every
# invocation shares; antsibull-nox removes its files there when it ends.
SCRATCH = Path("/var/tmp")


def _leave(_signal: int, _frame: object) -> None:
    """Turn SIGTERM into an exit, so that the exit handlers still run."""
    sys.exit(143)


signal.signal(signal.SIGTERM, _leave)


def _cleanup_short() -> None:
    """Clean only unchanged private directories allocated by this invocation."""
    for directory, device, inode in _SHORT:
        try:
            metadata = directory.lstat()
            if directory.is_symlink() or (metadata.st_dev, metadata.st_ino) != (
                device,
                inode,
            ):
                continue
            shutil.rmtree(directory)
        except OSError:
            pass
    _SHORT.clear()


def _short_path(directory: str) -> str:
    """Return ``directory``, or a short link to it when its path is too long."""
    target = Path(directory).absolute()
    if len(str(target)) <= TMPDIR_LIMIT:
        return str(target)
    try:
        if not _SHORT:
            runtime = Path(os.environ.get("XDG_RUNTIME_DIR", ""))
            usable = runtime.is_absolute() and runtime.is_dir()
            parent = runtime if usable else Path("/var/tmp")
            short = Path(tempfile.mkdtemp(prefix="nox.", dir=parent))
            metadata = short.lstat()
            _SHORT.append((short, metadata.st_dev, metadata.st_ino))
            atexit.register(_cleanup_short)
            (short / "owner.json").write_text(
                json.dumps(
                    {
                        "path": str(short),
                        "device": metadata.st_dev,
                        "inode": metadata.st_ino,
                        "pid": os.getpid(),
                        "host": socket.gethostname(),
                        "created": time.time(),
                    }
                )
                + "\n",
                encoding="utf-8",
            )
        directory = _SHORT[0][0]
        link = directory / str(len(list(directory.iterdir())))
        link.symlink_to(target, target_is_directory=True)
    except OSError:
        # Without a writable short directory the long path is all there is.
        return str(target)
    return str(link)


_create_tmp = nox.Session.create_tmp


def _create_tmp_on_a_short_path(self: nox.Session) -> str:
    """Create the session's temporary directory and name it by a short path."""
    tmpdir = _create_tmp(self)
    self.env["TMPDIR"] = _short_path(tmpdir)
    return tmpdir


def _default_tmpdir() -> None:
    """Without TMPDIR, set it to the user's private directory below SCRATCH."""
    if os.environ.get("TMPDIR"):
        return
    directory = SCRATCH / f"nox-{os.getuid()}"
    try:
        directory.mkdir(mode=0o700, exist_ok=True)
        metadata = directory.lstat()
        private = (
            stat.S_ISDIR(metadata.st_mode)
            and metadata.st_uid == os.getuid()
            and not metadata.st_mode & 0o077
        )
    except OSError:
        private = False
    if not private:
        print(
            f"{directory} is not a private directory of yours; using /tmp",
            file=sys.stderr,
        )
        return
    os.environ["TMPDIR"] = str(directory)


nox.Session.create_tmp = _create_tmp_on_a_short_path
_default_tmpdir()
if os.environ.get("TMPDIR"):
    os.environ["TMPDIR"] = _short_path(os.environ["TMPDIR"])

antsibull_nox.load_antsibull_nox_toml()

# True when CI=true is set: check only, never rewrite. Same switch as antsibull-nox.
CHECK_ONLY = antsibull_nox.IN_CI

# Collections the content under test needs. Molecule scenarios bring their own.
REQUIREMENT_FILES = [
    "requirements.yml",
    "tests/requirements.yml",
    "tests/integration/requirements.yml",
    "extensions/molecule/default/requirements.yml",
    "extensions/molecule/ee/requirements.yml",
]

# Absolute: the molecule session changes into "extensions" before it runs.
MOLECULE_PROJECT = Path("extensions").resolve()
MOLECULE_SCENARIO = MOLECULE_PROJECT / "molecule/default/molecule.yml"
# MOLECULE_WORKSPACE: ends container, image and VM names, see molecule().
WORKSPACE = re.compile(r"[a-z0-9][a-z0-9-]{0,31}")


def _prepare(session: nox.Session) -> dict[str, str]:
    """Install the collection and its dependencies into a temporary tree."""
    requirements: list[str | os.PathLike[str]] = [
        path for path in REQUIREMENT_FILES if Path(path).is_file()
    ]
    prepared = antsibull_nox.sessions.prepare_collections(
        session,
        install_in_site_packages=False,
        install_out_of_tree=True,
        extra_deps_files=requirements,
    )
    if prepared is None:
        session.error("Collection dependency preparation failed")
    return {"ANSIBLE_COLLECTIONS_PATH": str(prepared.current_place)}


@nox.session(name="runtime-check", default=True)
@antsibull_nox.sessions.install_packages(packages=["ansible-core", "pytest"])
def runtime_check(session: nox.Session) -> None:
    """Check the built artifact with only its runtime directories retained."""
    env = _prepare(session)
    for requirements in ("requirements.txt", "tests/unit/requirements.txt"):
        if Path(requirements).is_file():
            session.install("-r", requirements)
    session.run(
        "python",
        "tests/runtime_check.py",
        "--dependencies",
        env["ANSIBLE_COLLECTIONS_PATH"],
        *session.posargs,
    )


@nox.session(name="ansible-lint", default=True)
@antsibull_nox.sessions.install_packages(packages=["ansible-lint-foundata>=1.2.0"])
def ansible_lint(session: nox.Session) -> None:
    """ansible-lint with the foundata rules; it only reports.

    ansible-lint refuses its fix mode with this project's .yamllint and says so
    in every run: its formatter cannot meet the brace and comment rules. Correct
    the findings by hand.

    Then it lints the YAML examples of the READMEs and modules.
    """
    env = _prepare(session) if session.virtualenv.is_sandboxed else {}
    installed = session.run(
        "python",
        "-c",
        "from importlib.util import find_spec; "
        "print(find_spec('ansible_lint_foundata') is not None)",
        silent=True,
        env=env,
    )
    if installed == "True\n":
        # ansible-lint-foundata verify --project-dir .
        session.run(
            "python",
            "-m",
            "ansible_lint_foundata.cli",
            "verify",
            "--project-dir",
            ".",
            env=env,
        )
    elif installed == "False\n":
        session.warn(
            "ansible-lint-foundata is not installed; running stock rules only."
        )
    else:
        session.error("Could not determine whether ansible-lint-foundata is installed")
    # ansible-lint --offline --strict [arguments after "--"]
    session.run(
        "python",
        "-m",
        "ansiblelint",
        "--offline",
        "--strict",
        *session.posargs,
        env=env,
    )
    # The YAML examples of the READMEs and modules, see tests/examples_lint.py.
    # They name the collection's own content, which only the prepared tree has.
    if not env:
        session.warn("Without a prepared collection tree, examples are not linted.")
        return
    examples = Path(session.create_tmp()) / "examples"
    shutil.rmtree(examples, ignore_errors=True)
    # python tests/examples_lint.py <new directory>
    session.run("python", "tests/examples_lint.py", str(examples), env=env)


def _role_specs() -> list[Path]:
    """The roles' argument specs, which DocSmith documents."""
    return sorted(
        path
        for name in ("argument_specs.yml", "argument_specs.yaml")
        for path in Path("roles").glob(f"*/meta/{name}")
    )


# A default session only while a role has an argument spec. Nox reads the tree
# whenever it loads this file, so a role added later is documented and checked.
@nox.session(name="docs", default=bool(_role_specs()))
@antsibull_nox.sessions.install_packages(packages=["ansible-docsmith>=2.4.0", "rumdl"])
def docs(session: nox.Session) -> None:
    """Role documentation with DocSmith; regenerates it unless CI=true."""
    if not _role_specs():
        session.skip("No role has meta/argument_specs.yml; nothing to document")
    # ansible-docsmith validate .; ansible-docsmith generate . [--check]
    # .ansible-docsmith.toml formats the READMEs with rumdl before comparing.
    session.run("ansible-docsmith", "validate", ".")
    session.run(
        "ansible-docsmith", "generate", ".", *(["--check"] if CHECK_ONLY else [])
    )


@nox.session(name="helper-lint", default=True)
@antsibull_nox.sessions.install_packages(packages=["ruff"])
def helper_lint(session: nox.Session) -> None:
    """Ruff for Python helpers; fix imports and format unless CI=true."""
    if session.posargs:
        session.error("helper-lint has a fixed scope and accepts no arguments")
    # This variant has no antsibull-nox lint session, so all Python is covered here.
    candidates = [
        Path("plugins"),
        Path("extensions/molecule"),
        Path("tools"),
        Path("scripts"),
        *sorted(
            path
            for path in Path("tests").glob("*")
            if path.name != "output" and (path.is_dir() or path.suffix == ".py")
        ),
        *sorted(Path("roles").glob("*/files")),
    ]
    roots = [str(candidate) for candidate in candidates if candidate.exists()]
    if not roots:
        session.skip("No Python helpers found")
    options = [
        "--config",
        "ruff.toml",
        "--force-exclude",
        "--config",
        'include = ["*.py"]',
    ]
    files = session.run(
        "ruff",
        "check",
        "--quiet",
        "--show-files",
        "--no-fix",
        *options,
        *roots,
        silent=True,
    )
    if not files or not files.strip():
        session.skip("No Python helpers found after Ruff exclusions")
    if not CHECK_ONLY:
        session.run(
            "ruff",
            "check",
            "--select",
            "I",
            "--fix",
            "--no-unsafe-fixes",
            *options,
            *roots,
        )
        session.run("ruff", "format", *options, *roots)
    session.run("ruff", "check", "--no-fix", *options, *roots)
    session.run("ruff", "format", "--check", *options, *roots)


@nox.session(name="markdown", default=True)
@antsibull_nox.sessions.install_packages(packages=["rumdl"])
def markdown(session: nox.Session) -> None:
    """Markdown style with rumdl; formats unless CI=true."""
    if not CHECK_ONLY:
        # rumdl fmt --config .rumdl.toml .
        session.run("rumdl", "fmt", "--config", ".rumdl.toml", ".")
    # rumdl check --config .rumdl.toml .
    session.run("rumdl", "check", "--config", ".rumdl.toml", ".")


@nox.session(name="changelog", default=True)
@antsibull_nox.sessions.install_packages(packages=["antsibull-changelog"])
def changelog(session: nox.Session) -> None:
    """Changelog fragments and changelog.yaml with antsibull-changelog."""
    # antsibull-changelog lint
    # antsibull-changelog lint-changelog-yaml changelogs/changelog.yaml
    session.run("antsibull-changelog", "lint")
    session.run(
        "antsibull-changelog", "lint-changelog-yaml", "changelogs/changelog.yaml"
    )


def _platforms() -> list[tuple[str, str]]:
    """Platform names and types of the default scenario, in file order."""
    data = yaml.safe_load(MOLECULE_SCENARIO.read_text(encoding="utf-8"))
    return [(p["name"], p.get("type", "podman")) for p in data.get("platforms", [])]


def _scenario(arguments: list[str]) -> str | None:
    """The scenario that Molecule arguments name, "default" if they name none.

    None for --all or several scenarios: each scenario needs a state directory
    of its own, and Molecule takes one for all from the environment.
    """
    names = set()
    remaining = iter(arguments)
    for argument in remaining:
        if argument == "--":
            break
        if argument == "--all":
            return None
        if argument in ("-s", "--scenario-name"):
            names.add(next(remaining, ""))
        elif argument.startswith("--scenario-name="):
            names.add(argument.partition("=")[2])
        elif argument.startswith("-s") and not argument.startswith("--"):
            names.add(argument[2:])
    if len(names) > 1 or "" in names:
        return None
    return names.pop() if names else "default"


def _platform(arguments: list[str]) -> str | None:
    """The platform that Molecule arguments or MOLECULE_PLATFORM_NAME name, if any.

    As in Molecule, the last --platform-name wins over the environment.
    """
    name = None
    remaining = iter(arguments)
    for argument in remaining:
        if argument == "--":
            break
        if argument in ("-p", "--platform-name"):
            name = next(remaining, "")
        elif argument.startswith("--platform-name="):
            name = argument.partition("=")[2]
        elif argument.startswith("-p") and not argument.startswith("--"):
            name = argument[2:]
    if name is None:
        name = os.environ.get("MOLECULE_PLATFORM_NAME")
    return name or None


def _instances(scenario: str, platform: str | None) -> list[str]:
    """Platform names of a scenario whose instances the shared create makes.

    Only ``platform`` when one is named. A scenario with a create playbook of
    its own names what it creates itself.
    """
    path = MOLECULE_PROJECT / "molecule" / scenario / "molecule.yml"
    if not path.is_file():
        return []
    data = yaml.safe_load(path.read_text(encoding="utf-8")) or {}
    if ((data.get("driver") or {}).get("options") or {}).get("managed") is False:
        return []
    playbooks = (data.get("provisioner") or {}).get("playbooks") or {}
    if "shared/playbooks/" not in str(playbooks.get("create") or ""):
        return []
    return [
        item["name"]
        for item in data.get("platforms") or []
        if platform in (None, item["name"])
    ]


@nox.session(name="molecule", default=False)
# pycdlib: cloud-init seed images of the libvirt platforms (iso_create)
@antsibull_nox.sessions.install_packages(packages=["molecule", "pycdlib"])
def molecule(session: nox.Session) -> None:
    """Molecule: full "default" scenario, or any Molecule command after "--".

    Sessions in different directories can run at the same time. Each directory
    is a workspace: the scenarios name their containers, images and VMs
    "<platform name>-<workspace>", and the session keeps a scenario's state in
    ANSIBLE_HOME/tmp/molecule.<workspace>/<scenario>. The workspace is
    MOLECULE_WORKSPACE, by default eight hexadecimal digits of the SHA-256 of
    the "extensions" path, so the separate calls of a debug session find their
    instances again. MOLECULE_EPHEMERAL_DIRECTORY replaces the state directory.
    Two runs at once from one directory are not supported.
    """
    scenario = _scenario(session.posargs)
    if scenario is None:
        session.error("Name one scenario per call; each keeps its own state")
    digest = hashlib.sha256(str(MOLECULE_PROJECT).encode("utf-8")).hexdigest()
    key = os.environ.get("MOLECULE_WORKSPACE") or digest[:8]
    if not WORKSPACE.fullmatch(key):
        session.error("MOLECULE_WORKSPACE: use 1 to 32 of a-z, 0-9 and -")
    home = Path(os.environ.get("ANSIBLE_HOME", "~/.ansible")).expanduser()
    state = os.environ.get("MOLECULE_EPHEMERAL_DIRECTORY") or str(
        home / "tmp" / f"molecule.{key}" / scenario.replace("/", "--")
    )
    env = {
        **_prepare(session),
        "MOLECULE_WORKSPACE": key,
        "MOLECULE_EPHEMERAL_DIRECTORY": state,
    }
    session.log(f"Molecule workspace {key}, state directory {state}")
    platform = _platform(session.posargs)
    instances = [f"{name}-{key}" for name in _instances(scenario, platform)]
    if instances:
        session.log(f"Instance names: {', '.join(instances)}")
    with session.chdir("extensions"):
        if session.posargs:
            # molecule <arguments as given>
            session.run("molecule", *session.posargs, env=env)
            return
        platforms = _platforms()
        serial = os.environ.get("MOLECULE_SERIAL", "").lower() in ("1", "true")
        if "MOLECULE_SERIAL" not in os.environ:
            # Virtual machines are heavy: one at a time unless told otherwise.
            serial = any(kind == "libvirt" for _name, kind in platforms)
        if os.environ.get("MOLECULE_PLATFORM_NAME") or not serial:
            # molecule test --scenario-name default
            session.run("molecule", "test", "--scenario-name", "default", env=env)
            return
        for name, _kind in platforms:
            # molecule test --scenario-name default --platform-name <name>, per platform
            session.run(
                "molecule",
                "test",
                "--scenario-name",
                "default",
                "--platform-name",
                name,
                env=env,
            )


if __name__ == "__main__":
    nox.main()
