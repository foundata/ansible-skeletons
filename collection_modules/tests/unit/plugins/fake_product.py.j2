class FakeHttpClient:
    def __init__(self, fake: FakeProduct, base_url: str, **kwargs: Any) -> None:
        self.fake = fake

    def request(
        self,
        method: str,
        path: str,
        *,
        deadline: Any,
        headers: dict[str, str],
        body: bytes | None = None,
    ) -> Response:
        deadline.remaining()
        return self.fake.request(method, path, body, headers)


