"""Generic module runner and opt-in virtual time over a product-owned fake."""

from __future__ import annotations

import json
import math
from pathlib import Path
from types import ModuleType
from typing import Any, Callable

import pytest
from ansible.module_utils import basic
from ansible.module_utils.common import warnings

from ansible_collections.foundata.utils.plugins.module_utils import deadline

from .fake_product import connection, fake

__all__ = ("Clock", "RunModule", "connection", "fake")

RunModule = Callable[..., dict[str, Any]]


class Clock:
    """Virtual time shared by deadlines and synchronous fake polling."""

    def __init__(self, monkeypatch: pytest.MonkeyPatch) -> None:
        self.now = 0.0
        self._monkeypatch = monkeypatch

    def patch(self, module: ModuleType) -> None:
        """Replace a module's local time reference until the test ends."""
        self._monkeypatch.setattr(module, "time", self)

    def monotonic(self) -> float:
        return self.now

    def advance(self, seconds: float) -> None:
        """Model elapsed work without waiting or allowing time to go backwards."""
        if not math.isfinite(seconds) or seconds < 0:
            raise ValueError("seconds must be finite and non-negative")
        self.now += seconds

    def sleep(self, seconds: float) -> None:
        self.advance(seconds)


@pytest.fixture(autouse=True)
def reset_warnings(monkeypatch: pytest.MonkeyPatch) -> None:
    """Give each test fresh ansible-core process-global module warnings."""
    pending = warnings._global_warnings
    monkeypatch.setattr(warnings, "_global_warnings", type(pending)())


@pytest.fixture
def fake_clock(monkeypatch: pytest.MonkeyPatch) -> Clock:
    """Share virtual time with the real deadline; opt pollers in with patch()."""
    clock = Clock(monkeypatch)
    clock.patch(deadline)
    return clock


@pytest.fixture
def run_module(
    capsys: pytest.CaptureFixture[str],
    monkeypatch: pytest.MonkeyPatch,
    tmp_path: Path,
    connection: dict[str, Any],
) -> RunModule:
    def runner(main: Callable[[], None], **args: Any) -> dict[str, Any]:
        params = {
            **connection,
            "_ansible_remote_tmp": str(tmp_path),
            "_ansible_keep_remote_files": False,
            "_ansible_tracebacks_for": ["error"],
            **args,
        }
        monkeypatch.setattr(
            basic, "_ANSIBLE_ARGS", json.dumps({"ANSIBLE_MODULE_ARGS": params}).encode()
        )
        if hasattr(basic, "_ANSIBLE_PROFILE"):
            monkeypatch.setattr(basic, "_ANSIBLE_PROFILE", "legacy")
        with pytest.raises(SystemExit):
            main()
        return json.loads(capsys.readouterr().out)

    return runner
