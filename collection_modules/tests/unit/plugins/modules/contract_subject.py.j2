"""Product binding for test_contract.py; engine invariants are synthetic.

Use real creation arguments, valid identities and two values of one mutable
public field. Disable unsupported capabilities with a concrete skip reason.
No set field, boolean field, info module or deletion guard is required.

ASSIGNED names a server-assigned field absent from a predicted creation;
it defaults to RESOURCE.identifier.name. The shared tests index rows by
RESOURCE.keys, independent of the keys the fake uses to store them.
"""
# FIXME Bind the first researched resource, its fake and its entry points here;
# keep test_contract.py unchanged.

from __future__ import annotations

from typing import Any, Callable

# Preserve wrapping for maximum-length Galaxy identities.
