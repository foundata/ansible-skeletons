    {{ collection_name }}.plugins.module_utils._definitions import (
        FIXTURE,
    )
from ansible_collections.{{ namespace }}.\
    {{ collection_name }}.plugins.modules import (
        fixture,
        fixture_info,
    )
# isort: on
# fmt: on

from ..fake_product import (
    OLD_SECRET,
    SECRET,
    FakeProduct,
    Response,
    lost_response,
)

__all__ = ("OLD_SECRET", "lost_response")

RESOURCE = FIXTURE
ASSIGNED = RESOURCE.identifier.name
RESULT = "fixture"
KEY = "name"
IDENTITIES = ("example", "other", "third", "fourth", "fifth")
ARGS: dict[str, Any] = {}
VALUE = "value"
VALUES = ("first", "second")
SECRETS = (SECRET, "SYNTHETIC-key")
VERSION = "1.0.0"
CAPABILITIES = {"delete": True, "listing": True, "drop": True, "reject": True}
SKIP_REASONS: dict[str, str] = {}
VERSION_PATH = "/system/version"
OPERATION = f"{FIXTURE.name}:present"

main: Callable[[], None] = fixture.main
info_main: Callable[[], None] = fixture_info.main
INFO_MAIN: Callable[[], None] | None = info_main


def rows(fake: FakeProduct) -> dict[Any, dict[str, Any]]:
    """Stored records of the subject resource by server identifier."""
    return fake.rows


def add(fake: FakeProduct, **values: Any) -> Any:
    """Store a record named ``example`` unless ``values`` say otherwise."""
    return fake.add(**values)


def prepare_deletion(fake: FakeProduct) -> None:
    """Prepare instance-dependent deletion semantics for the deletion cases.

    Optional: set the fake's instance policy here when deletion otherwise
    unlists or retires a resource. Other contract cases keep the default policy.
    """


def lose_next(fake: FakeProduct, operation: str, callback: Callable[[], None]) -> None:
    """Run ``callback`` after the next create, update or delete took effect."""
    fake.lose_next(operation, callback)


def drop_next(fake: FakeProduct, operation: str) -> None:
    """Acknowledge the next update or delete without storing it."""
    fake.drop_next(operation)


def reject_next(fake: FakeProduct, operation: str) -> None:
    """Store the next write, then answer with a definitive validation rejection."""
    fake.after_write[operation] = lambda: Response(
        422, None, raw=b"<html>rejected</html>"
    )


def make_incomplete(fake: FakeProduct) -> None:
    """Make listings end early, so a complete listing cannot be established."""
    fake.inject_incomplete()


def fault(fake: FakeProduct, path: str, status: int) -> None:
    """Answer every request to ``path`` with ``status`` and an HTML body."""
    fake.faults[path] = lambda: Response(
        status, None, raw=b"<html>private upstream error</html>"
    )


def deny(fake: FakeProduct) -> None:
    """Refuse every later request as unauthenticated."""
    fake.auth_ok = False


def requested(fake: FakeProduct, path: str) -> int:
    """How many requests reached ``path``."""
    return sum(1 for _method, request, _body in fake.requests if request == path)


def add_dependent(fake: FakeProduct, identity: Any) -> None:
    """Make a dependent record refer to the record ``identity``."""
    fake.counter += 1
    fake.dependents[fake.counter] = {"id": fake.counter, "fixture_id": identity}
    fake.rows[identity]["dependent_ids"].append(fake.counter)


def stored_set(values: list[str]) -> Any:
    """A set field value as the fake stores it."""
    return list(values)
