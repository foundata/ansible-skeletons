from ansible_collections.{{ namespace }}.\
    {{ collection_name }}.plugins.modules import (
        fixture_info,
    )
# isort: on
# fmt: on

from ..conftest import RunModule
from ..fake_product import OLD_SECRET, SECRET, FakeProduct


@pytest.mark.parametrize("check", [False, True])
def test_info_reads_and_never_writes(
    fake: FakeProduct, run_module: RunModule, check: bool
) -> None:
    assert run_module(fixture_info.main, name="missing")["fixture"] is None
    key = fake.add(value="public")
    result = run_module(fixture_info.main, name="EXAMPLE", _ansible_check_mode=check)
    assert result["fixture"] == {
        "id": key,
        "name": "example",
        "value": "public",
        "enabled": True,
        "labels": [],
        "parent": "",
    }
    assert not result["changed"] and result["verified"] == "observed"
    assert "changed_fields" not in result and not fake.writes()
    result.pop("_ansible_new_secrets", None)
    assert OLD_SECRET not in json.dumps(result) and SECRET not in json.dumps(result)
