"""Internal activation workflow of the ``*_apply`` modules; not a public interface.

An activation module compares saved with loaded state for named objects,
applies when they differ or when asked to, and verifies afterwards.

A reply lost after the apply request was sent (a timeout, a dropped
connection or an undecodable body) proves nothing by itself. The module goes
on to verify only when an object named in ``verify`` drifted before: its
convergence shows that the apply ran, and a drifting object that stays out
of sync fails as not effective. Without such a difference, for example
``activate: always`` on objects already in sync, the module fails with the
outcome unknown and never sends the apply again.

The binding's ``compatibility_always`` decides when the product version is
checked: before the comparison when it is set, otherwise only before an
apply.
"""

from __future__ import annotations

import re
import time
from typing import Any, Callable

from ansible_collections.foundata.utils.plugins.module_utils import errors

# Keep dependency and local imports stable across rendered namespace ordering.
# isort: split
# Preserve wrapping for maximum-length Galaxy identities.
# fmt: off
# isort: off
from ansible_collections.{{ namespace }}.\
    {{ collection_name }}.plugins.module_utils import (
        _compat,
    )
from ansible_collections.{{ namespace }}.\
    {{ collection_name }}.plugins.module_utils._binding import (
        Binding,
    )
from ansible_collections.{{ namespace }}.\
    {{ collection_name }}.plugins.module_utils._client import (
        Client,
        ProductError,
        api_argument_spec,
    )
from ansible_collections.{{ namespace }}.\
    {{ collection_name }}.plugins.module_utils._engine import (
        fail,
    )
# isort: on
# fmt: on

SETTLE_SECONDS = 20.0
"""Longest wait for an applied change to become observable."""


def settle(
    client: Client,
    names: list[str],
    compare: Callable[[Client, list[str]], dict[str, str]],
    sleep: Any = time.sleep,
    limit: float | None = None,
) -> dict[str, str]:
    """Poll ``compare`` until no name drifts, within the shared deadline.

    Raises:
        ProductError: With code ``not_effective`` naming the drifting
            objects when the wait or the deadline ends first.
    """
    limit = SETTLE_SECONDS if limit is None else limit
    interval = 0.5
    waited = 0.0
    while True:
        status = compare(client, names)
        if "drift" not in status.values():
            return status
        remaining = min(limit - waited, client.deadline.remaining())
        if remaining <= 0:
            raise ProductError(
                category="verification",
                code="not_effective",
                fields=sorted(n for n, s in status.items() if s == "drift"),
            )
        delay = min(interval, remaining)
        sleep(delay)
        waited += delay
        interval = min(interval * 2, 4.0)


def argument_spec() -> dict[str, Any]:
    """Return a fresh specification of an activation module."""
    spec = api_argument_spec()
    spec["activate"] = {"type": "str", "default": "auto", "choices": ["auto", "always"]}
    spec["verify"] = {"type": "list", "elements": "str"}
    return spec


def run(
    module: Any,
    *,
    operation_id: str,
    label: str,
    name_pattern: str,
    compare: Callable[[Client, list[str]], dict[str, str]],
    apply: Callable[[Client], None],
    settle: Callable[[Client, list[str]], dict[str, str]],
) -> None:
    """Compare, apply when needed or asked, verify, and exit the module."""
    names: list[str] = list(dict.fromkeys(module.params["verify"] or []))
    operation = "validate"
    applied = False
    reply_lost = False
    try:
        if (module.params["activate"] == "auto" and not names) or not all(
            re.fullmatch(name_pattern, name) for name in names
        ):
            raise ProductError(code="validation_failed", fields=["verify"])
        client = Client(module.params)
        if Binding.compatibility_always:
            operation = "compatibility"
            _compat.check(module, client, operation_id)
        operation = "compare"
        before = compare(client, names)
        needed = module.params["activate"] == "always" or "drift" in before.values()
        result: dict[str, Any] = {
            "changed": needed,
            "activated": needed,
            "verified": "predicted"
            if module.check_mode and needed
            else (
                "unverifiable"
                if not before or "unverifiable" in before.values()
                else "observed"
            ),
            "verification": before,
        }
        if needed and not Binding.compatibility_always:
            operation = "compatibility"
            _compat.check(module, client, operation_id)
        if module.check_mode or not needed:
            module.exit_json(**result)
        operation = "apply"
        try:
            apply(client)
            applied = True
        except errors.ApiError as error:
            # A reply lost after sending (timeout, dropped connection, undecodable
            # body) is settled by the read-back only when something had drifted:
            # that drift's resolution proves the effect. Without a prior drift a
            # matching state proves nothing, so the failure stands.
            if error.category not in ("transport", "timeout", "response") or (
                "drift" not in before.values()
            ):
                raise
            reply_lost = True
        operation = "verify"
        result["verification"] = settle(client, names)
        if reply_lost:
            unresolved = sorted(
                name
                for name, status in before.items()
                if status == "drift" and result["verification"].get(name) != "in_sync"
            )
            if unresolved:
                raise ProductError(
                    category="verification", code="not_effective", fields=unresolved
                )
        result["verified"] = (
            "observed"
            if reply_lost
            else "unverifiable"
            if not result["verification"]
            or "unverifiable" in result["verification"].values()
            else "observed"
        )
        module.exit_json(**result)
    except errors.ApiError as error:
        fields: dict[str, Any] = {"operation": operation}
        if isinstance(error, ProductError) and error.fields:
            key = "not_effective" if error.code == "not_effective" else "fields"
            fields[key] = error.fields
        if operation not in ("apply", "verify"):
            changed, outcome = False, "unchanged"
        elif applied:
            changed, outcome = True, "changed"
        else:
            changed, outcome = True, "unknown"
        fail(
            module,
            error,
            msg=f"Activating the {label} failed during {operation}",
            changed=changed,
            outcome=outcome,
            fields=fields,
        )
