"""Binding of the skeleton's lifecycle base to this collection; internal.

Handwritten families subclass :class:`Family`: the client, the public error
schema and the compatibility check are this collection's own.
"""

from __future__ import annotations

from typing import Any

# Preserve wrapping for maximum-length Galaxy identities.
# fmt: off
# isort: off
from ansible_collections.{{ namespace }}.\
    {{ collection_name }}.plugins.module_utils import (
        _compat,
    )
