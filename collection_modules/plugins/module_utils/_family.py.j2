    {{ collection_name }}.plugins.module_utils._client import (
        SCHEMA,
        Client,
    )
from ansible_collections.{{ namespace }}.\
    {{ collection_name }}.plugins.module_utils._lifecycle import (
        Lifecycle,
    )
# isort: on
# fmt: on


class Family(Lifecycle):
    schema = SCHEMA

    def connect(self) -> Any:
        return Client(self.params)

    def compatibility(self, operation: str) -> None:
        _compat.check(self.module, self.client, operation)
