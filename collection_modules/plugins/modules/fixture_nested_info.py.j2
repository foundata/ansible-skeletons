def main() -> None:
    module = AnsibleModule(
        argument_spec=argument_spec(info=True), supports_check_mode=True
    )
    info = FixtureNestedInfo(module)
    info.execute(info.read, validate=info.check_identity)


if __name__ == "__main__":
    main()
