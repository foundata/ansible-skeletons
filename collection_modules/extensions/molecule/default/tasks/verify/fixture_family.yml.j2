# FIXME Add an independent product verifier when copying this family.
---
- name: "Verify the nested fixture family"
  module_defaults:
    group/{{ namespace }}.{{ collection_name }}.api: >-
      {{ '{{ product_connection }}' }}
  block:
    - name: "Read and compare the declared nested state"
      {{ namespace }}.{{ collection_name }}.fixture_family:
        name: "molecule_fixture_family"
        settings:
          network: "198.51.100.0/24"
          port: 8080
      check_mode: true
      register: __testing_family_verified

    - name: "Assert the saved public state"
      ansible.builtin.assert:
        that:
          - __testing_family_verified is not ansible.builtin.changed
          - __testing_family_verified['fixture_family']['settings']['port'] == 8080
