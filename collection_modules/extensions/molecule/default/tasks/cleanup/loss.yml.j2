---
- name: "Remove only loss-harness fixtures"
  module_defaults:
    group/{{ namespace }}.{{ collection_name }}.api: >-
      {{ '{{ product_connection }}' }}
  block:
    - name: "Remove the definition fixture"
      {{ namespace }}.{{ collection_name }}.fixture:
        name: "molecule_fixture_loss"
        state: "absent"

    - name: "Remove the nested fixture"
      {{ namespace }}.{{ collection_name }}.fixture_nested:
        name: "molecule_fixture_nested_loss"
        state: "absent"
