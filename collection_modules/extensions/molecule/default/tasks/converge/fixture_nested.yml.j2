---
- name: "Converge the nested fixture"
  module_defaults:
    group/{{ namespace }}.{{ collection_name }}.api: >-
      {{ '{{ product_connection }}' }}
  block:
    - name: "Save the nested scenario fixture"
      {{ namespace }}.{{ collection_name }}.fixture_nested:
        name: "molecule_fixture_nested"
        settings:
          network: "198.51.100.0/24"
          port: 8080
