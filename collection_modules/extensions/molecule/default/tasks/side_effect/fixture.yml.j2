# FIXME Qualify update, diff and recovery for the replacement resource.
---
- name: "Exercise a fixture update"
  module_defaults:
    group/{{ namespace }}.{{ collection_name }}.api: "{% raw %}{{ product_connection }}{% endraw %}"
  block:
    - name: "Save a changed value"
      {{ namespace }}.{{ collection_name }}.fixture:
        name: "molecule_fixture_example"
        value: "updated"
      diff: true
      register: __testing_fixture_updated

    - name: "Assert the update became effective"
      ansible.builtin.assert:
        that:
          - __testing_fixture_updated['changed_fields'] == ['value']
