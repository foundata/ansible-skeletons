# Ansible Galaxy dependencies required for the Molecule "default" scenario.
# The union of all backend dependencies is listed; unused ones are harmless.
#
# SPDX-FileCopyrightText: {{ company | default('FIXME your organization') }}
# SPDX-License-Identifier: GPL-3.0-or-later

---
roles: []

collections:
  # Container platforms (type: "podman")
  - "containers.podman"
  # VM platforms (type: "libvirt"): SSH keypair generation
  - "community.crypto"
  # VM platforms (type: "libvirt"): cloud-init NoCloud seed ISO creation via
  # iso_create, needs the "pycdlib" Python package in the Molecule virtual
  # environment
  - "community.general"
