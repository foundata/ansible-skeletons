import re

from ansible.module_utils.basic import AnsibleModule

from ansible_collections.foundata.utils.plugins.module_utils import errors

# Keep dependency and local imports stable across rendered namespace ordering.
# isort: split
from ansible_collections.{{ namespace }}.{{ collection_name }}.plugins.module_utils._client import (
    SCHEMA,
    Client,
    ProductError,
    api_argument_spec,
)
from ansible_collections.{{ namespace }}.{{ collection_name }}.plugins.module_utils._definitions import (
    FIXTURE,
)
from ansible_collections.{{ namespace }}.{{ collection_name }}.plugins.module_utils._engine import (
    Engine,
)


def main() -> None:
    spec = api_argument_spec()
    spec["name"] = {"type": "str", "required": True}
    module = AnsibleModule(argument_spec=spec, supports_check_mode=True)
    operation = "validate"
    try:
        name = module.params["name"]
        if not re.fullmatch(FIXTURE.keys[0].pattern, name):
            raise ProductError(code="validation_failed", fields=["name"])
        client = Client(module.params)
        operation = "find"
        engine = Engine(module, FIXTURE, client)
        found = engine.find({"name": name})
        public = engine.project(found) if found else None
        module.exit_json(changed=False, fixture=public, verified="observed")
    except errors.ApiError as error:
        errors.fail_from(
            module,
            error,
            schema=SCHEMA,
            msg="Reading the fixture failed",
            changed=False,
            outcome="unchanged",
            fields={"operation": operation},
        )


if __name__ == "__main__":
    main()
