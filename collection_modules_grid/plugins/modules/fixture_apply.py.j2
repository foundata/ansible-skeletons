from ansible.module_utils.basic import AnsibleModule

from ansible_collections.{{ namespace }}.{{ collection_name }}.plugins.module_utils import (
    _activation,
)
from ansible_collections.{{ namespace }}.{{ collection_name }}.plugins.module_utils._definitions import (
    FIXTURE,
)


def main() -> None:
    module = AnsibleModule(
        argument_spec=_activation.argument_spec(), supports_check_mode=True
    )
    _activation.run(
        module,
        operation_id="fixture_apply",
        label="fixture family",
        name_pattern=FIXTURE.keys[0].pattern,
        compare=_activation.compare_fixture,
        apply=_activation.apply_fixture,
        settle=_activation.settle_fixture,
    )


if __name__ == "__main__":
    main()
