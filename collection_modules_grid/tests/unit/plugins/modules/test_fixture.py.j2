def test_identity_validation_precedes_requests(
    fake: FakeProduct, run_module: RunModule
) -> None:
    result = run_module(fixture.main, name="example\n")
    assert result["failed"] and result["error_code"] == "validation_failed"
    assert result["outcome"] == "unchanged" and not fake.requests


def test_lifecycle(fake: FakeProduct, run_module: RunModule) -> None:
    created = run_module(fixture.main, name="example", value="first", enabled=False)
    assert created["changed"] and created["verified"] == "observed"
    assert created["changed_fields"] == []
    key = created["fixture"][FIXTURE.identifier.name]
    assert fake.grids["fixture"][key]["enabled"] == "0"
    assert not run_module(fixture.main, name="example", value="first", enabled=False)[
        "changed"
    ]
    updated = run_module(
        fixture.main, name="example", value="second", _ansible_diff=True
    )
    assert updated["changed_fields"] == ["value"]
    assert updated["diff"] == {
        "before": {"value": "first"},
        "after": {"value": "second"},
    }
    assert fake.writes()[-1][2] == {"fixture": {"value": "second"}}
    assert fake.grids["fixture"][key]["enabled"] == "0"
    deleted = run_module(fixture.main, name="example", state="absent")
    assert deleted["fixture"] is None and deleted["changed_fields"] == []
    assert not run_module(fixture.main, name="example", state="absent")["changed"]
    assert fake.grids["fixture"] == {}


@pytest.mark.parametrize("exists", [False, True])
@pytest.mark.parametrize("state", ["present", "absent"])
@pytest.mark.parametrize("diff", [False, True])
def test_check_mode(
    fake: FakeProduct, run_module: RunModule, exists: bool, state: str, diff: bool
) -> None:
    if exists:
        fake.add(value="old")
    result = run_module(
        fixture.main,
        name="example",
        value="new",
        state=state,
        _ansible_check_mode=True,
        _ansible_diff=diff,
    )
    assert result["verified"] == ("predicted" if result["changed"] else "observed")
    assert result["changed"] == (state == "present" or exists)
    assert ("diff" in result) == (diff and result["changed"])
    if not exists and state == "present":
        assert FIXTURE.identifier.name not in result["fixture"]
    assert not fake.writes()


def test_omission_null_empty_and_sets(fake: FakeProduct, run_module: RunModule) -> None:
    key = fake.add(value="keep", labels="a,b")
    assert not run_module(fixture.main, name="example", value=None, labels=["b", "a"])[
        "changed"
    ]
    assert run_module(fixture.main, name="example", labels=[])["changed"]
    assert fake.grids["fixture"][key]["value"] == "keep"
    assert fake.grids["fixture"][key]["labels"] == ""


@pytest.mark.parametrize("action", ["add_item", "set_item", "del_item"])
def test_lost_response_reconciles_once(
    fake: FakeProduct, run_module: RunModule, action: str
) -> None:
    if action != "add_item":
        fake.add()
    fake.after_write[action] = lost_response
    result = run_module(
        fixture.main,
        name="example",
        value="new",
        state="absent" if action == "del_item" else "present",
    )
    assert result["changed"] and result["verified"] == "observed"
    assert not result.get("failed") and len(fake.writes()) == 1


def test_complete_paginated_lookup(fake: FakeProduct, run_module: RunModule) -> None:
    for index in range(5):
        fake.add(name=f"item{index}")
    result = run_module(fixture.main, name="item4")
    assert not result["changed"]
    assert len([row for row in fake.requests if row[1].endswith("search_item")]) == 3


@pytest.mark.parametrize(
    "fault,code",
    [
        ("ambiguous", "ambiguous"),
        ("truncated", "incomplete_listing"),
        ("internal", "internal_object"),
    ],
)
def test_identity_refuses_writes(
    fake: FakeProduct, run_module: RunModule, fault: str, code: str
) -> None:
    key = fake.add()
    if fault == "ambiguous":
        fake.add()
    elif fault == "truncated":
        fake.total_offset = 1
    else:
        fake.grids["fixture"]["builtin"] = fake.grids["fixture"].pop(key)
    result = run_module(fixture.main, name="example", value="new")
    assert result["failed"] and result["error_code"] == code
    assert result["outcome"] == "unchanged" and not fake.writes()


