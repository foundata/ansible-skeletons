@pytest.mark.parametrize("failed", [False, True])
def test_no_secrets_in_serialized_result(
    fake: FakeProduct, run_module: RunModule, failed: bool
) -> None:
    fake.add()
    fake.auth_ok = not failed
    result = run_module(fixture.main, name="example", value="new", _ansible_diff=True)
    # Controller-only secret registration metadata is removed before displaying results.
    result.pop("_ansible_new_secrets", None)
    serialized = json.dumps(result)
    assert SECRET not in serialized and OLD_SECRET not in serialized
    assert result.get("failed", False) == failed


@pytest.mark.parametrize(
    "raw,code", [(b"\xff", "invalid_utf8"), (b"{", "invalid_json")]
)
def test_bad_wire_response(
    fake: FakeProduct, run_module: RunModule, raw: bytes, code: str
