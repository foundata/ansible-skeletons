    assert not fake.writes()


def test_unknown_write_outcome(fake: FakeProduct, run_module: RunModule) -> None:
    def lose_and_hide() -> None:
        fake.grids["fixture"].clear()
        lost_response()

    fake.after_write["add_item"] = lose_and_hide
    result = run_module(fixture.main, name="example")
    assert result["failed"] and result["changed"] and result["outcome"] == "unknown"
    assert len(fake.writes()) == 1


def test_invalid_integer_response(fake: FakeProduct, run_module: RunModule) -> None:
    definition = replace(
        FIXTURE,
        fields=(Field("value", "int", "Integer value"), *FIXTURE.fields[1:]),
    )
    key = fake.add()

    def main() -> None:
        module = AnsibleModule(
            argument_spec=build_spec(definition), supports_check_mode=True
        )
        run_resource(module, definition)

    for raw in ("--2", "\u00b2", "1.2"):
        fake.grids["fixture"][key]["value"] = raw
        result = run_module(main, name="example")
        assert result["failed"] and result["error_code"] == "schema"
        assert result["outcome"] == "unchanged" and not fake.writes()


def test_composite_identity_and_references(
    fake: FakeProduct, run_module: RunModule
) -> None:
    linked = fake.add(grid="other", name="parent")
    definition = replace(
        FIXTURE,
        keys=(*FIXTURE.keys, Key("scope", "Scope", r"[a-z]+\Z", default="local")),
        fields=(
            *FIXTURE.fields,
            Field(
                "links",
                "set",
                "Names",
                reference=Reference("/other", "name", FIXTURE.identifier),
            ),
        ),
    )

    def main() -> None:
        module = AnsibleModule(
            argument_spec=build_spec(definition), supports_check_mode=True
        )
        run_resource(module, definition)

    result = run_module(main, name="example", links=["parent"])
    assert not result.get("failed")
    assert result["fixture"]["links"] == ["parent"]
    assert next(iter(fake.grids["fixture"].values()))["links"] == linked
    assert not run_module(main, name="example", links=["parent"])["changed"]


@pytest.mark.parametrize("duplicate", [False, True])
def test_invalid_reference_precedes_write(
    fake: FakeProduct, run_module: RunModule, duplicate: bool
) -> None:
    if duplicate:
        fake.add(grid="other", name="parent")
        fake.add(grid="other", name="parent")
    definition = replace(
        FIXTURE,
        fields=(
            *FIXTURE.fields,
            Field(
                "links",
                "set",
                "Names",
                reference=Reference("/other", "name", FIXTURE.identifier),
            ),
        ),
    )

    def main() -> None:
        module = AnsibleModule(
            argument_spec=build_spec(definition), supports_check_mode=True
        )
        run_resource(module, definition)

    result = run_module(main, name="example", links=["parent"])
    assert result["error_category"] == "reference"
    assert not fake.writes()
