def test_check_prediction_validates_eligibility(
    fake: FakeProduct, run_module: RunModule, monkeypatch: pytest.MonkeyPatch
) -> None:
    monkeypatch.setattr(
        _compat, "EXCLUSIONS", {subject.OPERATION: (("1.0.0", "synthetic exclusion"),)}
    )
    result = run_module(subject.main, name="example", _ansible_check_mode=True)
    assert result["error_code"] == "ineligible" and not fake.writes()


def test_version_is_cached_but_each_operation_is_checked(
    fake: FakeProduct, connection: dict[str, Any], monkeypatch: pytest.MonkeyPatch
) -> None:
    params = {
        **connection,
        "validate_certs": True,
        "ca_path": None,
        "use_proxy": False,
        "timeout": 10,
        "deadline": 30,
    }
    client = Client(params)

    class Module:
        def warn(self, message: str) -> None:
            raise AssertionError(message)

    _compat.check(Module(), client, "first")
    monkeypatch.setattr(
        _compat, "EXCLUSIONS", {"second": (("1.0.0", "synthetic exclusion"),)}
    )
    with pytest.raises(ProductError, match="operation failed"):
        _compat.check(Module(), client, "second")
    assert subject.requested(fake, subject.VERSION_PATH) == 1
