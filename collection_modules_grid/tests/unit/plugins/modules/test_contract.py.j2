@pytest.mark.parametrize("kind", ["set", "names"])
def test_set_bounds_follow_the_definition_on_input(kind: str) -> None:
    field = Field("members", kind, "Members")
    assert normalize(field, ["x" * 150], input_value=True) == ["x" * 150]
    for values in (["x" * 151], [str(i) for i in range(257)]):
        with pytest.raises(ProductError):
            normalize(field, values, input_value=True)
    larger = replace(field, maximum_items=300, item_limit=255)
    values = [str(i) for i in range(257)] + ["x" * 151]
    assert normalize(larger, values, input_value=True) == values
    for values in (["x" * 256], [str(i) for i in range(301)]):
        with pytest.raises(ProductError):
            normalize(larger, values, input_value=True)
    unbounded = replace(field, maximum_items=None, item_limit=None)
    values = [str(i) for i in range(301)] + ["x" * 256]
    assert normalize(unbounded, values, input_value=True) == values
    for input_value in (False, True):
        for invalid in ([""], [None], "not-a-list"):
            with pytest.raises(ProductError):
                normalize(unbounded, invalid, input_value=input_value)


@pytest.mark.parametrize("kind", ["set", "names"])
def test_stored_sets_are_read_beyond_the_bounds(kind: str) -> None:
    field = Field("members", kind, "Members")
    values = [str(i) for i in range(301)] + ["x" * 256]
    assert normalize(field, values) == values


def test_set_minimum_and_item_pattern_apply_to_input() -> None:
    field = Field("members", "set", "Members", minimum_items=1, pattern=r"[a-z]+")
    assert normalize(field, ["ab"], input_value=True) == ["ab"]
    for invalid in ([], ["A1"]):
        with pytest.raises(ProductError):
            normalize(field, invalid, input_value=True)
    assert normalize(field, []) == []
    with pytest.raises(ProductError):
        normalize(field, ["A1"])


def test_map_bounds_follow_the_definition_on_input() -> None:
    field = Field("rights", "map", "Rights", choices=("read",))
    assert normalize(field, {"x" * 150: ["read"]}, input_value=True) == {
        "x" * 150: ["read"]
    }
    for invalid in ({"x" * 151: ["read"]}, {str(i): ["read"] for i in range(257)}):
        with pytest.raises(ProductError):
            normalize(field, invalid, input_value=True)
        assert normalize(field, invalid) == invalid
    unbounded = replace(field, maximum_items=None, item_limit=None)
    assert normalize(unbounded, {"x" * 151: ["read"]}, input_value=True) == {
        "x" * 151: ["read"]
    }
    with pytest.raises(ProductError):
        normalize(unbounded, {"": ["read"]})


def test_stored_strings_are_read_beyond_the_limit() -> None:
    field = Field("note", "str", "Note", limit=10)
    assert normalize(field, "x" * 11) == "x" * 11
    with pytest.raises(ProductError):
        normalize(field, "x" * 11, input_value=True)


def entry(resource: Resource) -> Callable[[], None]:
    def main() -> None:
        module = AnsibleModule(
            argument_spec=build_spec(resource), supports_check_mode=True
        )
        run_resource(module, resource)

    return main


def test_lifecycle_preserves_unmanaged_fields(
    fake: FakeProduct, run_module: RunModule
) -> None:
    created = run_module(
        subject.main, name="example", **{subject.VALUE: "first", subject.ENABLED: False}
    )
    identity = created[subject.RESULT][subject.RESOURCE.identifier.name]
    assert created["changed_fields"] == [] and created["verified"] == "observed"
    subject.rows(fake)[identity]["unmanaged"] = OLD_SECRET
    assert not run_module(subject.main, name="example", **{subject.VALUE: "first"})[
        "changed"
    ]
    changed = run_module(
        subject.main, name="example", **{subject.VALUE: "second"}, _ansible_diff=True
    )
    assert changed["changed_fields"] == [subject.VALUE]
    assert changed[subject.RESULT][subject.ENABLED] is False
    assert changed["diff"] == {
        "before": {subject.VALUE: "first"},
        "after": {subject.VALUE: "second"},
    }
    assert subject.rows(fake)[identity]["unmanaged"] == OLD_SECRET
    assert (
        run_module(subject.main, name="example", state="absent")[subject.RESULT] is None
    )
    count = len(fake.writes())
    assert not run_module(subject.main, name="example", state="absent")["changed"]
    assert len(fake.writes()) == count


def test_definition_can_allow_an_empty_identity_component(
    fake: FakeProduct, run_module: RunModule, monkeypatch: pytest.MonkeyPatch
) -> None:
    resource = replace(
        subject.RESOURCE, keys=(Key("name", "Optional component", r".*"),)
    )
    monkeypatch.setattr(Engine, "find", lambda self, ident: None)
    result = run_module(entry(resource), name="", _ansible_check_mode=True)
    assert not result.get("failed") and result[subject.RESULT]["name"] == ""
    assert not fake.writes()


@pytest.mark.parametrize("incomplete", [False, True])
def test_listing_is_complete_or_fails(
    fake: FakeProduct, run_module: RunModule, incomplete: bool
) -> None:
    for index in range(5):
        subject.add(fake, name=f"item{index}")
    if incomplete:
        subject.make_incomplete(fake)
    result = run_module(
        entry(replace(subject.RESOURCE, lookup="listing")), name="item4"
    )
    assert bool(result.get("failed")) == incomplete
    assert not fake.writes()
    if incomplete:
        assert result["error_code"] == "incomplete_listing"
    else:
        assert result[subject.RESULT]["name"] == "item4"


def test_ambiguous_listing_refuses_write(
    fake: FakeProduct, run_module: RunModule
) -> None:
    subject.add(fake)
    subject.add(fake)
    result = run_module(
        entry(replace(subject.RESOURCE, lookup="listing")),
        name="example",
        **{subject.VALUE: "new"},
    )
    assert result["error_code"] == "ambiguous" and not fake.writes()


@pytest.mark.parametrize("operation", ["create", "update", "delete"])
def test_lost_response_never_repeats_write(
    fake: FakeProduct, run_module: RunModule, operation: str
) -> None:
    if operation != "create":
        subject.add(fake)
    subject.lose_next(fake, operation, lost_response)
    result = run_module(
        subject.main,
        name="example",
        **{subject.VALUE: "new"},
        state="absent" if operation == "delete" else "present",
    )
    assert not result.get("failed") and result["verified"] == "observed"
    assert len(fake.writes()) == 1


def test_possible_write_then_failed_read_is_unknown(
    fake: FakeProduct, run_module: RunModule
) -> None:
    def fail_read() -> None:
        subject.deny(fake)
        lost_response()

    subject.lose_next(fake, "create", fail_read)
    result = run_module(subject.main, name="example")
    assert result["failed"] and result["changed"] and result["outcome"] == "unknown"
    assert len(subject.rows(fake)) == 1 and len(fake.writes()) == 1


def test_delete_acknowledgement_does_not_prove_absence(
    fake: FakeProduct, run_module: RunModule, monkeypatch: pytest.MonkeyPatch
) -> None:
    subject.add(fake)
    monkeypatch.setattr(Client, "delete", lambda self, resource, identity: None)
    result = run_module(subject.main, name="example", state="absent")
    assert result["failed"] and result["error_code"] == "still_present"
    assert result["changed"] and result["outcome"] == "unknown"
    assert result["operation"] == "verify" and result["name"] == "example"
    assert len(subject.rows(fake)) == 1


def test_failure_repeats_the_identity_the_schema_allows(
    fake: FakeProduct, run_module: RunModule, monkeypatch: pytest.MonkeyPatch
) -> None:
    for resource in RESOURCES:
        assert {key.name for key in resource.keys} <= set(SCHEMA.field_validators)
    subject.fault(fake, subject.VERSION_PATH, 500)
    result = run_module(subject.main, name="example")
    assert result["failed"] and result["name"] == "example"
    assert not result["changed"] and result["outcome"] == "unchanged"
    assert "resource" not in result
    # An identity the schema cannot publish is left out; the failure stays specific.
    resource = replace(
        subject.RESOURCE, keys=(Key("name", "Optional component", r".*"),)
    )
    monkeypatch.setattr(Engine, "find", lambda self, ident: None)
    result = run_module(entry(resource), name="")
    assert result["failed"] and "name" not in result
    assert result["error_code"] == "rejected"
    assert result["outcome"] == "unchanged" and not fake.writes()


@pytest.mark.parametrize(
    "names,reported",
    [
        (["displayName", "a name with spaces"], True),
        (["x" * 300], False),
        (["line\nbreak"], False),
        ([f"field{index}" for index in range(257)], False),
    ],
)
def test_failure_after_a_write_keeps_changed_and_outcome(
    fake: FakeProduct,
    run_module: RunModule,
    monkeypatch: pytest.MonkeyPatch,
    names: list[str],
    reported: bool,
) -> None:
    subject.add(fake)

    def mismatch(self: Engine, *args: Any) -> None:
        raise ProductError(category="verification", code="not_persisted", fields=names)

    monkeypatch.setattr(Engine, "verify", mismatch)
    result = run_module(subject.main, name="example", **{subject.VALUE: "new"})
    assert result["failed"] and result["changed"] and result["outcome"] == "unknown"
    assert result["operation"] == "verify" and len(fake.writes()) == 1
    if reported:
        assert result["error_code"] == "not_persisted" and result["fields"] == names
    else:
        assert (result["error_category"], result["error_code"]) == ("product", None)
        assert "fields" not in result and result["name"] == "example"


def test_stored_object_beyond_the_bounds_is_read_compared_and_deleted(
    fake: FakeProduct, run_module: RunModule
) -> None:
    labels = [f"label{index}" for index in range(257)] + ["x" * 151]
    subject.add(fake, **{subject.LABELS: subject.stored_set(labels)})
    read = run_module(subject.info_main, name="example")
    assert not read.get("failed")
    assert sorted(read[subject.RESULT][subject.LABELS]) == sorted(labels)
    compared = run_module(subject.main, name="example", **{subject.VALUE: ""})
    assert not compared.get("failed") and not compared["changed"]
    assert sorted(compared[subject.RESULT][subject.LABELS]) == sorted(labels)
    removed = run_module(subject.main, name="example", state="absent")
    assert not removed.get("failed") and removed["changed"]
    assert not subject.rows(fake)


@pytest.mark.parametrize(
    "status,category,code",
    [
        (401, "auth", "unauthenticated"),
        (403, "auth", "forbidden"),
        (422, "product", "validation_failed"),
        (500, "product", "rejected"),
    ],
)
def test_status_classification_needs_no_json(
    fake: FakeProduct, run_module: RunModule, status: int, category: str, code: str
) -> None:
    subject.fault(fake, subject.VERSION_PATH, status)
    result = run_module(subject.main, name="example")
    assert (result["error_category"], result["error_code"]) == (category, code)
    assert not fake.writes()


@pytest.mark.parametrize("state", ["present", "absent"])
@pytest.mark.parametrize("exists", [False, True])
@pytest.mark.parametrize("diff", [False, True])
def test_check_mode_and_secrets(
    fake: FakeProduct, run_module: RunModule, state: str, exists: bool, diff: bool
) -> None:
    if exists:
        subject.add(fake)
    result = run_module(
        subject.main,
        name="example",
        **{subject.VALUE: "new"},
        state=state,
        _ansible_check_mode=True,
        _ansible_diff=diff,
    )
    assert not fake.writes()
    assert result["verified"] == ("predicted" if result["changed"] else "observed")
    if not exists and state == "present":
        assert subject.RESOURCE.identifier.name not in result[subject.RESULT]
    secrets = result.pop("_ansible_new_secrets", [])
    assert set(secrets) <= {SECRET, "SYNTHETIC-key"}
    assert OLD_SECRET not in json.dumps(result) and SECRET not in json.dumps(result)


