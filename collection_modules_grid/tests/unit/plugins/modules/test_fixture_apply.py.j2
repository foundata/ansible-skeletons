def test_activation_converges(fake: FakeProduct, run_module: RunModule) -> None:
    key = fake.add(value="saved")
    applied = run_module(fixture_apply.main, verify=["example"])
    assert applied["changed"] and applied["activated"]
    assert applied["verified"] == "observed" and applied["verification"] == {
        "example": "in_sync"
    }
    assert fake.active[key]["value"] == "saved"
    assert not run_module(fixture_apply.main, verify=["example"])["changed"]
    assert run_module(fixture_apply.main, verify=["example"], activate="always")[
        "changed"
    ]
    fake.grids["fixture"].clear()
    assert run_module(fixture_apply.main, verify=["example"])["changed"]
    assert not fake.active
    assert not run_module(fixture_apply.main, verify=["example"])["changed"]


def test_check_predicts_without_write(fake: FakeProduct, run_module: RunModule) -> None:
    fake.add()
    result = run_module(
        fixture_apply.main, verify=["example"], _ansible_check_mode=True
    )
    assert (
        result["changed"] and result["activated"] and result["verified"] == "predicted"
    )
    assert result["verification"] == {"example": "drift"} and not fake.writes()


def test_check_on_in_sync_state_is_observed(
    fake: FakeProduct, run_module: RunModule
) -> None:
    fake.add()
    assert run_module(fixture_apply.main, verify=["example"])["changed"]
    writes = len(fake.writes())
    result = run_module(
        fixture_apply.main, verify=["example"], _ansible_check_mode=True
    )
    assert not result["changed"] and result["verified"] == "observed"
    assert result["verification"] == {"example": "in_sync"}
    assert len(fake.writes()) == writes


LOST_REPLIES = [
    ("timeout", "socket_timeout"),
    ("transport", "connection_failed"),
    ("response", "invalid_json"),
]


def lose(category: str, code: str) -> Callable[[], None]:
    def callback() -> None:
        raise errors.ApiError(
            "reply lost after the write", category=category, code=code
        )

    return callback


@pytest.mark.parametrize("category,code", LOST_REPLIES)
def test_lost_apply_reply_is_settled_by_reading_back(
    fake: FakeProduct, run_module: RunModule, category: str, code: str
) -> None:
    fake.add()
    fake.after_write["reconfigure"] = lose(category, code)
    result = run_module(fixture_apply.main, verify=["example"])
    assert not result.get("failed") and result["changed"] and result["activated"]
    assert result["verified"] == "observed" and len(fake.writes()) == 1


@pytest.mark.parametrize("category,code", LOST_REPLIES)
def test_lost_apply_reply_without_observed_resolution_is_unknown(
    fake: FakeProduct,
    run_module: RunModule,
    monkeypatch: pytest.MonkeyPatch,
    category: str,
    code: str,
) -> None:
    fake.add()
    fake.activate_ok = False
    monkeypatch.setattr(_activation, "SETTLE_SECONDS", 0.0)
    fake.after_write["reconfigure"] = lose(category, code)
    result = run_module(fixture_apply.main, verify=["example"])
    assert result["failed"] and result["changed"] and result["outcome"] == "unknown"
    assert result["error_code"] == "not_effective" and len(fake.writes()) == 1


def test_lost_apply_reply_with_unreadable_state_is_unknown(
    fake: FakeProduct, run_module: RunModule
) -> None:
    fake.add()

    def lose_and_deny() -> None:
        fake.auth_ok = False
        lost_response()

    fake.after_write["reconfigure"] = lose_and_deny
    result = run_module(fixture_apply.main, verify=["example"])
    assert result["failed"] and result["changed"] and result["outcome"] == "unknown"
    assert result["operation"] == "verify" and result["error_category"] == "auth"


def test_accepted_but_not_effective_fails(
    fake: FakeProduct, run_module: RunModule, monkeypatch: pytest.MonkeyPatch
) -> None:
    fake.add()
    fake.activate_ok = False
    monkeypatch.setattr(_activation, "SETTLE_SECONDS", 0.0)
    result = run_module(fixture_apply.main, verify=["example"])
    assert result["failed"] and result["error_code"] == "not_effective"
    assert result["changed"] and result["outcome"] == "changed"


def test_unreportable_not_effective_keeps_changed_and_outcome(
    fake: FakeProduct, run_module: RunModule, monkeypatch: pytest.MonkeyPatch
) -> None:
    names = [f"n{index}" for index in range(257)]
    for name in names:
        fake.add(name=name)
    fake.activate_ok = False
    monkeypatch.setattr(_activation, "SETTLE_SECONDS", 0.0)
    result = run_module(fixture_apply.main, verify=names)
    assert result["failed"] and result["changed"] and result["outcome"] == "changed"
    assert (result["error_category"], result["error_code"]) == ("product", None)
    assert "not_effective" not in result and result["operation"] == "verify"


def test_lost_always_response_on_in_sync_state_is_unknown(
    fake: FakeProduct, run_module: RunModule
) -> None:
    fake.add(value="saved")
    assert run_module(fixture_apply.main, verify=["example"])["changed"]
    fake.after_write["reconfigure"] = lost_response
    result = run_module(fixture_apply.main, verify=["example"], activate="always")
    assert result["failed"] and result["changed"] and result["outcome"] == "unknown"


def test_no_verification_is_invalid_for_auto(
    fake: FakeProduct, run_module: RunModule
) -> None:
    result = run_module(fixture_apply.main, verify=[])
    assert result["failed"] and not result["changed"] and not fake.writes()


def test_always_without_verification_is_unverifiable(
    fake: FakeProduct, run_module: RunModule
) -> None:
    fake.add()
    result = run_module(fixture_apply.main, verify=[], activate="always")
    assert result["changed"] and result["activated"]
    assert result["verified"] == "unverifiable" and result["verification"] == {}
    assert len(fake.writes()) == 1


def test_secret_failure_is_sanitized(fake: FakeProduct, run_module: RunModule) -> None:
    fake.auth_ok = False
    result = run_module(fixture_apply.main, verify=["example"])
    assert result["failed"] and not result["changed"]
    result.pop("_ansible_new_secrets", None)
    assert SECRET not in json.dumps(result)
