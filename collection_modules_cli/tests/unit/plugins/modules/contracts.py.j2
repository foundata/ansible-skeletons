"""Typed CLI subject declarations and collection-time inventory validation."""

from __future__ import annotations

import inspect
import re
from collections.abc import Callable, Sequence
from dataclasses import dataclass, field
from pathlib import Path
from typing import Any, Literal, Protocol

Entry = Callable[[], None]


@dataclass(frozen=True)
class WriteCommand:
    """Contiguous native command tokens, excluding values and shell syntax."""

    alternatives: tuple[tuple[str, ...], ...] = (("update", "--"),)

    def __post_init__(self) -> None:
        if not isinstance(self.alternatives, tuple) or not self.alternatives:
            raise ValueError("Write command requires token sequences")
        for tokens in self.alternatives:
            if (
                not isinstance(tokens, tuple)
                or not tokens
                or any(not isinstance(token, str) or not token for token in tokens)
            ):
                raise ValueError("Write command requires nonempty tokens")

    def matches(self, argv: Sequence[str]) -> bool:
        return any(
            tuple(argv[index : index + len(tokens)]) == tokens
            for tokens in self.alternatives
            for index in range(len(argv) - len(tokens) + 1)
        )


@dataclass(frozen=True)
class LiteralInputs:
    """Accepted native argv and unsupported values refused before dispatch."""

    accepted: dict[str, str] = field(
        default_factory=lambda: {"label": "$HOME; ~ ${HOME}"}
    )
    argv: tuple[str, ...] = ("$HOME; ~ ${HOME}",)
    refused: tuple[dict[str, Any], ...] = field(
        default_factory=lambda: ({"label": "x" * 97},)
    )

    def __post_init__(self) -> None:
        if not isinstance(self.accepted, dict) or not self.accepted:
            raise ValueError("Literal input requires accepted arguments")
        if (
            not isinstance(self.argv, tuple)
            or not self.argv
            or any(not isinstance(value, str) for value in self.argv)
        ):
            raise ValueError("Literal input requires exact argv elements")
        if (
            not isinstance(self.refused, tuple)
            or not self.refused
            or any(
                not isinstance(options, dict) or not options for options in self.refused
            )
        ):
            raise ValueError("Literal input requires refused arguments")


@dataclass(frozen=True)
class NativeFault:
    """One native response and the permitted result of repeating its request."""

    result: Literal["reconcile", "retain_effect", "proven_refusal", "uncertain"] = (
        "reconcile"
    )
    error_code: str | None = None
    pending_code: str | None = None

    def __post_init__(self) -> None:
        if self.result not in {
            "reconcile",
            "retain_effect",
            "proven_refusal",
            "uncertain",
        }:
            raise ValueError("Invalid native fault result")
        if (self.result == "reconcile") != (self.error_code is None):
            raise ValueError("Invalid native fault error declaration")
        if self.result == "reconcile" and self.pending_code is not None:
            raise ValueError("Invalid native fault pending declaration")
        for code in (self.error_code, self.pending_code):
            if code is not None and (
                not isinstance(code, str)
                or re.fullmatch(r"[a-z][a-z0-9_]*", code) is None
                or code == "deadline_exceeded"
            ):
                raise ValueError("Invalid native fault error code")


@dataclass(frozen=True)
class FaultInterpretation:
    exit_after_effect: NativeFault = NativeFault()
    exit124: NativeFault = NativeFault()
    reject: NativeFault = NativeFault("proven_refusal", "refused")

    def __post_init__(self) -> None:
        for name, allowed in (
            ("exit_after_effect", {"reconcile", "retain_effect"}),
            ("exit124", {"reconcile", "retain_effect"}),
            ("reject", {"proven_refusal", "uncertain"}),
        ):
            fault = getattr(self, name)
            if not isinstance(fault, NativeFault) or fault.result not in allowed:
                raise ValueError("Invalid native fault interpretation")
            fault.__post_init__()

    def for_mode(self, mode: str) -> NativeFault:
        faults = {
            "exit_after_effect": self.exit_after_effect,
            "exit124": self.exit124,
            "reject": self.reject,
        }
        if mode not in faults:
            raise ValueError("Unknown native fault")
        return faults[mode]


@dataclass(frozen=True)
class Contract:
    """Product semantics; defaults describe the executable fixture."""

    faults: FaultInterpretation = FaultInterpretation()
    environment_policy: Literal["refuse", "neutralize"] = "refuse"
    literals: LiteralInputs = field(default_factory=LiteralInputs)
    write_command: WriteCommand = WriteCommand()
    granularity: Literal["fieldwise", "atomic"] = "fieldwise"

    def __post_init__(self) -> None:
        if not isinstance(self.faults, FaultInterpretation):
            raise ValueError("Invalid native fault declaration")
        self.faults.__post_init__()
        if self.environment_policy not in {"refuse", "neutralize"}:
            raise ValueError("Invalid effective environment policy")
        if not isinstance(self.literals, LiteralInputs):
            raise ValueError("Invalid literal declaration")
        self.literals.__post_init__()
        if not isinstance(self.write_command, WriteCommand):
            raise ValueError("Invalid write command declaration")
        self.write_command.__post_init__()
        if self.granularity not in {"fieldwise", "atomic"}:
            raise ValueError("Invalid mutation granularity")


class Adapter(Protocol):
    """Product-owned observations and declarations for the existing-only cases."""

    contract: Contract
    arguments: dict[str, Any]
    change: dict[str, Any]
    original: dict[str, Any]
    missing: dict[str, Any]
    wrong_identity: dict[str, Any]
    unsupported: tuple[dict[str, Any], ...]
    private: tuple[str, ...]
    result_key: str
    version: str
    literal: dict[str, str]
    identity_command: str

    def inject_host_identity(self) -> None: ...
    def identity(self, row: dict[str, Any]) -> object: ...
    def rows(self) -> dict[str, dict[str, Any]]: ...
    def selected(self) -> dict[str, Any]: ...
    def control(self, **values: Any) -> None: ...
    def records(self, name: str) -> list[dict[str, Any]]: ...


class AdapterFactory(Protocol):
    contract: Contract

    def __call__(self, fake: Any) -> Adapter: ...


@dataclass(frozen=True)
class Subject:
    name: str
    mode: Literal["existing_only", "observational"]
    info: Entry
    adapter: AdapterFactory
    writer: Entry | None = None
    observe_args: dict[str, Any] | None = None

    def __post_init__(self) -> None:
        if not isinstance(getattr(self.adapter, "contract", None), Contract):
            raise ValueError("Adapter requires a typed contract declaration")
        self.adapter.contract.__post_init__()
        if self.mode == "existing_only" and not callable(
            getattr(self.adapter, "inject_host_identity", None)
        ):
            raise ValueError("Adapter requires prepared host identity injection")
        if self.mode not in {"existing_only", "observational"}:
            raise ValueError("Unsupported contract mode")
        if not self.name or not callable(self.info) or not callable(self.adapter):
            raise ValueError("Incomplete subject declaration")
        if self.mode == "existing_only" and not callable(self.writer):
            raise ValueError("Existing-only subjects require a writer")
        if self.mode == "observational" and self.writer is not None:
            raise ValueError("Observational subjects forbid a writer")


def validate(subjects: tuple[Subject, ...], modules: Path) -> None:
    """Require every public module to have its real entry point registered."""
    if not subjects or len({s.name for s in subjects}) != len(subjects):
        raise ValueError("Empty or duplicate subject declarations")
    entries = {entry for s in subjects for entry in (s.info, s.writer) if entry}
    registered = set()
    for entry in entries:
        source = inspect.getsourcefile(entry)
        if source is None or entry.__name__ != "main":
            raise ValueError("Register actual public entry points")
        path = Path(source).resolve()
        if path.parent != modules.resolve():
            raise ValueError("Entry point is outside the public module inventory")
        registered.add(path.name)
    inventory = {p.name for p in modules.glob("*.py") if not p.name.startswith("_")}
    if registered != inventory:
        raise ValueError("Incomplete public module inventory")
