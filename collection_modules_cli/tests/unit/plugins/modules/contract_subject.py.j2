ORIGINAL = {"enabled": True, "limit": 10, "label": "initial"}
IDENTIFIERS = {"app": "alpha", "key": "quota", "id": IDENTITY}


def flat_expectations(
    state: dict[str, Any],
    fields: tuple[str, ...],
    partial: dict[str, Any] | None = None,
) -> Expectations:
    return Expectations(
        managed=state,
        projection={**IDENTIFIERS, **state},
        changed_fields=fields,
        diff={
            "before": {name: ORIGINAL[name] for name in fields},
            "after": {name: state[name] for name in fields},
        },
        partial=partial,
    )


def source_expectations(state: dict[str, Any], fields: tuple[str, ...]) -> Expectations:
    origins = {
        name: {"kind": "local" if name in fields else "default"} for name in state
    }
    properties = {
        name: {"value": value, "source": origins[name]} for name, value in state.items()
    }
    return Expectations(
        managed={**state, "origins": origins},
        projection={**IDENTIFIERS, "settings": properties},
        changed_fields=fields,
        diff={
            "before": {
                name: {"value": ORIGINAL[name], "source": {"kind": "default"}}
                for name in fields
            },
            "after": {name: properties[name] for name in fields},
        },
    )


class FixtureAdapter:
    contract = Contract()
    expected: ClassVar[Expectations | None] = flat_expectations(
        {"enabled": False, "limit": 0, "label": ""},
        ("enabled", "label", "limit"),
        partial={"enabled": True, "limit": 0, "label": "initial"},
    )
    literal_expected: ClassVar[Expectations | None] = flat_expectations(
        {**ORIGINAL, "label": "$HOME; ~ ${HOME}"},
        ("label",),
    )
    result_key = "fixture"
    version = "1.0.0"
    identity_command = "uid"
    private: tuple[str, ...] = (SECRET, FOREIGN)

    def __init__(self, fake: Lab) -> None:
        self.fake = fake
        self.literal = dict(self.contract.literals.accepted)
        self.arguments: dict[str, Any] = {
            "app": "alpha",
            "key": "quota",
            "expected_id": IDENTITY,
        }
        self.change: dict[str, Any] = {"enabled": False, "limit": 0, "label": ""}
        self.missing: dict[str, Any] = {"key": "missing"}
        self.wrong_identity: dict[str, Any] = {
            "expected_id": "8a7bf6f9-4965-4718-8dd4-a4fcbbeb845a"
        }
        self.unsupported: tuple[dict[str, Any], ...] = (
            {"state": "absent"},
            {"state": "present"},
            {"unmanaged": "overwrite"},
        )

    def inject_host_identity(self) -> None:
        prepare = _client.Client.prepare

        def mismatch(
            client: _client.Client, locator: Mapping[str, Any], command: Sequence[str]
        ) -> execution.Execution:
            prepared = prepare(client, locator, command)
            return replace(prepared, host_uid=os.geteuid() + 1)

        self.fake.monkeypatch.setattr(_client.Client, "prepare", mismatch)

    def identity(self, row: dict[str, Any]) -> tuple[str, str, str]:
        return row["app"], row["key"], row["id"]

    def rows(self) -> dict[str, dict[str, Any]]:
        return self.fake.read()["objects"]

    def selected(self) -> dict[str, Any]:
        return self.rows()[self.fake.selector]

    def control(self, **values: Any) -> None:
        self.fake.control(**values)

    def records(self, name: str) -> list[dict[str, Any]]:
        return self.fake.records(name)


class SetClient(_client.Client):
    write_command = "set"

    def __init__(self, params: dict[str, Any]) -> None:
        super().__init__(params)
        self.profile = replace(
            self.profile,
            qualification={
                **self.profile.qualification,
                "environment": "Neutralize inherited and module updates; env -i and Python -I -B",
            },
        )

    def prepare(
        self, locator: Mapping[str, Any], command: Sequence[str]
    ) -> execution.Execution:
        prepared = super().prepare(locator, command)
        # Per-call updates override inherited and module-level values before start.
        closed = dict.fromkeys(os.environ, "")
        closed.update(dict.fromkeys(self.module.run_command_environ_update or {}, ""))
        closed.update(PATH="/usr/bin:/bin", LC_ALL="C")
        return replace(prepared, environment=closed)

    @property
    def pending(self) -> Path:
        return Path(self.params["exec"]["chdir"]) / "pending.json"

    def validate_exit(self, rc: int, *, write: bool) -> None:
        if write and rc:
            self.pending.write_text('{"state": "unsettled"}')
            raise _client.ProductError(category="product", code="validation_failed")
        super().validate_exit(rc, write=write)

    def read(self) -> dict[str, Any] | None:
        if self.pending.exists() and not self.write_started:
            raise _client.ProductError(category="coordination", code="unsettled_write")
        return super().read()


class VocabularyFixture(_fixture.Fixture):
    """An alternate native vocabulary over the same executable backend."""

    def declared(self) -> dict[str, Any]:
        values = super().declared()
        if "label" in values and values["label"] not in {"initial", "accepted"}:
            raise _client.ProductError(category="argument", code="invalid_value")
        return values

    def refusal_may_change(self, failure: Any) -> bool:
        return bool(
            failure.category == "product" and failure.code == "validation_failed"
        )


class SourceFixture(VocabularyFixture):
    """Nested declarations with observed native origins in projection and diff."""

    def declared(self) -> dict[str, Any]:
        values = {
            name: value
            for name, value in (self.params.get("settings") or {}).items()
            if value is not None
        }
        if "limit" in values and not 0 <= values["limit"] <= 100:
            raise _client.ProductError(category="argument", code="invalid_value")
        return {"settings": values} if values else {}

    def managed(self, record: Any) -> dict[str, Any]:
        return {
            "app": record["app"],
            "key": record["key"],
            "id": record["id"],
            "settings": {
                name: {"value": record[name], "source": record["origins"][name]}
                for name in _client.FIELDS
            },
        }

    def same(self, name: str, current: Any, desired: Any) -> bool:
        return all(
            current.get(key) == {"value": value, "source": {"kind": "local"}}
            for key, value in desired.items()
        )

    def predict(self) -> dict[str, Any]:
        current = self.current or {}
        settings = dict(current.get("settings", {}))
        for name, value in self.delta.get("settings", {}).items():
            settings[name] = {"value": value, "source": {"kind": "local"}}
        return {**current, "settings": settings}

    def diff(self) -> dict[str, Any]:
        fields = self.changed_fields()
        return {
            "before": {name: self.current["settings"][name] for name in fields},
            "after": {name: self.predict()["settings"][name] for name in fields},
        }

    def changed_fields(self) -> list[str]:
        return sorted(self.delta.get("settings", {}))

    def write(self) -> None:
        self.client.update(self.record["id"], self.delta["settings"])


class SourceInfo(SourceFixture, _fixture.FixtureInfo):
    pass


def source_arguments(*, info: bool = False) -> dict[str, Any]:
    spec = _fixture.argument_spec(info=info)
    if not info:
        options = {name: spec.pop(name) for name in _client.FIELDS}
        options["label"]["choices"] = ["initial", "accepted"]
        spec["settings"] = {"type": "dict", "options": options}
    return spec


class AtomicFixtureAdapter(FixtureAdapter):
    """Exercise one indivisible field through the same executable."""

    expected: ClassVar[Expectations | None] = source_expectations(
        {**ORIGINAL, "limit": 0}, ("limit",)
    )
    literal_expected: ClassVar[Expectations | None] = source_expectations(
        {**ORIGINAL, "label": "accepted"}, ("label",)
    )
    contract = Contract(
        granularity="atomic",
        environment_policy="neutralize",
        faults=FaultInterpretation(
            exit_after_effect=NativeFault(
                "retain_effect", "validation_failed", "unsettled_write"
            ),
            exit124=NativeFault(
                "retain_effect", "validation_failed", "unsettled_write"
            ),
            reject=NativeFault("uncertain", "validation_failed", "unsettled_write"),
        ),
        write_command=WriteCommand((("set", "--"),)),
        literals=LiteralInputs(
            accepted={"settings": {"label": "accepted"}},
            argv=("accepted",),
            refused=({"settings": {"label": "$HOME; ~ ${HOME}"}},),
        ),
    )

    def __init__(self, fake: Lab) -> None:
        super().__init__(fake)
        fake.profile_controls = {"generic_reject": True}
        fake.control()
        fake.monkeypatch.setattr(_fixture, "Client", SetClient)
        fake.monkeypatch.setattr(fixture, "Fixture", SourceFixture)
        fake.monkeypatch.setattr(fixture, "argument_spec", source_arguments)
        fake.monkeypatch.setattr(fixture_info, "FixtureInfo", SourceInfo)
        fake.monkeypatch.setattr(fixture_info, "argument_spec", source_arguments)
        state = fake.read()
        for row in state["objects"].values():
            row["origins"] = {name: {"kind": "default"} for name in _client.FIELDS}
        (fake.directory / "state.json").write_text(json.dumps(state))
        self.change = {"settings": {"limit": 0}}


