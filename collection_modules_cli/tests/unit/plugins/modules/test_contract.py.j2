def public(result: dict[str, Any], adapter: Adapter) -> dict[str, Any]:
    result = dict(result)
    announced = result.pop("_ansible_new_secrets", [])
    assert set(announced) <= set(adapter.private)
    assert all(
        json.dumps(secret)[1:-1] not in json.dumps(result) for secret in adapter.private
    )
    return result


def expectations(adapter: Adapter, *, literal: bool = False) -> Expectations:
    declaration = adapter.literal_expected if literal else adapter.expected
    assert declaration is not None
    return declaration


def test_every_writer_changes_repeats_predicts_and_preserves(
    writer: Subject, fake: Any, run_module: RunModule
) -> None:
    subject = writer
    adapter = subject.adapter(fake)
    before = adapter.rows()
    selected = adapter.selected()
    want = expectations(adapter)
    prediction = public(
        run_module(
            subject.writer,
            **adapter.arguments,
            **adapter.change,
            _ansible_check_mode=True,
            _ansible_diff=True,
        ),
        adapter,
    )
    assert prediction["changed"] and prediction["verified"] == "predicted"
    assert prediction[adapter.result_key] == want.projection
    assert prediction["changed_fields"] == list(want.changed_fields)
    assert prediction["diff"] == want.diff
    assert adapter.rows() == before and not adapter.records("writes.jsonl")
    result = public(
        run_module(
            subject.writer,
            **adapter.arguments,
            **adapter.change,
            _ansible_diff=True,
        ),
        adapter,
    )
    assert result["changed"] and result["verified"] == "observed"
    assert result["changed_fields"] == list(want.changed_fields)
    assert result["diff"] == want.diff
    assert result[adapter.result_key] == want.projection
    assert adapter.identity(result[adapter.result_key]) == adapter.identity(selected)
    assert adapter.selected() == {**selected, **want.managed}
    for key, row in before.items():
        expected = (
            {**row, **want.managed}
            if adapter.identity(row) == adapter.identity(selected)
            else row
        )
        assert adapter.rows()[key] == expected
    repeated = public(
        run_module(subject.writer, **adapter.arguments, **adapter.change), adapter
    )
    assert not repeated["changed"] and repeated["verified"] == "observed"
    assert repeated[adapter.result_key] == want.projection
    assert len(adapter.records("writes.jsonl")) == 1


