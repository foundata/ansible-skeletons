def test_inventory_rejects_an_unregistered_first_writer(tmp_path: Path) -> None:
    # Start with a valid observational inventory, then add its first writer.
    original = SUBJECTS[0].info
    source = Path(inspect.getfile(original)).read_bytes()
    registered = tmp_path / "registered_info.py"
    registered.write_bytes(source)
    info = FunctionType(
        original.__code__.replace(co_filename=str(registered)),
        original.__globals__,
        "main",
    )
    subjects = (replace(SUBJECTS[0], mode="observational", info=info, writer=None),)
    validate(subjects, tmp_path)
    (tmp_path / "unregistered_writer.py").write_bytes(source)
    with pytest.raises(ValueError, match="inventory"):
        validate(subjects, tmp_path)
    with pytest.raises(ValueError, match="Unsupported"):
        invalid: Any = "unknown"
        replace(SUBJECTS[0], mode=invalid)
    with pytest.raises(ValueError, match="Empty or duplicate"):
        validate((), tmp_path)


