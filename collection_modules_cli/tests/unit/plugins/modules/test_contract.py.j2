def test_literal_values_and_target_environment(
    writer: Subject, fake: Any, run_module: RunModule, monkeypatch: pytest.MonkeyPatch
) -> None:
    subject = writer
    adapter = subject.adapter(fake)
    before = adapter.selected()
    want = expectations(adapter, literal=True)
    monkeypatch.setenv("CONTRACT_AMBIENT_SECRET", adapter.private[0])
    result = public(
        run_module(
            subject.writer, **adapter.arguments, **adapter.literal, _ansible_diff=True
        ),
        adapter,
    )
    assert not result.get("failed") and result["changed"]
    assert len(adapter.records("writes.jsonl")) == 1
    assert result[adapter.result_key] == want.projection
    assert result["diff"] == want.diff
    assert result["changed_fields"] == list(want.changed_fields)
    assert adapter.selected() == {**before, **want.managed}
    calls = adapter.records("calls.jsonl")
    assert all(
        json.dumps(secret)[1:-1] not in json.dumps(calls) for secret in adapter.private
    )
    assert all(
        call["environment"].get("CONTRACT_AMBIENT_SECRET") in {None, ""}
        for call in calls
    )
    assert all(call["environment"]["LC_ALL"] == "C" for call in calls)
    assert any(call["argv"][-1] == adapter.identity_command for call in calls)
    writes = [
        call for call in calls if adapter.contract.write_command.matches(call["argv"])
    ]
    assert len(writes) == 1
    assert all(value in writes[0]["argv"] for value in adapter.contract.literals.argv)


@pytest.mark.parametrize(
    "name", ["LD_PRELOAD", "LD_LIBRARY_PATH", "LD_AUDIT", "PYTHONHOME"]
)
def test_loader_policy_precedes_child_start(
    writer: Subject,
    fake: Any,
    run_module: RunModule,
    monkeypatch: pytest.MonkeyPatch,
    name: str,
) -> None:
    adapter = writer.adapter(fake)
    before = adapter.rows()
    monkeypatch.setenv(name, "unqualified-loader-value")
    monkeypatch.setenv("CONTRACT_AMBIENT_SECRET", adapter.private[0])
    original = subprocess.Popen
    environments: list[dict[str, str]] = []

    def start(args: Any, **kwargs: Any) -> Any:
        environments.append(dict(kwargs["env"]))
        return original(args, **kwargs)

    monkeypatch.setattr(subprocess, "Popen", start)
    result = public(
        run_module(writer.writer, **adapter.arguments, **adapter.change), adapter
    )
    if adapter.contract.environment_policy == "refuse":
        assert result["failed"] and result["error_code"] == "invalid_environment"
        assert not result["changed"] and result["outcome"] == "unchanged"
        assert adapter.rows() == before and not environments
        assert not adapter.records("calls.jsonl")
    else:
        assert not result.get("failed") and result["changed"]
        assert environments and len(adapter.records("writes.jsonl")) == 1
        for environment in environments:
            assert environment.get(name) in {None, ""}
            assert all(
                json.dumps(secret)[1:-1] not in json.dumps(environment)
                for secret in adapter.private
            )
        calls = adapter.records("calls.jsonl")
        assert calls and all(call["environment"]["LC_ALL"] == "C" for call in calls)
        assert all(
            json.dumps(secret)[1:-1] not in json.dumps(calls)
            for secret in adapter.private
        )


