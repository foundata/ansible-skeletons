def test_stdin_literal_values_and_target_environment(
    writer: Subject, fake: Any, run_module: RunModule, monkeypatch: pytest.MonkeyPatch
) -> None:
    subject = writer
    adapter = subject.adapter(fake)
    monkeypatch.setenv("CONTRACT_AMBIENT_SECRET", adapter.private[0])
    result = public(
        run_module(subject.writer, **adapter.arguments, **adapter.literal),
        adapter,
    )
    for name, value in adapter.literal.items():
        assert result[adapter.result_key][name] == value
    calls = adapter.records("calls.jsonl")
    assert all(secret not in json.dumps(calls) for secret in adapter.private)
    assert all("CONTRACT_AMBIENT_SECRET" not in call["environment"] for call in calls)
    assert all(call["environment"]["LC_ALL"] == "C" for call in calls)
    assert any(call["argv"][-1] == adapter.identity_command for call in calls)
    assert all("$HOME" not in json.dumps(call["argv"]) for call in calls)


