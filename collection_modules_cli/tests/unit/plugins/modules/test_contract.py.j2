def test_failure_before_start_preserves_unchanged(
    writer: Subject, fake: Any, run_module: RunModule, monkeypatch: pytest.MonkeyPatch
) -> None:
    subject = writer
    adapter = subject.adapter(fake)
    original = subprocess.Popen
    refused: list[list[str]] = []

    def refuse(args: list[str | bytes], **kwargs: Any) -> Any:
        argv = [os.fsdecode(arg) for arg in args]
        if adapter.contract.write_command.matches(argv):
            refused.append(argv)
            raise FileNotFoundError("private diagnostic")
        return original(args, **kwargs)

    monkeypatch.setattr(subprocess, "Popen", refuse)
    before = adapter.rows()
    result = public(
        run_module(subject.writer, **adapter.arguments, **adapter.change), adapter
    )
    assert len(refused) == 1
    assert "private diagnostic" not in json.dumps(result)
    assert result["failed"] and result["error_code"] == "command_start"
    assert not result["changed"] and result["outcome"] == "unchanged"
    assert adapter.rows() == before and not adapter.records("writes.jsonl")


