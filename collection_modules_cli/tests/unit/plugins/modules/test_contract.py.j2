@pytest.mark.parametrize("mode", ["lost", "exit_after_effect", "exit124", "deep_ack"])
def test_uncertain_reply_is_reconciled_without_redispatch(
    writer: Subject, fake: Any, run_module: RunModule, mode: str
) -> None:
    subject = writer
    adapter = subject.adapter(fake)
    before = adapter.selected()
    adapter.control(update=mode)
    result = public(
        run_module(subject.writer, **adapter.arguments, **adapter.change), adapter
    )
    interpretation = (
        adapter.contract.faults.for_mode(mode)
        if mode in {"exit_after_effect", "exit124"}
        else None
    )
    if interpretation and interpretation.result == "retain_effect":
        assert result["failed"] and result["outcome"] == "changed"
        assert result["error_code"] == interpretation.error_code
        assert result["http_status"] is None
        assert result["error_code"] != "deadline_exceeded"
    else:
        assert not result.get("failed") and result["verified"] == "observed"
    assert result["changed"]
    assert adapter.selected() == {**before, **expectations(adapter).managed}
    assert len(adapter.records("writes.jsonl")) == 1
    after = adapter.rows()
    repeated = public(
        run_module(subject.writer, **adapter.arguments, **adapter.change), adapter
    )
    if interpretation and interpretation.pending_code is not None:
        assert repeated["failed"] and repeated["outcome"] == "unchanged"
        assert repeated["error_code"] == interpretation.pending_code
    else:
        assert not repeated.get("failed") and repeated["verified"] == "observed"
    assert not repeated["changed"] and adapter.rows() == after
    assert len(adapter.records("writes.jsonl")) == 1


@pytest.mark.parametrize(
    "mode,code,outcome",
    [
        ("readback_failed", "read_failed", "unknown"),
        ("drop", "not_persisted", "unknown"),
        ("partial", "not_persisted", "changed"),
        ("reject", "refused", "unchanged"),
    ],
)
def test_effect_evidence_controls_outcome(
    writer: Subject,
    fake: Any,
    run_module: RunModule,
    mode: str,
    code: str,
    outcome: str,
) -> None:
    subject = writer
    adapter = subject.adapter(fake)
    before = adapter.selected()
    if mode == "reject":
        interpretation = adapter.contract.faults.reject
        assert interpretation.error_code is not None
        code = interpretation.error_code
        outcome = (
            "unchanged" if interpretation.result == "proven_refusal" else "unknown"
        )
    if mode == "partial" and adapter.contract.granularity == "atomic":
        mode, code, outcome = "readback_failed", "read_failed", "unknown"
    adapter.control(update=mode)
    result = public(
        run_module(subject.writer, **adapter.arguments, **adapter.change), adapter
    )
    assert result["failed"] and result["error_code"] == code
    assert result["outcome"] == outcome and result["changed"] == (
        outcome != "unchanged"
    )
    assert result["http_status"] is None and len(adapter.records("writes.jsonl")) == 1
    stored = adapter.selected()
    if mode in {"drop", "reject"}:
        assert stored == before
        if mode == "reject" and adapter.contract.faults.reject.pending_code is not None:
            repeated = public(
                run_module(subject.writer, **adapter.arguments, **adapter.change),
                adapter,
            )
            assert repeated["failed"] and not repeated["changed"]
            assert repeated["outcome"] == "unchanged"
            assert repeated["error_code"] == adapter.contract.faults.reject.pending_code
            assert len(adapter.records("writes.jsonl")) == 1
            assert adapter.selected() == before
    elif mode == "partial":
        want = expectations(adapter)
        assert want.partial is not None
        assert stored == {**before, **want.partial}
        assert stored != before and stored != {**before, **want.managed}
    else:
        assert stored == {**before, **expectations(adapter).managed}


@pytest.mark.parametrize("mode", ["timeout_before", "timeout_after"])
def test_expiry_keeps_uncertainty_and_terminates_child(
    writer: Subject, fake: Any, run_module: RunModule, mode: str
) -> None:
    subject = writer
    adapter = subject.adapter(fake)
    before = adapter.selected()
    adapter.control(update=mode)
    result = public(
        run_module(subject.writer, **adapter.arguments, **adapter.change, deadline=3.0),
        adapter,
    )
    assert result["failed"] and result["changed"] and result["outcome"] == "unknown"
    assert result["error_code"] == "deadline_exceeded"
    writes = adapter.records("writes.jsonl")
    assert len(writes) == 1 and not Path(f"/proc/{writes[0]['pid']}").exists()
    after = (
        before
        if mode == "timeout_before"
        else {**before, **expectations(adapter).managed}
    )
    assert adapter.selected() == after


