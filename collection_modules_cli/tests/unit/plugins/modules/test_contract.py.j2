def test_subject_declarations_require_real_modes_and_entries() -> None:
    subject = SUBJECTS[0]
    with pytest.raises(ValueError, match="require a writer"):
        replace(subject, mode="existing_only", writer=None)
    with pytest.raises(ValueError, match="forbid a writer"):
        replace(subject, mode="observational", writer=subject.info)
    with pytest.raises(ValueError, match="Incomplete"):
        replace(subject, name="")


