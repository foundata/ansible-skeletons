@pytest.mark.parametrize(
    "secret", ['quoted"value', "slash\\value", "line\nvalue", "nonascii-\u00e9"]
)
def test_public_rejects_json_escaped_private_values(secret: str) -> None:
    class Private:
        private = (secret,)

    adapter: Any = Private()
    with pytest.raises(AssertionError):
        public({"diff": {"before": {}, "after": {"value": secret}}}, adapter)
