---
- name: "Exercise fixture_info through the installed executable"
  module_defaults:
    group/{{ namespace }}.{{ collection_name }}.api: >-
      {{ '{{' }} fixture_cli_connection {{ '}}' }}
  block:
    - name: "Read the existing object"
      {{ namespace }}.{{ collection_name }}.fixture_info:
        app: "alpha"
        key: "quota"
        expected_id: "090d190b-c80a-4917-8532-6b62a2836d0c"
      register: __observed

    - name: "Verify the observation"
      ansible.builtin.assert:
        that:
          - not __observed['changed']
          - __observed['fixture']['id'] == '090d190b-c80a-4917-8532-6b62a2836d0c'
          - __observed['verified'] == 'observed'

  always:
    - name: "Remove owned fixture state"
      ansible.builtin.file:
        path: "{% raw %}{{ __fixture_cli_state['path'] }}{% endraw %}"
        state: "absent"
