"""Internal fixture product API client; not a public interface.

Authentication, JSON encoding, the application status of a response,
pagination and the version probe live here, on top of the bounded byte
transport of ``foundata.utils``. Nothing a product returns reaches an
exception message: failures carry local categories and codes only.
"""
# FIXME Replace fixture authentication, routes and responses with the product contract.

from __future__ import annotations

import base64
import json
import re
from typing import Any

from ansible_collections.foundata.utils.plugins.module_utils import (
    deadline as deadline_util,
)
from ansible_collections.foundata.utils.plugins.module_utils import (
    http_client as http_util,
)
from ansible_collections.foundata.utils.plugins.module_utils.deadline import Deadline
from ansible_collections.foundata.utils.plugins.module_utils.errors import (
    ApiError,
    ErrorSchema,
    merge_error_codes,
)
from ansible_collections.foundata.utils.plugins.module_utils.http_client import (
    HttpClient,
    decode_json,
)

USER_AGENT = "{{ namespace }}.{{ collection_name }}/{{ version | default('1.0.0') }}"
PAGE_SIZE = 500
MAX_PAGES = 200
UUID = re.compile(r"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$")
VERSION = re.compile(r"^(\d+)\.(\d+)\.(\d+)$")
_SEGMENT = re.compile(r"^[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}$")

ERROR_CODES: dict[str, frozenset[str | None]] = {
    "internal": frozenset({None}),
    "argument": frozenset({"invalid_field", "invalid_identity"}),
    "eligibility": frozenset({"referenced", "internal_object"}),
    "auth": frozenset({"unauthenticated", "forbidden"}),
    "product": frozenset(
        {
            None,
            "endpoint_not_found",
            "rejected",
            "unexpected_status",
            "validation_failed",
            "not_found",
            "activation_failed",
        }
    ),
    # The decoding codes invalid_utf8 and invalid_json come from foundata.utils.
    "response": frozenset({"response_type", "schema"}),
    "identity": frozenset({"ambiguous", "incomplete_listing", "internal_object"}),
    "reference": frozenset({"not_found", "ambiguous"}),
    "verification": frozenset(
        {
            "missing_after_write",
            "not_persisted",
            "still_present",
            "create_unknown",
            "not_effective",
        }
    ),
    "compatibility": frozenset({"version_unknown", "ineligible"}),
}
"""Categories and codes this collection raises besides the shared ones."""


def _bounded_text(value: object) -> str:
    if not isinstance(value, str) or not 0 < len(value) <= 128:
        raise ValueError("expected a short string")
    return value


# FIXME Keep NAME_LIMIT and MAX_NAMES at least as wide as the definitions' key
# patterns, field names and verify lists; a payload beyond them degrades to a
# generic product error.
NAME_LIMIT = 253
"""Longest field, object or identity name a failure result repeats."""
MAX_NAMES = 256
"""Most names one failure result repeats."""


def _name(value: object) -> str:
    if (
        not isinstance(value, str)
        or not 0 < len(value) <= NAME_LIMIT
        or any(ord(char) < 32 or ord(char) == 127 for char in value)
    ):
        raise ValueError("expected a name")
    return value


def _names(value: object) -> list[str]:
    if not isinstance(value, list) or len(value) > MAX_NAMES:
        raise ValueError("expected a bounded list")
    return [_name(item) for item in value]


SCHEMA = ErrorSchema(
    codes_by_category=merge_error_codes(
        http_util.ERROR_CODES, deadline_util.ERROR_CODES, ERROR_CODES
    ),
    fallback=("internal", None),
    field_validators={
        "operation": _bounded_text,
        "name": _name,
        "fields": _names,
        "series": _bounded_text,
        "not_effective": _names,
    },
)
"""The public error schema of this collection's modules."""


class ProductError(ApiError):
    """A failure reported or detected by the fixture product client.

    ``fields`` names product fields involved, for example those a validation
    rejected. The names come from the resource definition, never from text.
    """

    def __init__(
        self,
        message: str = "fixture product operation failed",
        *,
        category: str = "product",
        code: str | None = None,
        status: int | None = None,
        fields: list[str] | None = None,
    ) -> None:
        super().__init__(message, category=category, code=code, status=status)
        self.fields = fields or []


def api_argument_spec() -> dict[str, Any]:
    """Return a fresh specification of the connection options."""
    spec = http_util.http_argument_spec()
    spec["api_key"] = {"type": "str", "required": True, "no_log": True}
    spec["api_secret"] = {"type": "str", "required": True, "no_log": True}
    return spec


def segment(value: str) -> str:
    """Validate a value used as one URL path segment, such as a UUID or name."""
    if not isinstance(value, str) or not _SEGMENT.match(value):
        raise ProductError(
            "Invalid path segment", category="request", code="invalid_path"
        )
    return value


class Client:
    """One authenticated fixture product API endpoint for one module invocation."""

    def __init__(self, params: dict[str, Any]) -> None:
        self._http = HttpClient(
            params["url"],
            user_agent=USER_AGENT,
            validate_certs=params["validate_certs"],
            ca_path=params["ca_path"],
            use_proxy=params["use_proxy"],
            timeout=params["timeout"],
        )
        self.deadline = Deadline(params["deadline"])
        token = f"{params['api_key']}:{params['api_secret']}".encode()
        self._authorization = "Basic " + base64.b64encode(token).decode("ascii")
        self.writes = 0
        self._version: tuple[str, str] | None = None
        self.compatibility_warned = False

    def read(self, method: str, path: str, body: dict[str, Any] | None = None) -> Any:
        """Call a read-only operation; the fixture product also reads through POST."""
        return self._request(method, path, body)

    def write(self, path: str, body: dict[str, Any] | None = None) -> Any:
        """Call a mutating operation; every attempt is counted in ``writes``."""
        self.writes += 1
        return self._request("POST", path, body if body is not None else {})

    def _request(self, method: str, path: str, body: dict[str, Any] | None) -> Any:
        """Send one request and return the decoded JSON document.

        Raises:
            ProductError: For authentication, HTTP and application failures
                and malformed responses.
            ApiError: For transport failures from ``foundata.utils``.
        """
        headers = {"Authorization": self._authorization, "Accept": "application/json"}
        data = None
        if body is not None:
            data = json.dumps(body).encode("utf-8")
            headers["Content-Type"] = "application/json"
        response = self._http.request(
            method, path, deadline=self.deadline, headers=headers, body=data
        )
        status = response.status
        if status == 401:
            raise ProductError(category="auth", code="unauthenticated", status=status)
        if status == 403:
            raise ProductError(category="auth", code="forbidden", status=status)
        if 300 <= status < 400:
            raise ProductError(category="auth", code="unauthenticated", status=status)
        if status == 404:
            raise ProductError(code="endpoint_not_found", status=status)
        if status >= 400:
            # A UserException: the product refused the request, for example a
            # deletion of an object still referenced elsewhere.
            raise ProductError(
                code="validation_failed" if status == 422 else "rejected", status=status
            )
        if status != 200:
            raise ProductError(code="unexpected_status", status=status)
        payload = decode_json(response.body)
        if isinstance(payload, dict) and payload.get("status") == "failed":
            raise ProductError(code="rejected", status=status)
        return payload

    def search(self, route: str, action: str = "search_item") -> list[dict[str, Any]]:
        """Return every row of a grid listing, reading all pages.

        A listing whose rows do not add up to its declared total is an
        error, never a short result.
        """
        rows: list[dict[str, Any]] = []
        seen: set[str] = set()
        total = None
        for page in range(1, MAX_PAGES + 1):
            payload = self.read(
                "POST",
                f"{route}/{action}",
                {"current": page, "rowCount": PAGE_SIZE, "searchPhrase": ""},
            )
            if not isinstance(payload, dict):
                raise ProductError(category="response", code="response_type")
            page_rows = payload.get("rows")
            declared = payload.get("total")
            if (
                not isinstance(page_rows, list)
                or not isinstance(declared, int)
                or isinstance(declared, bool)
                or declared < 0
                or payload.get("current") != page
            ):
                raise ProductError(category="response", code="schema")
            if total is None:
                total = declared
            elif declared != total:
                raise ProductError(category="identity", code="incomplete_listing")
            for row in page_rows:
                if not isinstance(row, dict) or not isinstance(row.get("uuid"), str):
                    raise ProductError(category="response", code="schema")
                if row["uuid"] in seen:
                    raise ProductError(category="identity", code="incomplete_listing")
                seen.add(row["uuid"])
                rows.append(row)
            if len(rows) >= total or not page_rows:
                break
        if total is None or len(rows) != total:
            raise ProductError(category="identity", code="incomplete_listing")
        return rows

    def version(self) -> tuple[str, str]:
        """Return the series and release from the read-only version endpoint."""
        if self._version is None:
            payload = self.read("GET", "/system/version")
            first = payload.get("version") if isinstance(payload, dict) else None
            match = VERSION.match(first) if isinstance(first, str) else None
            if match is None:
                raise ProductError(category="compatibility", code="version_unknown")
            major, minor, patch = match.groups()
            series = f"{major}.{minor}"
            self._version = (series, f"{series}.{patch}" if patch else series)
        return self._version

    def probe(self, route: str) -> None:
        self.read("GET", route)

    def lookup(self, resource: Any, ident: dict[str, str]) -> dict[str, Any] | None:
        raise ValueError("The fixture grid has no documented by-key absence response")

    def get(self, resource: Any, identity: str | int) -> dict[str, Any] | None:
        payload = self.read(
            "GET",
            f"{resource.route}/{resource.actions.get or 'get_item'}/{segment(str(identity))}",
        )
        record = payload.get(resource.post_key) if isinstance(payload, dict) else None
        if not isinstance(record, dict) or not record:
            raise ProductError(category="response", code="schema")
        return {**record, resource.identifier.name: identity}

    def submit(self, resource: Any, path: str, body: dict[str, Any]) -> Any:
        response = self.write(path, {resource.post_key: body})
        if not isinstance(response, dict):
            raise ProductError(category="response", code="response_type")
        if response.get("result") == "failed":
            validations = response.get("validations", {})
            known = {key.name for key in resource.keys} | {
                field.name for field in resource.fields
            }
            fields = (
                sorted(
                    {
                        str(key).rsplit(".", maxsplit=1)[-1]
                        if str(key).rsplit(".", maxsplit=1)[-1] in known
                        else "other"
                        for key in validations
                    }
                )
                if isinstance(validations, dict)
                else []
            )
            raise ProductError(code="validation_failed", fields=fields)
        if response.get("result") != "saved":
            raise ProductError(code="rejected")
        return response

    def create(self, resource: Any, body: dict[str, Any]) -> None:
        response = self.submit(
            resource, f"{resource.route}/{resource.actions.add}", body
        )
        if not isinstance(response.get("uuid"), str) or not UUID.fullmatch(
            response["uuid"]
        ):
            raise ProductError(category="response", code="schema")

    def update(self, resource: Any, identity: Any, body: dict[str, Any]) -> None:
        self.submit(
            resource,
            f"{resource.route}/{resource.actions.set}/{segment(str(identity))}",
            body,
        )

    def delete(self, resource: Any, identity: Any) -> None:
        response = self.write(
            f"{resource.route}/{resource.actions.delete}/{segment(str(identity))}"
        )
        if not isinstance(response, dict) or response.get("result") not in (
            "deleted",
            "not found",
        ):
            raise ProductError(code="rejected")

    @staticmethod
    def encode(field: Any, value: Any) -> Any:
        if field.kind == "bool":
            return "1" if value else "0"
        if field.kind in ("set", "names"):
            return (field.separator or ",").join(value)
        return str(value)

    @staticmethod
    def decode(field: Any, raw: Any) -> Any:
        if isinstance(raw, dict) and all(isinstance(v, dict) for v in raw.values()):
            selected = [
                str(k) for k, v in raw.items() if v.get("selected") in (1, "1", True)
            ]
            if any(
                v.get("selected") not in (0, "0", False, None, 1, "1", True)
                for v in raw.values()
            ):
                raise ProductError(
                    category="response", code="schema", fields=[field.name]
                )
            if field.kind in ("set", "names"):
                return selected
            if field.kind == "choice" and len(selected) <= 1:
                return selected[0] if selected else ""
        if field.kind in ("set", "names") and isinstance(raw, str):
            return [v for v in raw.split(field.separator or ",") if v]
        if field.kind == "bool" and raw in ("1", "0", ""):
            return raw == "1"
        if field.kind == "int" and isinstance(raw, str):
            try:
                return int(raw) if raw else None
            except ValueError:
                raise ProductError(
                    category="response", code="schema", fields=[field.name]
                ) from None
        reference = getattr(field, "reference", None)
        if (
            field.kind == "map"
            and isinstance(raw, dict)
            and reference is not None
            and reference.identifier.kind == "int"
        ):
            # JSON object keys are text; integer identifiers become numbers again.
            return {
                int(key) if isinstance(key, str) and key.isdecimal() else key: rights
                for key, rights in raw.items()
            }
        return raw

    def list(self, resource: Any) -> list[dict[str, Any]]:
        return self.search(resource.route, resource.actions.search or "search_item")
