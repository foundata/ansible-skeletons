def compare_fixture(client: Client, names: list[str]) -> dict[str, str]:
    """Compare only public fixture fields; absence is a verified complete listing."""
    # Preserve wrapping for maximum-length Galaxy identities.
    # fmt: off
    # isort: off
    from ansible_collections.{{ namespace }}.\
        {{ collection_name }}.plugins.module_utils._definitions import (
            FIXTURE,
        )
    from ansible_collections.{{ namespace }}.\
        {{ collection_name }}.plugins.module_utils._engine import (
            equal,
            normalize,
        )
    # isort: on
    # fmt: on

    saved = client.search(FIXTURE.route)
    active = client.search("/fixture/active")
    result = {}
    for name in names:
        matches = [
            [row for row in rows if row.get("name") == name] for rows in (saved, active)
        ]
        if any(len(rows) > 1 for rows in matches):
            raise ProductError(category="identity", code="ambiguous")
        before, after = (rows[0] if rows else None for rows in matches)
        if before is None or after is None:
            result[name] = "in_sync" if before is after else "drift"
        else:
            if any(
                field.name not in row
                for row in (before, after)
                for field in FIXTURE.fields
            ):
                raise ProductError(category="response", code="schema")
            result[name] = (
                "in_sync"
                if all(
                    equal(
                        field,
                        normalize(field, client.decode(field, before[field.name])),
                        normalize(field, client.decode(field, after[field.name])),
                    )
                    for field in FIXTURE.fields
                )
                else "drift"
            )
    return result


def apply_fixture(client: Client) -> None:
    """Activate the fixture area, including other writers' pending changes."""
    response = client.write("/fixture/reconfigure")
    if not isinstance(response, dict) or response.get("status") != "ok":
        raise ProductError(code="activation_failed")


def settle_fixture(client: Client, names: list[str]) -> dict[str, str]:
    return settle(client, names, compare_fixture)
