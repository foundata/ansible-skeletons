"""Act once when saved identities cannot prove the loaded state; internal.

Preflight checks the saved state before check-mode prediction. Compatibility
precedes preflight when the binding requires a probe before every product read.
Normal mode activates once and reports verified: unverifiable. A lost reply
leaves the outcome unknown. Effective may check bounded readiness without
claiming a loaded-state receipt. An area's apply module supplies the product
hooks and binding. The base's ``finish`` hook runs after ``act_once`` too: an
area class that also reconciles resources branches there on its own state.
"""

from __future__ import annotations

from typing import Any, Callable

# Preserve wrapping for maximum-length Galaxy identities.
# fmt: off
# isort: off
from ansible_collections.{{ namespace }}.\
    {{ collection_name }}.plugins.module_utils._lifecycle import (
        Lifecycle,
    )
# isort: on
# fmt: on


class ActOnce(Lifecycle, sequence=("act_once", "execute")):
    """Mixin for an appliance area with an unobservable activation receipt.

    List it first, ``class Apply(ActOnce, Binding)``. A mixin extends the class
    it is mixed into: its ``execute`` and ``act_once`` and its hook defaults
    must come before the binding and every resource class in the method
    resolution order. Listed after one of them, any member that class defines
    under the same name would replace the activation's without an error, so
    a class that lists another lifecycle class before ActOnce fails when it is
    created. Define the activation hooks on the area class itself.
    """

    def __init_subclass__(cls, **kwargs: Any) -> None:
        super().__init_subclass__(**kwargs)
        order = cls.__mro__
        early = [
            base.__name__
            for base in order[1 : order.index(ActOnce)]
            if issubclass(base, Lifecycle) and not issubclass(base, ActOnce)
        ]
        if early:
            raise TypeError(
                f"{cls.__qualname__} lists {', '.join(early)} before ActOnce; "
                f"declare class {cls.__name__}(ActOnce, {early[0]})"
            )

    def preflight(self) -> None:
        """Check the saved state the activation would load."""

    def activate(self) -> None:
        raise NotImplementedError

    def effective(self) -> dict[str, Any]:
        """Optional bounded readiness check; returns extra result keys."""
        return {}

    def activation_id(self) -> str:
        return self.compatibility_id + "_apply"

    def act_once(self) -> dict[str, Any]:
        self.prepare(self.activation_id())
        self.step("protect")
        self.preflight()
        self.step("compatibility")
        self.ensure_compatible(self.activation_id())
        result: dict[str, Any] = {
            "changed": True,
            "activated": True,
            "verified": "predicted" if self.module.check_mode else "unverifiable",
        }
        if self.module.check_mode:
            return result
        self.step("apply")
        self.attempted = True
        self.activate()
        self.step("verify")
        result.update(self.effective())
        self.confirmed = True
        return result

    def execute(
        self,
        action: Callable[[], dict[str, Any]] | None = None,
        *,
        activation: bool = False,
        compatibility_operation: str | None = None,
        validate: Callable[[], None] | None = None,
    ) -> None:
        """Select act-once when requested, then use the base's result boundary."""
        if action is None and activation:
            action = self.act_once
        if action == self.act_once:
            compatibility_operation = self.activation_id()
        super().execute(
            action, compatibility_operation=compatibility_operation, validate=validate
        )
