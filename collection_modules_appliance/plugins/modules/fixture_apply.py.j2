from ansible.module_utils.basic import AnsibleModule

# Preserve wrapping for maximum-length Galaxy identities.
# fmt: off
# isort: off
from ansible_collections.{{ namespace }}.\
    {{ collection_name }}.plugins.module_utils import (
        _activation,
        _fixture_activation,
    )
from ansible_collections.{{ namespace }}.\
    {{ collection_name }}.plugins.module_utils._definitions import (
        FIXTURE,
    )
# isort: on
# fmt: on


def main() -> None:
    module = AnsibleModule(
        argument_spec=_activation.argument_spec(), supports_check_mode=True
    )
    _activation.run(
        module,
        operation_id="fixture_apply",
        label="fixture area",
        name_pattern=FIXTURE.keys[0].pattern,
        compare=_fixture_activation.compare_fixture,
        apply=_fixture_activation.apply_fixture,
        settle=_fixture_activation.settle_fixture,
    )


if __name__ == "__main__":
    main()
