"""Loopback-only invented appliance with an API, a resolver and a console.

Usage: fake_product.py STATE_DIR LIFETIME serves the API and the resolver;
fake_product.py console STATE_DIR answers one console request.

The appliance keeps its configuration in STATE_DIR/guest/fixture-config.json
and reads it on every request, so a console restore takes effect at once. A
nested record covering the API listener's address and port cuts off the API
(every request fails with 503) unless the anti-lockout setting is on, as it
is by default. The resolver answers the management name with the listener
address, except while an active fixture record is named like the first label
of the query; then it answers with that record's value.

The console runs a request's commands in /bin/sh from the guest directory, in
order, under the limits of the lab contract: a label, at most 32 printable
commands of at most 200 bytes each, one JSON status line as the answer.
"""
# FIXME Replace fixture routes, validation and activation with qualified behavior.

from __future__ import annotations

import base64
import copy
import fcntl
import ipaddress
import json
import re
import runpy
import socket
import socketserver
import struct
import subprocess
import sys
import threading
import time
import uuid
from pathlib import Path
from typing import Any

EMPTY = {"records": {}, "active": {}, "nested_rows": {}, "antilockout": True}


class Appliance:
    """The saved configuration, read and written whole."""

    def __init__(self, state: Path) -> None:
        self.guest = state / "guest"
        self.path = self.guest / "fixture-config.json"

    def load(self) -> dict[str, Any]:
        if not self.path.is_file():
            self.save(copy.deepcopy(EMPTY))
        loaded: dict[str, Any] = json.loads(self.path.read_text(encoding="utf-8"))
        return loaded

    def save(self, config: dict[str, Any]) -> None:
        self.guest.mkdir(parents=True, exist_ok=True)
        staged = self.path.with_suffix(".tmp")
        staged.write_text(json.dumps(config, indent=2, sort_keys=True) + "\n")
        staged.replace(self.path)


class Routes:
    def __init__(self, appliance: Appliance, credentials: str) -> None:
        self.appliance = appliance
        self.credentials = credentials

    def authorized(self, request: Any) -> bool:
        expected = "Basic " + base64.b64encode(self.credentials.encode()).decode()
        return request.headers.get("Authorization") == expected

    def locked_out(self, config: dict[str, Any], port: int) -> bool:
        if config["antilockout"]:
            return False
        listener = ipaddress.ip_address("127.0.0.1")
        return any(
            listener in ipaddress.ip_network(row["settings"]["network"])
            and row["settings"]["port"] == port
            for row in config["nested_rows"].values()
        )

    def nested_request(
        self,
        request: Any,
        config: dict[str, Any],
        action: str,
        name: str,
        data: dict[str, Any],
    ) -> None:
        rows = config["nested_rows"]
        if action == "get_item":
            request.send_json(200, {"nested": rows.get(name)})
            return
        if action == "del_item":
            rows.pop(name, None)
        else:
            record = copy.deepcopy(
                rows.get(
                    name,
                    {
                        "name": name,
                        "settings": {
                            "network": "198.51.100.0/24",
                            "port": 8080,
                            "unmanaged": "kept",
                        },
                        "secret": "SYNTHETIC-OLD-SECRET",
                    },
                )
            )
            record["settings"].update(data.get("settings", {}))
            rows[name] = record
        self.appliance.save(config)
        request.send_json(200, {"status": "ok"})

    def dispatch(self, request: Any) -> None:
        if not self.authorized(request):
            request.send_json(401, {"status": "failed"})
            return
        size = int(request.headers.get("Content-Length", "0"))
        data = json.loads(request.rfile.read(size)) if size else {}
        config = self.appliance.load()
        if self.locked_out(config, request.server.server_port):
            request.send_json(503, {"status": "unreachable"})
            return
        records, active = config["records"], config["active"]
        if request.path == "/api/system/version":
            request.send_json(200, {"version": "1.0.0"})
            return
        if request.path == "/api/fixture/reconfigure":
            config["active"] = copy.deepcopy(records)
            self.appliance.save(config)
            request.send_json(200, {"status": "ok"})
            return
        if request.path in (
            "/api/fixture/search_item",
            "/api/fixture/active/search_item",
        ):
            source = active if "/active/" in request.path else records
            rows = [{"uuid": key, **row} for key, row in source.items()]
            page, page_size = data["current"], min(2, data["rowCount"])
            request.send_json(
                200,
                {
                    "current": page,
                    "total": len(rows),
                    "rows": rows[(page - 1) * page_size : page * page_size],
                },
            )
            return
        if request.path == "/api/nested/context":
            request.send_json(
                200,
                {
                    "listener": {
                        "address": "127.0.0.1",
                        "port": request.server.server_port,
                    },
                    "defaults": {"network": "198.51.100.0/24", "port": 8080},
                },
            )
            return
        if request.path.startswith("/api/nested/"):
            _prefix, _api, _route, action, name = request.path.split("/")
            self.nested_request(request, config, action, name, data.get("nested", {}))
            return
        match = re.fullmatch(
            r"/api/fixture/(get_item|add_item|set_item|del_item)(?:/([^/]+))?",
            request.path,
        )
        if match is None:
            request.send_json(404, {})
            return
        action, key = match.groups()
        if action == "get_item":
            request.send_json(200, {"fixture": records.get(key, {})})
        elif action == "del_item":
            removed = records.pop(key, None)
            self.appliance.save(config)
            request.send_json(200, {"result": "deleted" if removed else "not found"})
        else:
            row = (
                dict(records[key])
                if key in records
                else {
                    "name": "",
                    "value": "",
                    "enabled": "1",
                    "labels": "",
                    "dependents": "",
                    "password": "SYNTHETIC-OLD-SECRET",
                }
            )
            row.update(data["fixture"])
            if row["value"] == "INVALID" or any(
                other["name"] == row["name"]
                for identity, other in records.items()
                if identity != key
            ):
                request.send_json(
                    200, {"result": "failed", "validations": {"value": "invalid"}}
                )
                return
            key = key or str(uuid.uuid4())
            records[key] = row
            self.appliance.save(config)
            request.send_json(200, {"result": "saved", "uuid": key})


class Resolver(socketserver.BaseRequestHandler):
    """One DNS query over TCP: an A record for every name, or a fixture's value."""

    appliance: Appliance

    def handle(self) -> None:
        header = self.request.recv(2)
        if len(header) < 2:
            return
        size = struct.unpack("!H", header)[0]
        query = b""
        while len(query) < size:
            chunk = self.request.recv(size - len(query))
            if not chunk:
                return
            query += chunk
        identity, labels, offset = struct.unpack("!H", query[:2])[0], [], 12
        while query[offset]:
            length = query[offset]
            labels.append(query[offset + 1 : offset + 1 + length].decode("ascii"))
            offset += 1 + length
        question = query[12 : offset + 5]
        address = "127.0.0.1"
        for row in self.appliance.load()["active"].values():
            if labels and row.get("name") == labels[0]:
                address = row.get("value", "")
        answers = b""
        try:
            packed = socket.inet_aton(address)
        except OSError:
            packed = b""
        if len(packed) == 4:
            answers = struct.pack("!HHHIH", 0xC00C, 1, 1, 60, 4) + packed
        reply = (
            struct.pack("!6H", identity, 0x8180, 1, 1 if answers else 0, 0, 0)
            + question
            + answers
        )
        self.request.sendall(struct.pack("!H", len(reply)) + reply)


def console(state: Path) -> int:
    """Answer one console request read from stdin with one status line."""
    started = time.monotonic()
    try:
        request = json.loads(sys.stdin.read())
    except ValueError:
        request = None
    label = request.get("label") if isinstance(request, dict) else None
    commands = request.get("commands") if isinstance(request, dict) else None
    if (
        not isinstance(label, str)
        or not re.fullmatch(r"[a-z0-9][a-z0-9-]{0,47}", label)
        or not isinstance(commands, list)
        or not 0 < len(commands) <= 32
        or not all(
            isinstance(command, str)
            and 0 < len(command.encode()) <= 200
            and command.isprintable()
            for command in commands
        )
    ):
        print(json.dumps({"status": "invalid"}))
        return 2
    appliance = Appliance(state)
    appliance.load()
    answer: dict[str, Any] = {"label": label, "commands": len(commands)}
    with (state / "console.lock").open("w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        status = "ok"
        with (state / "console.log").open("a", encoding="utf-8") as log:
            log.write(f"# console request {label}\n")
            for command in commands:
                completed = subprocess.run(
                    ["/bin/sh", "-c", command],
                    cwd=appliance.guest,
                    stdin=subprocess.DEVNULL,
                    stdout=log,
                    stderr=subprocess.STDOUT,
                    timeout=60,
                    check=False,
                )
                if completed.returncode:
                    status = "failed"
                    break
    answer["status"] = status
    answer["seconds"] = round(time.monotonic() - started, 3)
    print(json.dumps(answer))
    return 0 if status == "ok" else 1


def main() -> None:
    if sys.argv[1] == "console":
        raise SystemExit(console(Path(sys.argv[2])))
    state = Path(sys.argv[1])
    appliance = Appliance(state)
    appliance.load()
    routes = Routes(appliance, (state / "credentials").read_text().strip())
    Resolver.appliance = appliance
    serve = runpy.run_path(
        str(Path(__file__).parents[2] / "setup_loopback/files/server.py")
    )["serve"]
    resolver = socketserver.ThreadingTCPServer(("127.0.0.1", 0), Resolver)
    resolver.daemon_threads = True
    threading.Thread(target=resolver.serve_forever, daemon=True).start()
    try:
        (state / "dns-port.tmp").write_text(str(resolver.server_address[1]))
        (state / "dns-port.tmp").replace(state / "dns-port")
        serve(
            state,
            float(sys.argv[2]),
            routes.dispatch,
            routes.authorized,
            methods=("GET", "POST"),
            shutdown_payload={"status": "ok"},
            denied_payload={"status": "failed"},
        )
    finally:
        resolver.shutdown()
        resolver.server_close()


if __name__ == "__main__":
    main()
