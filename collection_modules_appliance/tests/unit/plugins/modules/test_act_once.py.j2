from ..conftest import RunModule
from .test_lifecycle import Store, Synthetic, lose, spec


class ActivationStore(Store):
    def __init__(self) -> None:
        super().__init__()
        self.applied = 0
        self.refuse_activation = False


class SyntheticActivation(ActOnce, Synthetic):
    def preflight(self) -> None:
        if any(row.get("referenced") for row in self.client.rows.values()):
            raise Failure(category="eligibility", code="referenced")

    def activate(self) -> None:
        def apply() -> None:
            self.client.applied += 1

        self.client.write("apply", apply)
        if self.client.refuse_activation:
            raise errors.ApiError(category="product", code="rejected")

    def effective(self) -> dict[str, Any]:
        return {"loaded": self.client.applied}


def main() -> None:
    arguments = spec()
    arguments["apply"] = {"type": "bool", "default": False}
    module = AnsibleModule(argument_spec=arguments, supports_check_mode=True)
    SyntheticActivation(module).execute(activation=module.params["apply"])


@pytest.fixture
def connection() -> dict[str, Any]:
    return {}


@pytest.fixture(autouse=True)
def store(monkeypatch: pytest.MonkeyPatch) -> ActivationStore:
    instance = ActivationStore()
    monkeypatch.setattr(SyntheticActivation, "connect", lambda self: instance)
    return instance


def test_act_once_keeps_its_sequence_reserved() -> None:
    for name in ("act_once", "execute"):
        with pytest.raises(TypeError, match=f"reserves: {name};"):
            type("Colliding", (ActOnce, Synthetic), {name: None})


def test_act_once_comes_before_the_classes_it_extends() -> None:
    with pytest.raises(TypeError, match=r"lists Synthetic before ActOnce"):
        type("Wrong", (Synthetic, ActOnce), {})
    assert issubclass(type("Area", (SyntheticActivation,), {}), ActOnce)


def test_act_once(store: ActivationStore, run_module: RunModule) -> None:
    predicted = run_module(main, apply=True, _ansible_check_mode=True)
    assert predicted["changed"] and predicted["activated"]
    assert predicted["verified"] == "predicted" and not store.writes
    for count in (1, 2):
        result = run_module(main, apply=True)
        assert result["verified"] == "unverifiable" and result["loaded"] == count
    store.after = lose
    lost = run_module(main, apply=True)
    assert lost["outcome"] == "unknown" and lost["operation"] == "apply"
    store.refuse_activation = True
    refused = run_module(main, apply=True)
    assert refused["outcome"] == "unknown" and refused["error_code"] == "rejected"
    store.rows["a"] = {"name": "a", "referenced": True}
    blocked = run_module(main, apply=True)
    assert blocked["outcome"] == "unchanged" and blocked["operation"] == "protect"
    assert store.writes == ["apply"] * 4
