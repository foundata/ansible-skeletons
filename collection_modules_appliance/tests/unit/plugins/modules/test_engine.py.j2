@pytest.mark.parametrize("reference", ["present", "malformed", "missing-key"])
def test_synthetic_deletion_guard(
    synthetic: SyntheticClient, run_module: RunModule, reference: str
) -> None:
    identity = synthetic.add(dependents=[7] if reference != "malformed" else 7)
    synthetic.dependents[7] = {"id": 7}
    if reference == "present":
        synthetic.dependents[7]["owner"] = identity
    result = run_module(entry(), label="example", state="absent")
    assert result["failed"]
    assert result["error_code"] == (
        "referenced" if reference == "present" else "schema"
    )
    assert not result["changed"] and result["outcome"] == "unchanged"
    assert not synthetic.writes and identity in synthetic.rows


