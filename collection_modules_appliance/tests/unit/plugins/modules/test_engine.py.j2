def test_undeclared_failure_key_is_left_out_and_the_code_kept() -> None:
    captured: dict[str, Any] = {}

    class Module:
        def fail_json(self, msg: str, **kwargs: Any) -> None:
            captured.update(kwargs)
            raise SystemExit(1)

    failure = ProductError(category="verification", code="not_persisted")
    with pytest.raises(SystemExit):
        fail(
            Module(),
            failure,
            msg="failed",
            changed=True,
            outcome="unknown",
            fields={"operation": "verify", "undeclared": "value"},
        )
    assert (captured["error_category"], captured["error_code"]) == (
        "verification",
        "not_persisted",
    )
    assert captured["operation"] == "verify" and "undeclared" not in captured
    assert captured["changed"] and captured["outcome"] == "unknown"


def test_unpublishable_identity_preserves_specific_error(
    run_module: RunModule, monkeypatch: pytest.MonkeyPatch
) -> None:
    resource = replace(SYNTHETIC, keys=(Key("label", "Optional component", r".*"),))

    def reject(*args: Any) -> None:
        raise ProductError(code="rejected")

    monkeypatch.setattr(_binding._compat, "check", reject)
    result = run_module(entry(resource), label="")
    assert result["failed"] and "label" not in result
    assert result["error_code"] == "rejected" and result["outcome"] == "unchanged"


@pytest.mark.parametrize(
    "fields,reported",
    [
        (["displayName", "a name with spaces"], True),
        (["x" * 300], False),
        (["line\nbreak"], False),
        ([f"field{index}" for index in range(257)], False),
    ],
)
def test_failure_after_a_write_keeps_changed_and_outcome(
    synthetic: SyntheticClient,
    run_module: RunModule,
    monkeypatch: pytest.MonkeyPatch,
    fields: list[str],
    reported: bool,
) -> None:
    synthetic.add()

    def mismatch(self: Engine, *args: Any) -> None:
        raise ProductError(category="verification", code="not_persisted", fields=fields)

    monkeypatch.setattr(Engine, "verify", mismatch)
    result = run_module(entry(), label="example", text="new")
    # The update moved the record, so the failed verification reports changed.
    assert result["failed"] and result["changed"] and result["outcome"] == "changed"
    assert result["operation"] == "verify" and synthetic.writes == ["update"]
    assert (result["error_category"], result["error_code"]) == (
        "verification",
        "not_persisted",
    )
    if reported:
        assert result["fields"] == fields
    else:
        assert "fields" not in result and result["label"] == "example"


@pytest.mark.parametrize(
    "option,checked", [("state", "synthetic:present"), ("", "synthetic")]
)
def test_find_checks_the_operation_of_the_definition(
    synthetic: SyntheticClient,
    run_module: RunModule,
    monkeypatch: pytest.MonkeyPatch,
    option: str,
    checked: str,
) -> None:
    class Checked(Engine):
        compatibility_always = True
        state_option = option

    operations: list[str] = []
    monkeypatch.setattr(
        _binding._compat, "check", lambda *args: operations.append(args[-1])
    )
    synthetic.add()

    def main() -> None:
        module = AnsibleModule(
            argument_spec=build_spec(SYNTHETIC), supports_check_mode=True
        )
        Checked(module, SYNTHETIC).execute()

    result = run_module(main, label="example")
    assert not result.get("failed") and not result["changed"]
    assert operations == [checked]


def test_stored_object_beyond_the_bounds_is_read_compared_and_deleted(
    synthetic: SyntheticClient, run_module: RunModule
) -> None:
    members = [f"member{index}" for index in range(257)] + ["x" * 151]
    synthetic.add(members=members)
    result = run_module(entry(), label="example", text="")
    assert not result.get("failed") and not result["changed"]
    assert sorted(result["synthetic"]["members"]) == sorted(members)
    removed = run_module(entry(), label="example", state="absent")
    assert not removed.get("failed") and removed["changed"]
    assert not synthetic.rows
