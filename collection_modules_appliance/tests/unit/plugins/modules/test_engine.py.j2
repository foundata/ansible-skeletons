from ..conftest import RunModule

IDENTIFIER = Key("id", "Synthetic identifier", kind="int", minimum=1)
SYNTHETIC = Resource(
    name="synthetic",
    route="/synthetic",
    keys=(Key("label", "Identity"),),
    fields=(Field("text", "str", "Text"), Field("members", "set", "Members")),
    result_key="synthetic",
    identifier=IDENTIFIER,
    refuse_delete_when=(
        DeletionGuard("dependents", "/dependent", "owner", IDENTIFIER),
    ),
)


class ProductError(errors.ApiError):
    def __init__(
        self,
        *,
        category: str = "product",
        code: str | None = None,
        fields: list[str] | None = None,
    ) -> None:
        super().__init__(category=category, code=code)
        self.fields = fields or []


def name(value: object) -> str:
    if (
        not isinstance(value, str)
        or not 0 < len(value) <= 253
        or any(ord(char) < 32 or ord(char) == 127 for char in value)
    ):
        raise ValueError("invalid synthetic name")
    return value


def names(value: object) -> list[str]:
    if not isinstance(value, list) or len(value) > 256:
        raise ValueError("invalid synthetic names")
    return [name(item) for item in value]


class SyntheticClient:
    def __init__(self) -> None:
        self.rows: dict[int, dict[str, Any]] = {}
        self.dependents: dict[int, dict[str, Any]] = {}
        self.writes: list[str] = []
        self.decoded: list[str] = []

    def add(self, **values: Any) -> int:
        identity = len(self.rows) + 1
        self.rows[identity] = {
            "id": identity,
            "label": "example",
            "text": "",
            "members": [],
            "dependents": [],
            **values,
        }
        return identity

    def list(self, definition: Any) -> list[dict[str, Any]]:
        if isinstance(definition, Reference):
            return [{"id": 7, "label": "owner"}]
        return list(self.rows.values())

    def get(self, definition: Any, identity: int) -> dict[str, Any] | None:
        rows = self.dependents if isinstance(definition, DeletionGuard) else self.rows
        return rows.get(identity)

    def decode(self, field: Field, value: Any) -> Any:
        self.decoded.append(field.name)
        if field.kind == "map":
            return {int(key): rights for key, rights in value.items()}
        return value

    @staticmethod
    def encode(field: Field, value: Any) -> Any:
        return value

    def create(self, resource: Resource, values: dict[str, Any]) -> None:
        self.writes.append("create")
        self.add(**values)

    def update(self, resource: Resource, identity: int, values: dict[str, Any]) -> None:
        self.writes.append("update")
        self.rows[identity].update(values)

    def delete(self, resource: Resource, identity: int) -> None:
        self.writes.append("delete")
        del self.rows[identity]


@pytest.fixture
def connection() -> dict[str, Any]:
    return {}


@pytest.fixture(autouse=True)
def synthetic(monkeypatch: pytest.MonkeyPatch) -> SyntheticClient:
    client = SyntheticClient()
    schema = errors.ErrorSchema(
        codes_by_category={
            "product": {None, "validation_failed", "rejected"},
            "argument": {"invalid_identity", "invalid_field"},
            "response": {"schema"},
            "eligibility": {"referenced"},
            "verification": {"not_persisted"},
        },
        fallback=("product", None),
        field_validators={"operation": name, "label": name, "fields": names},
    )
    monkeypatch.setattr(_binding, "Client", lambda params: client)
    monkeypatch.setattr(_engine, "ProductError", ProductError)
    monkeypatch.setattr(_binding.Binding, "schema", schema)
    monkeypatch.setattr(_engine, "api_argument_spec", dict)
    monkeypatch.setattr(_binding._compat, "check", lambda *args: None)
    return client


def entry(resource: Resource = SYNTHETIC) -> Callable[[], None]:
    def main() -> None:
        module = AnsibleModule(
            argument_spec=build_spec(resource), supports_check_mode=True
        )
        run_resource(module, resource)

    return main


@pytest.mark.parametrize("kind", ["set", "names"])
def test_set_bounds_follow_the_definition_on_input(kind: str) -> None:
    field = Field("members", kind, "Members")
    assert normalize(field, ["x" * 150], input_value=True) == ["x" * 150]
    for values in (["x" * 151], [str(i) for i in range(257)]):
        with pytest.raises(ProductError):
            normalize(field, values, input_value=True)
    larger = replace(field, maximum_items=300, item_limit=255)
    values = [str(i) for i in range(257)] + ["x" * 151]
    assert normalize(larger, values, input_value=True) == values
    for values in (["x" * 256], [str(i) for i in range(301)]):
        with pytest.raises(ProductError):
            normalize(larger, values, input_value=True)
    unbounded = replace(field, maximum_items=None, item_limit=None)
    values = [str(i) for i in range(301)] + ["x" * 256]
    assert normalize(unbounded, values, input_value=True) == values
    for input_value in (False, True):
        for invalid in ([""], [None], "not-a-list"):
            with pytest.raises(ProductError):
                normalize(unbounded, invalid, input_value=input_value)


@pytest.mark.parametrize("kind", ["set", "names"])
def test_stored_sets_are_read_beyond_the_bounds(kind: str) -> None:
    field = Field("members", kind, "Members")
    values = [str(i) for i in range(301)] + ["x" * 256]
    assert normalize(field, values) == values


def test_set_minimum_and_item_pattern_apply_to_input() -> None:
    field = Field("members", "set", "Members", minimum_items=1, pattern=r"[a-z]+")
    assert normalize(field, ["ab"], input_value=True) == ["ab"]
    for invalid in ([], ["A1"]):
        with pytest.raises(ProductError):
            normalize(field, invalid, input_value=True)
    assert normalize(field, []) == []
    with pytest.raises(ProductError):
        normalize(field, ["A1"])


def test_map_bounds_follow_the_definition_on_input() -> None:
    field = Field("rights", "map", "Rights", choices=("read",))
    assert normalize(field, {"x" * 150: ["read"]}, input_value=True) == {
        "x" * 150: ["read"]
    }
    for invalid in ({"x" * 151: ["read"]}, {str(i): ["read"] for i in range(257)}):
        with pytest.raises(ProductError):
            normalize(field, invalid, input_value=True)
        assert normalize(field, invalid) == invalid
    unbounded = replace(field, maximum_items=None, item_limit=None)
    assert normalize(unbounded, {"x" * 151: ["read"]}, input_value=True) == {
        "x" * 151: ["read"]
    }
    with pytest.raises(ProductError):
        normalize(unbounded, {"": ["read"]})


def test_stored_strings_are_read_beyond_the_limit() -> None:
    field = Field("note", "str", "Note", limit=10)
    assert normalize(field, "x" * 11) == "x" * 11
    with pytest.raises(ProductError):
        normalize(field, "x" * 11, input_value=True)


def test_an_integer_range_applies_to_declared_values_only(
    synthetic: SyntheticClient, run_module: RunModule
) -> None:
    port = Field("port", "int", "Port", minimum=1, maximum=65535)
    for value in (1, 65535):
        assert normalize(port, value, input_value=True) == value
    for value in (0, 65536):
        with pytest.raises(ProductError) as refused:
            normalize(port, value, input_value=True)
        assert (refused.value.category, refused.value.code) == (
            "argument",
            "invalid_field",
        )
        assert refused.value.fields == ["port"]
        assert normalize(port, value) == value
    resource = replace(SYNTHETIC, fields=(*SYNTHETIC.fields, port))
    synthetic.add(port=70000)
    kept = run_module(entry(resource), label="example")
    assert not kept.get("failed") and not kept["changed"]
    assert kept["synthetic"]["port"] == 70000
    refused_run = run_module(entry(resource), label="example", port=70000)
    assert refused_run["failed"] and refused_run["error_code"] == "invalid_field"
    assert refused_run["fields"] == ["port"] and not synthetic.writes
    moved = run_module(entry(resource), label="example", port=443)
    assert moved["changed"] and synthetic.rows[1]["port"] == 443


@pytest.mark.parametrize(
    "field,valid,invalid,malformed",
    [
        (
            Field("mode", "choice", "Mode", choices=("local",), input_only=True),
            "local",
            ["remote"],
            [7],
        ),
        (
            Field("code", "str", "Code", pattern=r"[a-z]+", input_only=True),
            "ab",
            ["A1"],
            [7],
        ),
        *(
            (
                Field(
                    "tags",
                    kind,
                    "Tags",
                    choices=("a", "Z"),
                    pattern=r"[a-z]",
                    input_only=True,
                ),
                ["a"],
                [["c"], ["Z"]],
                [7, [""], [None]],
            )
            for kind in ("set", "names")
        ),
    ],
)
def test_input_only_rules_apply_to_declared_values_only(
    field: Field, valid: Any, invalid: list[Any], malformed: list[Any]
) -> None:
    assert normalize(field, valid, input_value=True) == valid
    for value in invalid:
        with pytest.raises(ProductError) as refused:
            normalize(field, value, input_value=True)
        assert (refused.value.category, refused.value.code) == (
            "argument",
            "invalid_field",
        )
        assert refused.value.fields == [field.name]
        assert normalize(field, value) == value
    for value in malformed:
        with pytest.raises(ProductError) as broken:
            normalize(field, value)
        assert (broken.value.category, broken.value.code) == ("response", "schema")


def test_an_input_only_field_reads_stored_values_and_leaves_null_unmanaged(
    synthetic: SyntheticClient, run_module: RunModule
) -> None:
    mode = Field("mode", "choice", "Mode", choices=("local",), input_only=True)
    resource = replace(SYNTHETIC, fields=(*SYNTHETIC.fields, mode))
    assert build_spec(resource)["mode"] == {"type": "str"}
    listed = replace(resource, fields=(replace(mode, input_only=False),))
    assert build_spec(listed)["mode"]["choices"] == ["local"]
    synthetic.add(mode="remote")
    for args in ({}, {"mode": None}):
        kept = run_module(entry(resource), label="example", **args)
        assert not kept.get("failed") and not kept["changed"]
        assert kept["synthetic"]["mode"] == "remote"
    refused = run_module(entry(resource), label="example", mode="remote")
    assert refused["failed"] and refused["error_code"] == "invalid_field"
    assert refused["fields"] == ["mode"] and not synthetic.writes
    moved = run_module(entry(resource), label="example", mode="local")
    assert moved["changed"] and synthetic.rows[1]["mode"] == "local"
    assert synthetic.writes == ["update"]


