from ..conftest import RunModule
from . import contract_subject as subject


def arguments(index: int = 0, /, **values: Any) -> dict[str, Any]:
    return {**subject.ARGS, subject.KEY: subject.IDENTITIES[index], **values}


def require(capability: str) -> None:
    if not subject.CAPABILITIES[capability]:
        pytest.skip(subject.SKIP_REASONS[capability])


def info_main() -> Callable[[], None]:
    if subject.INFO_MAIN is None:
        pytest.skip(subject.SKIP_REASONS["info"])
    return subject.INFO_MAIN


def entry(resource: Resource) -> Callable[[], None]:
    def main() -> None:
        module = AnsibleModule(
            argument_spec=build_spec(resource), supports_check_mode=True
        )
        run_resource(module, resource)

    return main


def test_lifecycle_preserves_unmanaged_fields(fake: Any, run_module: RunModule) -> None:
    first, second = subject.VALUES
    created = run_module(subject.main, **arguments(**{subject.VALUE: first}))
    identity = created[subject.RESULT][subject.RESOURCE.identifier.name]
    assert created["changed_fields"] == [] and created["verified"] == "observed"
    subject.rows(fake)[identity]["unmanaged"] = subject.OLD_SECRET
    assert not run_module(subject.main, **arguments(**{subject.VALUE: first}))[
        "changed"
    ]
    changed = run_module(
        subject.main, **arguments(**{subject.VALUE: second}), _ansible_diff=True
    )
    assert changed["changed_fields"] == [subject.VALUE]
    assert changed["diff"] == {
        "before": {subject.VALUE: first},
        "after": {subject.VALUE: second},
    }
    assert subject.rows(fake)[identity]["unmanaged"] == subject.OLD_SECRET


def test_delete_is_idempotent(fake: Any, run_module: RunModule) -> None:
    require("delete")
    subject.add(fake, **arguments(**{subject.VALUE: subject.VALUES[0]}))
    assert run_module(subject.main, **arguments(state="absent"))[subject.RESULT] is None
    count = len(fake.writes())
    assert not run_module(subject.main, **arguments(state="absent"))["changed"]
    assert len(fake.writes()) == count


@pytest.mark.parametrize("incomplete", [False, True])
def test_listing_is_complete_or_fails(
    fake: Any, run_module: RunModule, incomplete: bool
) -> None:
    require("listing")
    for index in range(5):
        subject.add(fake, **arguments(index))
    if incomplete:
        subject.make_incomplete(fake)
    result = run_module(
        entry(replace(subject.RESOURCE, lookup="listing")), **arguments(4)
    )
    assert bool(result.get("failed")) == incomplete
    assert not fake.writes()
    if incomplete:
        assert result["error_code"] == "incomplete_listing"
    else:
        assert result[subject.RESULT][subject.KEY] == subject.IDENTITIES[4]


def test_ambiguous_listing_refuses_write(fake: Any, run_module: RunModule) -> None:
    require("listing")
    subject.add(fake, **arguments())
    subject.add(fake, **arguments())
    result = run_module(
        entry(replace(subject.RESOURCE, lookup="listing")),
        **arguments(**{subject.VALUE: subject.VALUES[1]}),
    )
    assert result["error_code"] == "ambiguous" and not fake.writes()


@pytest.mark.parametrize("operation", ["create", "update", "delete"])
def test_lost_response_never_repeats_write(
    fake: Any, run_module: RunModule, operation: str
) -> None:
    if operation == "delete":
        require("delete")
    if operation != "create":
        subject.add(fake, **arguments(**{subject.VALUE: subject.VALUES[0]}))
    subject.lose_next(fake, operation, subject.lost_response)
    result = run_module(
        subject.main,
        **arguments(**{subject.VALUE: subject.VALUES[1]}),
        state="absent" if operation == "delete" else "present",
    )
    assert not result.get("failed") and result["verified"] == "observed"
    assert len(fake.writes()) == 1


def test_possible_write_then_failed_read_is_unknown(
    fake: Any, run_module: RunModule
) -> None:
    def fail_read() -> None:
        subject.deny(fake)
        subject.lost_response()

    subject.lose_next(fake, "create", fail_read)
    result = run_module(subject.main, **arguments())
    assert result["failed"] and result["changed"] and result["outcome"] == "unknown"
    assert len(subject.rows(fake)) == 1 and len(fake.writes()) == 1


def test_acknowledged_update_that_did_not_persist_is_unknown(
    fake: Any, run_module: RunModule
) -> None:
    require("drop")
    subject.add(fake, **arguments(**{subject.VALUE: subject.VALUES[0]}))
    subject.drop_next(fake, "update")
    result = run_module(subject.main, **arguments(**{subject.VALUE: subject.VALUES[1]}))
    assert result["failed"] and result["error_code"] == "not_persisted"
    assert result["fields"] == [subject.VALUE]
    assert result["changed"] and result["outcome"] == "unknown"
    assert len(fake.writes()) == 1


def test_rejected_update_that_took_effect_is_changed(
    fake: Any, run_module: RunModule
) -> None:
    require("reject")
    subject.add(fake, **arguments(**{subject.VALUE: subject.VALUES[0]}))
    subject.reject_next(fake, "update")
    result = run_module(subject.main, **arguments(**{subject.VALUE: subject.VALUES[1]}))
    assert result["failed"] and result["error_code"] == "validation_failed"
    assert result["changed"] and result["outcome"] == "changed"
    assert len(fake.writes()) == 1


def test_creation_missing_at_read_back_is_unknown(
    fake: Any, run_module: RunModule
) -> None:
    subject.lose_next(fake, "create", lambda: subject.rows(fake).clear())
    result = run_module(subject.main, **arguments())
    assert result["failed"] and result["error_code"] == "missing_after_write"
    assert result["changed"] and result["outcome"] == "unknown"
    assert len(fake.writes()) == 1


def test_delete_acknowledgement_does_not_prove_absence(
    fake: Any, run_module: RunModule, monkeypatch: pytest.MonkeyPatch
) -> None:
    require("delete")
    subject.add(fake, **arguments())
    monkeypatch.setattr(Client, "delete", lambda self, resource, identity: None)
    result = run_module(subject.main, **arguments(state="absent"))
    assert result["failed"] and result["error_code"] == "still_present"
    assert result["changed"] and result["outcome"] == "unknown"
    assert (
        result["operation"] == "verify" and result[subject.KEY] == subject.IDENTITIES[0]
    )
    assert len(subject.rows(fake)) == 1


def test_failure_repeats_the_identity_the_schema_allows(
    fake: Any, run_module: RunModule
) -> None:
    assert {key.name for key in subject.RESOURCE.keys} <= set(SCHEMA.field_validators)
    subject.fault(fake, subject.VERSION_PATH, 500)
    result = run_module(subject.main, **arguments())
    assert result["failed"] and result[subject.KEY] == subject.IDENTITIES[0]
    assert not result["changed"] and result["outcome"] == "unchanged"
    assert "resource" not in result and not fake.writes()


@pytest.mark.parametrize(
    "status,category,code",
    [
        (401, "auth", "unauthenticated"),
        (403, "auth", "forbidden"),
        (422, "product", "validation_failed"),
        (500, "product", "rejected"),
    ],
)
def test_status_classification_needs_no_json(
    fake: Any, run_module: RunModule, status: int, category: str, code: str
) -> None:
    subject.fault(fake, subject.VERSION_PATH, status)
    result = run_module(subject.main, **arguments())
    assert (result["error_category"], result["error_code"]) == (category, code)
    assert not fake.writes()


@pytest.mark.parametrize("state", ["present", "absent"])
@pytest.mark.parametrize("exists", [False, True])
@pytest.mark.parametrize("diff", [False, True])
def test_check_mode_and_secrets(
    fake: Any, run_module: RunModule, state: str, exists: bool, diff: bool
) -> None:
    if state == "absent":
        require("delete")
    if exists:
        subject.add(fake, **arguments(**{subject.VALUE: subject.VALUES[0]}))
    result = run_module(
        subject.main,
        **arguments(**{subject.VALUE: subject.VALUES[1]}),
        state=state,
        _ansible_check_mode=True,
        _ansible_diff=diff,
    )
    assert not fake.writes() and not result.get("failed")
    assert result["verified"] == ("predicted" if result["changed"] else "observed")
    if not exists and state == "present":
        assert subject.RESOURCE.identifier.name not in result[subject.RESULT]
    secrets = result.pop("_ansible_new_secrets", [])
    assert set(secrets) <= set(subject.SECRETS)
    assert all(
        secret not in json.dumps(result)
        for secret in (*subject.SECRETS, subject.OLD_SECRET)
    )


def test_info_reads_without_writing_or_discovering_version(
    fake: Any, run_module: RunModule
) -> None:
    main = info_main()
    subject.add(fake, **arguments())
    result = run_module(main, **{subject.KEY: subject.IDENTITIES[0]})
    assert not result["changed"] and result["verified"] == "observed"
    assert result[subject.RESULT][subject.KEY] == subject.IDENTITIES[0]
    assert not fake.writes() and not subject.requested(fake, subject.VERSION_PATH)


def test_info_failure_keeps_identity(fake: Any, run_module: RunModule) -> None:
    main = info_main()
    subject.deny(fake)
    result = run_module(main, **{subject.KEY: subject.IDENTITIES[0]})
    assert result["failed"] and result[subject.KEY] == subject.IDENTITIES[0]
    assert not result["changed"] and result["outcome"] == "unchanged"
    assert not fake.writes() and "resource" not in result


def test_noop_does_not_discover_version(fake: Any, run_module: RunModule) -> None:
    subject.add(fake, **arguments())
    assert not run_module(subject.main, **arguments())["changed"]
    assert not subject.requested(fake, subject.VERSION_PATH)


def test_check_prediction_validates_eligibility(
    fake: Any, run_module: RunModule, monkeypatch: pytest.MonkeyPatch
) -> None:
    monkeypatch.setattr(
        _compat,
        "EXCLUSIONS",
        {subject.OPERATION: ((subject.VERSION, "synthetic exclusion"),)},
    )
    result = run_module(subject.main, **arguments(), _ansible_check_mode=True)
    assert result["error_code"] == "ineligible" and not fake.writes()


def test_version_is_cached_but_each_operation_is_checked(
    fake: Any, connection: dict[str, Any], monkeypatch: pytest.MonkeyPatch
) -> None:
    params = {
        **connection,
        "validate_certs": True,
        "ca_path": None,
        "use_proxy": False,
        "timeout": 10,
        "deadline": 30,
    }
    client = Client(params)

    class Module:
        def warn(self, message: str) -> None:
            raise AssertionError(message)

    _compat.check(Module(), client, "first")
    monkeypatch.setattr(
        _compat, "EXCLUSIONS", {"second": ((subject.VERSION, "synthetic exclusion"),)}
    )
    with pytest.raises(ProductError):
        _compat.check(Module(), client, "second")
    assert subject.requested(fake, subject.VERSION_PATH) == 1
