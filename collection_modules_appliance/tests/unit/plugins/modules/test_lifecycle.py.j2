@pytest.mark.parametrize("refused", [False, True])
def test_engine_info_probes_before_product_reads(
    monkeypatch: pytest.MonkeyPatch, always: bool, refused: bool
) -> None:
    events: list[str] = []
    resource = Resource(
        name="synthetic",
        route="synthetic",
        keys=(Key("name", "Name"),),
        fields=(),
        result_key="synthetic",
        identifier=Key("id", "Identifier", kind="int"),
        lookup="by_key",
        permission_probe="read",
    )
    record = {"id": 1, "name": "a"}

    def compatibility(self: Binding, operation: str) -> None:
        events.append(operation)
        if refused:
            raise Failure(category="compatibility", code="ineligible")

    def lookup(definition: Resource, ident: dict[str, str]) -> dict[str, Any]:
        events.append("lookup")
        return record

    monkeypatch.setattr(Binding, "compatibility_always", always)
    monkeypatch.setattr(Binding, "compatibility", compatibility)
    client = SimpleNamespace(probe=events.append, lookup=lookup)
