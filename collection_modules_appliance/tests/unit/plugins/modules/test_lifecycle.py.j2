def test_the_base_docstring_names_every_hook_setting_and_reserved_name() -> None:
    sequence = {name for name in vars(Lifecycle) if not name.startswith("_")}
    documentation = sys.modules[Lifecycle.__module__].__doc__ or ""
    for name in sequence | HOOKS | SETTINGS | STATE:
        assert f"``{name}``" in documentation, name


def lifecycle_classes() -> list[type[Lifecycle]]:
    """Every lifecycle class defined below the collection's module_utils."""
    found: list[type[Lifecycle]] = []
    for info in pkgutil.walk_packages(
        module_utils.__path__, module_utils.__name__ + "."
    ):
        module = importlib.import_module(info.name)
        found.extend(
            cls
            for cls in vars(module).values()
            if inspect.isclass(cls)
            and issubclass(cls, Lifecycle)
            and cls.__module__ == module.__name__
        )
    return found


def test_overrides_keep_the_parameter_names_of_what_they_override() -> None:
    # Only ansible-test sanity's pylint (arguments-renamed) reports a renamed
    # one; this covers the product's copies of the scaffold as well.
    classes = lifecycle_classes()
    assert Binding in classes
    for cls in classes:
        for name, method in vars(cls).items():
            base = next(
                (vars(b)[name] for b in cls.__mro__[1:] if name in vars(b)), None
            )
            if (
                name.startswith("__")
                or name in cls._sequence
                or not inspect.isfunction(method)
                or not inspect.isfunction(base)
            ):
                continue
            assert list(inspect.signature(method).parameters) == list(
                inspect.signature(base).parameters
            ), f"{cls.__qualname__}.{name}"


def spec() -> dict[str, Any]:
    return {
        "name": {"type": "str"},
        "value": {"type": "str"},
        "secret": {"type": "str", "no_log": True},
        "update_password": {
            "type": "str",
            "choices": ["on_create", "always"],
            "default": "on_create",
            "no_log": False,
        },
        "state": {
            "type": "str",
            "choices": ["present", "absent"],
            "default": "present",
        },
    }


def main() -> None:
    module = AnsibleModule(argument_spec=spec(), supports_check_mode=True)
    Synthetic(module).execute()


