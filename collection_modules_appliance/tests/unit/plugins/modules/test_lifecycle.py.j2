def field_names(value: object) -> list[str]:
    if not isinstance(value, list) or not all(isinstance(name, str) for name in value):
        raise ValueError("Fields must be a list of names")
    return value


SCHEMA = errors.ErrorSchema(
    codes_by_category={
        "internal": {None},
        "timeout": {"socket_timeout"},
        "product": {"rejected"},
        "eligibility": {"referenced", "stale"},
        "compatibility": {"ineligible"},
        "local": {"operation_failed"},
        "verification": {
            "still_present",
            "missing_after_write",
            "not_persisted",
            "create_unknown",
        },
    },
    fallback=("internal", None),
    field_validators={"operation": str, "name": str, "fields": field_names},
)


class Store:
    def __init__(self) -> None:
        self.rows: dict[str, dict[str, Any]] = {}
        self.writes: list[str] = []
        self.versions = 0
        self.after: Callable[[], None] | None = None
        self.drop = False

    def write(self, kind: str, apply: Callable[[], None]) -> None:
        self.writes.append(kind)
        if not self.drop:
            apply()
        hook, self.after = self.after, None
        if hook:
            hook()


def lose() -> None:
    raise errors.TransportTimeout(code="socket_timeout")


def refuse() -> None:
    raise errors.ApiError(category="product", code="rejected")


class Synthetic(Lifecycle):
    schema = SCHEMA
    result_key = "synthetic"
    compatibility_id = "synthetic"
    identity_options = ("name",)
    steps = (("lookup", "find"),)

    def connect(self) -> Store:
        raise NotImplementedError

    def compatibility(self, operation: str) -> None:
        self.client.versions += 1

    def identify(self) -> str:
        return str(self.params["name"])

    def declared(self) -> dict[str, Any]:
        return {
            key: self.params[key]
            for key in ("value", "secret")
            if self.params.get(key) is not None
        }

    def lookup(self) -> dict[str, Any] | None:
        return self.client.rows.get(self.key)

    def managed(self, record: dict[str, Any]) -> dict[str, Any]:
        return {"name": record["name"], "value": record.get("value")}

    def secret(self, name: str) -> bool:
        return name == "secret"

    def protect(self) -> None:
        if self.absent and self.record and self.record.get("referenced"):
            raise Failure(category="eligibility", code="referenced")

    def write(self) -> None:
        rows, key, delta = self.client.rows, self.key, dict(self.delta)
        if self.absent:
            self.client.write("delete", lambda: rows.pop(key))
        elif self.record is None:
            self.client.write(
                "create", lambda: rows.update({key: {"name": key, **delta}})
            )
        else:
            self.client.write("update", lambda: rows[key].update(delta))


