    if always and refused:
        with pytest.raises(Failure):
            engine.find({"name": "a"})
        assert events == ["synthetic_info"]
        assert engine.operation == "compatibility"
        return
    for operation in ("find", "verify"):
        engine.operation = operation
        assert engine.find({"name": "a"}) == record
        assert engine.operation == operation
    assert events == (["synthetic_info"] if always else []) + [
