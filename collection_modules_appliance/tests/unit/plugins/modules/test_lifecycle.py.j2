@pytest.mark.parametrize("check_mode", [False, True])
def test_compatibility_can_run_before_every_lookup(
    store: Store,
    run_module: RunModule,
    monkeypatch: pytest.MonkeyPatch,
    check_mode: bool,
) -> None:
    monkeypatch.setattr(Synthetic, "compatibility_always", True)
    run_module(main, name="a", value="1")
    result = run_module(main, name="a", value="1", _ansible_check_mode=check_mode)
    assert not result["changed"] and store.versions == 2
    assert store.writes == ["create"]

    def ineligible(self: Synthetic, operation: str) -> None:
        raise Failure(category="compatibility", code="ineligible")

    monkeypatch.setattr(Synthetic, "compatibility", ineligible)
    refused = run_module(main, name="a", value="1", _ansible_check_mode=check_mode)
    assert refused["error_code"] == "ineligible"
    assert refused["operation"] == "compatibility"
    assert refused["outcome"] == "unchanged" and store.writes == ["create"]


@pytest.mark.parametrize(
    "arguments",
    [
        {"value": "1"},
        {"value": "2", "_ansible_check_mode": True},
        {"value": "2"},
        {"state": "absent"},
    ],
)
def test_result_hooks_cover_unchanged_predicted_written_and_deleted_results(
    store: Store,
    run_module: RunModule,
    monkeypatch: pytest.MonkeyPatch,
    arguments: dict[str, Any],
) -> None:
    store.rows["a"] = {"name": "a", "value": "1"}

    def finish(self: Synthetic, result: dict[str, Any]) -> dict[str, Any]:
        result["pending"] = self.module.check_mode and result["changed"]
        result["completed"] = True
        return result

    monkeypatch.setattr(Synthetic, "finish", finish)
    monkeypatch.setattr(
        Synthetic,
        "changed_fields",
        lambda self: ["settings.value"] if self.delta else [],
    )
    result = run_module(main, name="a", **arguments)
    assert result["completed"]
    assert result["pending"] == bool(arguments.get("_ansible_check_mode"))
    expected = ["settings.value"] if arguments.get("value") == "2" else []
    assert result["changed_fields"] == expected


def test_whole_object_diff_contains_only_public_state(
    store: Store, run_module: RunModule, monkeypatch: pytest.MonkeyPatch
) -> None:
    monkeypatch.setattr(Synthetic, "whole_diff", True)
    store.rows["a"] = {"name": "a", "value": "1", "secret": "private"}
    result = run_module(main, name="a", value="2", _ansible_diff=True)
    assert result["diff"] == {
        "before": {"name": "a", "value": "1"},
        "after": {"name": "a", "value": "2"},
    }
    created = run_module(
        main, name="b", value="3", secret="private", _ansible_diff=True
    )
    assert created["diff"] == {
        "before": {},
        "after": {"name": "b", "value": "3"},
    }
    deleted = run_module(main, name="a", state="absent", _ansible_diff=True)
    assert deleted["diff"] == {
        "before": {"name": "a", "value": "2"},
        "after": {},
    }
    for response in (result, created, deleted):
        registered = response.pop("_ansible_new_secrets", [])
        assert set(registered) <= {"private"}
        assert "private" not in str(response)


@pytest.mark.parametrize("existing", [False, True])
def test_default_recheck_refuses_a_moved_record_with_the_configured_code(
    store: Store,
    run_module: RunModule,
    monkeypatch: pytest.MonkeyPatch,
    existing: bool,
) -> None:
    if existing:
        store.rows["a"] = {"name": "a", "value": "1"}
    monkeypatch.setattr(Synthetic, "recheck_code", "stale")
    original = Synthetic.lookup
    reads = 0

    def lookup(self: Synthetic) -> dict[str, Any] | None:
        nonlocal reads
        reads += 1
        if reads == 2:
            store.rows["a"] = {"name": "a", "value": "external"}
        return original(self)

    monkeypatch.setattr(Synthetic, "lookup", lookup)
    result = run_module(main, name="a", value="2")
    assert result["error_code"] == "stale" and result["operation"] == "recheck"
    assert result["outcome"] == "unchanged" and not store.writes
    assert reads == 2


def test_refusal_can_measure_progress_over_the_whole_context(
    store: Store, run_module: RunModule, monkeypatch: pytest.MonkeyPatch
) -> None:
    store.rows["a"] = {"name": "a", "value": "1"}
    store.rows["peer"] = {"name": "peer", "value": "1"}

    def partial() -> None:
        store.rows["peer"]["value"] = "2"
        refuse()

    monkeypatch.setattr(
        Synthetic, "moved", lambda self, observed: store.rows["peer"]["value"] != "1"
    )
    store.drop, store.after = True, partial
    result = run_module(main, name="a", value="2")
    assert result["failed"] and result["error_code"] == "rejected"
    assert result["changed"] and result["outcome"] == "changed"
    assert store.rows["a"]["value"] == "1" and store.writes == ["update"]


def action_main(action: Callable[[Synthetic], dict[str, Any]]) -> Callable[[], None]:
    def entrypoint() -> None:
        module = AnsibleModule(argument_spec=spec(), supports_check_mode=True)
        subject = Synthetic(module)
        subject.execute(action=lambda: action(subject))

    return entrypoint


@pytest.mark.parametrize(
    "attempted,confirmed,outcome",
    [(False, False, "unchanged"), (True, False, "unknown"), (True, True, "changed")],
)
def test_custom_operation_uses_the_same_failure_boundary(
    run_module: RunModule, attempted: bool, confirmed: bool, outcome: str
) -> None:
    def action(subject: Synthetic) -> dict[str, Any]:
        subject.operation = "job"
        subject.attempted, subject.confirmed = attempted, confirmed
        raise Failure(category="product", code="rejected")

    result = run_module(action_main(action), name="a")
    assert result["failed"] and result["outcome"] == outcome
    assert result["operation"] == "job" and result["name"] == "a"


def test_local_os_error_fails_without_its_message(run_module: RunModule) -> None:
    def action(subject: Synthetic) -> dict[str, Any]:
        subject.operation = "deliver"
        subject.attempted = subject.confirmed = True
        raise PermissionError(13, "Permission denied", "/private/SYNTHETIC-path")

    result = run_module(action_main(action), name="a")
    assert (result["error_category"], result["error_code"]) == (
        "local",
        "operation_failed",
    )
    assert result["operation"] == "deliver" and result["outcome"] == "changed"
    assert "SYNTHETIC-path" not in json.dumps(result)
    assert Binding.schema.allows("local", "operation_failed")


def test_custom_operation_finishes_its_result(
    run_module: RunModule, monkeypatch: pytest.MonkeyPatch
) -> None:
    monkeypatch.setattr(
        Synthetic, "finish", lambda self, result: {**result, "receipt": "complete"}
    )
    result = run_module(action_main(lambda subject: {"changed": False}), name="a")
    assert not result["changed"] and result["receipt"] == "complete"


@pytest.mark.parametrize("always", [False, True])
@pytest.mark.parametrize("check_mode", [False, True])
def test_custom_operation_probes_before_action(
    store: Store,
    run_module: RunModule,
    monkeypatch: pytest.MonkeyPatch,
    always: bool,
    check_mode: bool,
) -> None:
    monkeypatch.setattr(Synthetic, "compatibility_always", always)

    def action(subject: Synthetic) -> dict[str, Any]:
        assert store.versions == int(always) and subject.client is store
        assert subject.operation == "validate"
        if always:
            subject.ensure_compatible(subject.operation_id())
        return {"changed": False}

    result = run_module(action_main(action), name="a", _ansible_check_mode=check_mode)
    assert not result["changed"] and store.versions == int(always)
    assert not store.writes


def test_custom_operation_keeps_its_preset_operation_after_preparing(
    run_module: RunModule,
) -> None:
    def entrypoint() -> None:
        module = AnsibleModule(argument_spec=spec(), supports_check_mode=True)
        subject = Synthetic(module)
        subject.operation = "job"

        def action() -> dict[str, Any]:
            raise Failure(category="product", code="rejected")

        subject.execute(action=action)

    result = run_module(entrypoint, name="a")
    assert result["failed"] and result["operation"] == "job"


def test_custom_operation_never_runs_without_a_connection(
    store: Store, run_module: RunModule, monkeypatch: pytest.MonkeyPatch
) -> None:
    def refuse_connection(self: Synthetic) -> Store:
        raise Failure(category="product", code="rejected")

    def action(subject: Synthetic) -> dict[str, Any]:
        raise AssertionError("An action without a client must not run")

    monkeypatch.setattr(Synthetic, "connect", refuse_connection)
    result = run_module(action_main(action), name="a")
    assert result["failed"] and result["operation"] == "connect"
    assert result["outcome"] == "unchanged" and not store.writes


def test_custom_operation_refuses_before_action(
    store: Store, run_module: RunModule, monkeypatch: pytest.MonkeyPatch
) -> None:
    monkeypatch.setattr(Synthetic, "compatibility_always", True)

    def ineligible(self: Synthetic, operation: str) -> None:
        raise Failure(category="compatibility", code="ineligible")

    def action(subject: Synthetic) -> dict[str, Any]:
        raise AssertionError("An ineligible action must not run")

    monkeypatch.setattr(Synthetic, "compatibility", ineligible)
    result = run_module(action_main(action), name="a")
