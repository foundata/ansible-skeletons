def test_resource_lifecycle(store: Store, run_module: RunModule) -> None:
    predicted = run_module(main, name="a", value="1", _ansible_check_mode=True)
    assert predicted["verified"] == "predicted" and not store.writes
    assert predicted["synthetic"] == {"name": "a", "value": "1"}
    created = run_module(main, name="a", value="1", _ansible_diff=True)
    assert created["changed"] and created["verified"] == "observed"
    assert created["changed_fields"] == [] and created["diff"]["after"] == {
        "value": "1"
    }
    versions = store.versions
    assert not run_module(main, name="a", value="1")["changed"]
    assert store.versions == versions
    updated = run_module(main, name="a", value="2", _ansible_diff=True)
    assert updated["changed_fields"] == ["value"]
    assert updated["diff"] == {"before": {"value": "1"}, "after": {"value": "2"}}
    assert run_module(main, name="a", state="absent")["synthetic"] is None
    assert not run_module(main, name="a", state="absent")["changed"]
    assert store.writes == ["create", "update", "delete"]


@pytest.mark.parametrize("operation", ["create", "update", "delete"])
def test_lost_reply_settles_by_read_back(
    store: Store, run_module: RunModule, operation: str
) -> None:
    if operation != "create":
        store.rows["a"] = {"name": "a", "value": "1"}
    store.after = lose
    result = run_module(
        main,
        name="a",
        value="2",
        state="absent" if operation == "delete" else "present",
    )
    assert not result.get("failed") and result["verified"] == "observed"
    assert store.writes == [operation]


@pytest.mark.parametrize(
    "existing,code", [(False, "missing_after_write"), (True, "not_persisted")]
)
def test_lost_reply_without_effect_is_unknown(
    store: Store, run_module: RunModule, existing: bool, code: str
) -> None:
    if existing:
        store.rows["a"] = {"name": "a", "value": "1"}
    store.drop, store.after = True, lose
    result = run_module(main, name="a", value="2")
    assert result["failed"] and result["error_code"] == code
    assert result["changed"] and result["outcome"] == "unknown"
    assert result["operation"] == "reconcile" and result["name"] == "a"


@pytest.mark.parametrize("lost_reply", [False, True])
def test_moved_read_back_that_misses_the_declaration_is_changed(
    store: Store, run_module: RunModule, lost_reply: bool
) -> None:
    store.rows["a"] = {"name": "a", "value": "1"}

    def elsewhere() -> None:
        store.rows["a"]["value"] = "other"
        if lost_reply:
            lose()

    store.drop, store.after = True, elsewhere
    result = run_module(main, name="a", value="2")
    assert result["failed"] and result["error_code"] == "not_persisted"
    assert result["changed"] and result["outcome"] == "changed"
    assert result["operation"] == ("reconcile" if lost_reply else "verify")
    assert store.writes == ["update"]


@pytest.mark.parametrize("drop,outcome", [(False, "changed"), (True, "unchanged")])
def test_refusal_reports_what_the_read_back_shows(
    store: Store, run_module: RunModule, drop: bool, outcome: str
) -> None:
    store.rows["a"] = {"name": "a", "value": "1"}
    store.drop, store.after = drop, refuse
    result = run_module(main, name="a", value="2")
    assert result["failed"] and result["error_code"] == "rejected"
    assert result["outcome"] == outcome and result["changed"] == (not drop)
    assert result["operation"] == "update" and store.writes == ["update"]


def test_a_refusal_that_may_change_unseen_state_stays_unknown(
