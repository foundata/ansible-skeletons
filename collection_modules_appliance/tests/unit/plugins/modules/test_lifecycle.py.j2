def test_guard_and_identity_on_failure(store: Store, run_module: RunModule) -> None:
    store.rows["a"] = {"name": "a", "value": "1", "referenced": True}
    for check in (True, False):
        result = run_module(main, name="a", state="absent", _ansible_check_mode=check)
        assert result["error_code"] == "referenced" and result["outcome"] == "unchanged"
        assert result["operation"] == "protect" and result["name"] == "a"
    assert not store.writes


@pytest.mark.parametrize(
    "arguments,changed",
    [({"value": "1"}, False), ({"value": "2"}, True), ({"state": "absent"}, True)],
)
def test_guards_see_whether_the_declaration_changes_anything(
    store: Store,
    run_module: RunModule,
    monkeypatch: pytest.MonkeyPatch,
    arguments: dict[str, Any],
    changed: bool,
) -> None:
    store.rows["a"] = {"name": "a", "value": "1"}
    seen: list[bool] = []
    monkeypatch.setattr(Synthetic, "protect", lambda self: seen.append(self.changed))
    result = run_module(main, name="a", _ansible_check_mode=True, **arguments)
    assert seen == [changed] and result["changed"] is changed


def test_secret_is_unverifiable_and_rotates_only_when_asked(
    store: Store, run_module: RunModule
) -> None:
    created = run_module(main, name="a", secret="s3")
    registered = created.pop("_ansible_new_secrets", [])
    assert set(registered) <= {"s3"}
    assert created["verified"] == "unverifiable" and "s3" not in str(created)
    assert not run_module(main, name="a", secret="s4")["changed"]
    rotated = run_module(main, name="a", secret="s4", update_password="always")
    assert rotated["changed"] and rotated["changed_fields"] == ["secret"]
    store.after = lose
    lost = run_module(main, name="a", secret="s5", update_password="always")
    assert lost["error_code"] == "create_unknown" and lost["outcome"] == "unknown"


@pytest.mark.parametrize("lost_reply", [False, True])
def test_settling_distinguishes_initial_and_post_write_reads(
    store: Store,
    run_module: RunModule,
    monkeypatch: pytest.MonkeyPatch,
    lost_reply: bool,
) -> None:
    phases: list[bool] = []
    original = Synthetic.lookup

    def lookup(self: Synthetic) -> dict[str, Any] | None:
        phases.append(self.settling)
        return original(self)

    monkeypatch.setattr(Synthetic, "lookup", lookup)
    if lost_reply:
        store.after = lose
    result = run_module(main, name="a", value="1")
    assert result["verified"] == "observed"
    assert phases == [False, True] and store.writes == ["create"]


def test_product_loss_classification_is_a_hook(
