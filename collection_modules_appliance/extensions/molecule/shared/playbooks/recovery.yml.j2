# Run one subsystem's recovery drill without the rest of its scenario.
# MOLECULE_RECOVERY_SCENARIO names the scenario and MOLECULE_RECOVERY_SUBSYSTEM
# one of its subsystems, as shared/tasks/recovery_subsystems.yml finds them;
# MOLECULE_SCENARIO_DIRECTORY points at any scenario of this collection.
#
# SPDX-FileCopyrightText: {{ company | default('FIXME your organization') ~ (' <' ~ company_url ~ '>' if company_url | default('') else '') }}
# SPDX-License-Identifier: GPL-3.0-or-later

{% raw %}
---
- name: "Molecule | Recovery"
  hosts: "molecule"
  gather_facts: false
  no_log: "{{ molecule_no_log | ansible.builtin.default(false) }}"
  tasks:
    - name: "Molecule | Recovery | Find the scenarios with recovery hooks"
      delegate_to: "localhost"
      ansible.builtin.find:
        paths: "{{ lookup('ansible.builtin.env', 'MOLECULE_SCENARIO_DIRECTORY') | ansible.builtin.dirname }}"
        depth: 5
        patterns: "induce.yml"
        recurse: true
      register: __recovery_found

    - name: "Molecule | Recovery | Select the scenario"
      ansible.builtin.set_fact:
        __recovery_molecule: "{{ lookup('ansible.builtin.env', 'MOLECULE_SCENARIO_DIRECTORY') | ansible.builtin.dirname }}"
        __recovery_registered: >-
          {{ __recovery_found['files'] | ansible.builtin.map(attribute='path')
             | ansible.builtin.select('ansible.builtin.match', '.*/tasks/recovery/([^/]+/)?induce\.yml$')
             | ansible.builtin.map('ansible.builtin.regex_replace', '^.*/([^/]+)/tasks/recovery/([^/]+/)?induce\.yml$', '\1')
             | ansible.builtin.unique | ansible.builtin.sort }}
        __recovery_scenario: "{{ lookup('ansible.builtin.env', 'MOLECULE_RECOVERY_SCENARIO') | ansible.builtin.trim }}"
        __recovery_subsystem: "{{ lookup('ansible.builtin.env', 'MOLECULE_RECOVERY_SUBSYSTEM') | ansible.builtin.trim }}"

    - name: "Molecule | Recovery | Require a scenario with recovery hooks"
      ansible.builtin.assert:
        that:
          - __recovery_scenario in __recovery_registered
        fail_msg: >-
          Set MOLECULE_RECOVERY_SCENARIO to one of:
          {{ __recovery_registered | ansible.builtin.join(', ') }}
        quiet: true

    - name: "Molecule | Recovery | Find the scenario's subsystems"
      ansible.builtin.include_tasks:
        file: "{{ __recovery_molecule }}/shared/tasks/recovery_subsystems.yml"
      vars:
        __recovery_scenario_directory: "{{ __recovery_molecule }}/{{ __recovery_scenario }}"

    - name: "Molecule | Recovery | Require one of the scenario's subsystems"
      ansible.builtin.assert:
        that:
          - __recovery_subsystem in recovery_subsystems
        fail_msg: >-
          Set MOLECULE_RECOVERY_SUBSYSTEM to one of the subsystems of {{ __recovery_scenario }}:
          {{ recovery_subsystems | ansible.builtin.join(', ') }}
        quiet: true

    - name: "Molecule | Recovery | Drill the subsystem"
      ansible.builtin.include_tasks:
        file: "{{ __recovery_molecule }}/shared/tasks/recovery.yml"
      vars:
        recovery_subsystem: "{{ __recovery_subsystem }}"
        recovery_hooks: >-
          {{ __recovery_molecule ~ '/' ~ __recovery_scenario ~ '/tasks/recovery'
             ~ ('' if __recovery_flat else '/' ~ __recovery_subsystem) }}
{% endraw %}
