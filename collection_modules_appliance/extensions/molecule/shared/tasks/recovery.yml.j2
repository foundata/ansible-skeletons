# Recovery drill of one area: lose the management path through the
# area's own change, restore it through the lab's console endpoint and
# prove fresh API and DNS access through the automation account.
#
# The console endpoint comes from the lab contract. It reads a label and a
# list of guest commands as JSON on stdin and prints one status line, so the
# serial protocol and the root credential stay in the lab's tooling.
# Besides the backup and the restore, an area's hooks may use the console
# for fixtures that the restore undoes; every assertion goes through the API
# and DNS.
#
# Set "recovery_area" (the area's name) and "recovery_hooks" (its hooks
# directory) when including this file. "recovery_defaults" comes from the
# inventory: the lab contract ("lab"), the fresh authenticated read
# ("probe") and the guest commands that save ("backup"), restore
# ("restore") and remove ("discard") the good configuration. The hooks
# directory holds the area's part:
#
# - induce.yml makes the change and may set "recovery_reload", guest
#   commands that run after the restore.
# - absent.yml proves the fixture is gone from saved and loaded state.
# - observe.yml, optional, observes the loss on fresh connections and fails
#   when it cannot, for an area whose change costs only DNS-dependent
#   access. It may set "recovery_observed" for the drill's record. Without
#   it, the drill observes the loss with the API probe.
# - settings.yml, optional, is data, never tasks: "fresh_dns: false" with a
#   "fresh_dns_reason" skips the fresh DNS check, for a scenario that moves
#   the management resolver; "fresh_dns: auto" asks for the management name
#   once before the drill and requires a fresh answer after the restore only
#   when that one came, for an area that drills both in such a scenario and
#   alone. The drill parses the file without templating or running it, and
#   refuses any other key.
#
# SPDX-FileCopyrightText: {{ company | default('FIXME your organization') ~ (' <' ~ company_url ~ '>' if company_url | default('') else '') }}
# SPDX-License-Identifier: GPL-3.0-or-later

{% raw %}
---
- name: "Molecule | Recovery | Start the area's drill"
  ansible.builtin.set_fact:
    __recovery_shared: "{{ lookup('ansible.builtin.env', 'MOLECULE_SCENARIO_DIRECTORY') }}/../shared"
    # The console accepts labels of lowercase letters, digits and dashes.
    __recovery_label: >-
      {{ (recovery_area | ansible.builtin.lower
          | ansible.builtin.regex_replace('[^a-z0-9]+', '-')
          | ansible.builtin.regex_replace('^-+|-+$', ''))[:32] }}
    __recovery_observer: "{{ recovery_hooks }}/observe.yml"
    recovery_reload: []
    recovery_observed: {}
    recovery_fresh_dns: true
    recovery_fresh_dns_reason: ""

# A fresh fact per area: values from include_vars would rank below the
# defaults set_fact gives above, and would outlive their area.
- name: "Molecule | Recovery | Read the area's settings"
  ansible.builtin.set_fact:
    __recovery_settings: >-
      {{ (lookup('ansible.builtin.file', recovery_hooks ~ '/settings.yml')
          | ansible.builtin.from_yaml
          if (recovery_hooks ~ '/settings.yml') is ansible.builtin.file
          else {}) | ansible.builtin.default({}, true) }}

- name: "Molecule | Recovery | Refuse unknown or malformed settings"
  ansible.builtin.assert:
    that:
      - __recovery_settings is ansible.builtin.mapping
      - __recovery_settings.keys() | ansible.builtin.difference(['fresh_dns', 'fresh_dns_reason']) | ansible.builtin.length == 0
      - >-
        __recovery_settings['fresh_dns'] | ansible.builtin.default(true) is ansible.builtin.boolean
        or __recovery_settings['fresh_dns'] | ansible.builtin.default(true) == 'auto'
      - __recovery_settings['fresh_dns_reason'] | ansible.builtin.default('') is ansible.builtin.string
    fail_msg: >-
      {{ recovery_hooks }}/settings.yml holds data with fresh_dns (true, false
      or auto) and fresh_dns_reason (text), nothing else.
    quiet: true

- name: "Molecule | Recovery | Apply the area's settings"
  ansible.builtin.set_fact:
    recovery_fresh_dns: "{{ __recovery_settings['fresh_dns'] | ansible.builtin.default(true) }}"
    recovery_fresh_dns_reason: "{{ __recovery_settings['fresh_dns_reason'] | ansible.builtin.default('') }}"

- name: "Molecule | Recovery | Require the lab contract"
  ansible.builtin.assert:
    that:
      - recovery_defaults['lab']['console']['argv'] | ansible.builtin.default([]) | ansible.builtin.length > 0
      - recovery_defaults['lab']['dns']['name'] | ansible.builtin.default('') | ansible.builtin.length > 0
      - recovery_defaults['lab']['management']['address'] | ansible.builtin.default('') | ansible.builtin.length > 0
    fail_msg: "The lab contract needs console, dns and management entries; see extensions/molecule/README.md."
    quiet: true

- name: "Molecule | Recovery | Require a reason to skip the fresh DNS check"
  ansible.builtin.assert:
    that:
      - recovery_fresh_dns == 'auto' or recovery_fresh_dns | ansible.builtin.bool or recovery_fresh_dns_reason | ansible.builtin.length > 0
    fail_msg: "An area whose settings.yml sets fresh_dns to false names why in fresh_dns_reason."
    quiet: true

- name: "Molecule | Recovery | Require fresh access before the drill"
  ansible.builtin.include_tasks:
    file: "{{ __recovery_shared }}/tasks/recovery_fresh.yml"
  vars:
    __recovery_retries: 30

# With "auto", the answer now decides whether the restore must bring the
# name back; until then the fresh access check above leaves DNS out.
- name: "Molecule | Recovery | Ask once whether the management name answers"
  ansible.builtin.command:
    argv:
      - "{{ ansible_playbook_python }}"
      - "{{ __recovery_shared }}/files/recovery_dns.py"
      - "{{ recovery_defaults['lab']['dns']['host'] }}"
      - "{{ recovery_defaults['lab']['dns']['port'] }}"
      - "{{ recovery_defaults['lab']['dns']['name'] }}"
  when:
    - recovery_fresh_dns == 'auto'
  changed_when:
    - false
  failed_when:
    - false
  register: __recovery_dns_before

- name: "Molecule | Recovery | Require fresh DNS after the restore only if it answered"
  ansible.builtin.set_fact:
    recovery_fresh_dns: "{{ __recovery_answered | ansible.builtin.bool }}"
    recovery_fresh_dns_reason: >-
      {{ recovery_fresh_dns_reason if __recovery_answered | ansible.builtin.bool
         else (['auto: the management name did not answer before the drill', recovery_fresh_dns_reason]
               | ansible.builtin.select | ansible.builtin.join('; ')) }}
  vars:
    __recovery_answered: >-
      {{ recovery_defaults['lab']['management']['address']
         in __recovery_dns_before['stdout_lines'] | ansible.builtin.default([]) }}
  when:
    - recovery_fresh_dns == 'auto'

- name: "Molecule | Recovery | Back the good configuration up through the console"
  ansible.builtin.command:
    argv: "{{ recovery_defaults['lab']['console']['argv'] }}"
    stdin: "{{ {'label': __recovery_label ~ '-backup', 'commands': recovery_defaults['backup']} | ansible.builtin.to_json }}"
  changed_when:
    - true

- name: "Molecule | Recovery | Lose the management path and restore it"
  block:
    - name: "Molecule | Recovery | Induce the loss through the area"
      ansible.builtin.include_tasks:
        file: "{{ recovery_hooks }}/induce.yml"

    - name: "Molecule | Recovery | Observe the loss through the area's hook"
      ansible.builtin.include_tasks:
        file: "{{ __recovery_observer }}"
      when:
        - __recovery_observer is ansible.builtin.file

    - name: "Molecule | Recovery | Observe the loss on fresh API connections"
      ansible.builtin.uri:
        url: "{{ recovery_defaults['probe']['url'] }}"
        force_basic_auth: true
        timeout: 3
        url_password: "{{ recovery_defaults['probe']['password'] }}"
        url_username: "{{ recovery_defaults['probe']['username'] }}"
        validate_certs: "{{ recovery_defaults['probe']['validate_certs'] }}"
      when:
        - __recovery_observer is not ansible.builtin.file
      until:
        - __recovery_loss['status'] | ansible.builtin.default(-1) != 200
      retries: 15
      delay: 1
      failed_when:
        - false
      register: __recovery_loss
      no_log: true

  always:
    - name: "Molecule | Recovery | Note when the restore starts"
      ansible.builtin.set_fact:
        __recovery_started: "{{ now().timestamp() }}"

    - name: "Molecule | Recovery | Restore the good configuration through the console"
      ansible.builtin.command:
        argv: "{{ recovery_defaults['lab']['console']['argv'] }}"
        stdin: >-
          {{ {'label': __recovery_label ~ '-restore',
              'commands': recovery_defaults['restore'] + recovery_reload + recovery_defaults['discard']}
             | ansible.builtin.to_json }}
      changed_when:
        - true
      register: __recovery_console

    - name: "Molecule | Recovery | Wait for fresh access"
      ansible.builtin.include_tasks:
        file: "{{ __recovery_shared }}/tasks/recovery_fresh.yml"
      vars:
        __recovery_retries: 90

    - name: "Molecule | Recovery | Measure the recovery"
      ansible.builtin.set_fact:
        __recovery_seconds: "{{ (now().timestamp() - __recovery_started | ansible.builtin.float) | ansible.builtin.round(3) }}"

- name: "Molecule | Recovery | Require the observed loss"
  ansible.builtin.assert:
    that:
      - __recovery_loss['status'] | ansible.builtin.default(-1) != 200
    fail_msg: "The area's change did not cost fresh API access; the drill proves nothing."
    quiet: true
  when:
    - __recovery_observer is not ansible.builtin.file

- name: "Molecule | Recovery | Prove the fixture is gone"
  ansible.builtin.include_tasks:
    file: "{{ recovery_hooks }}/absent.yml"

- name: "Molecule | Recovery | Record the drill"
  ansible.builtin.debug:
    msg: >-
      {{ {'area': recovery_area,
          'observation': 'observe.yml' if __recovery_observer is ansible.builtin.file else 'api',
          'observed': recovery_observed,
          'lost_api_status': __recovery_loss['status'] | ansible.builtin.default(-1),
          'loss_reads': __recovery_loss['attempts'] | ansible.builtin.default(1),
          'restored_api': true,
          'fresh_dns': true if recovery_fresh_dns | ansible.builtin.bool else recovery_fresh_dns_reason,
          'fixture_absent': true,
          'recovery_seconds': __recovery_seconds,
          'console': __recovery_console['stdout'] | ansible.builtin.from_json} | ansible.builtin.to_json }}
    verbosity: 0
{% endraw %}
