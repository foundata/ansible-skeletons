---
- name: "Clean up the scenario family"
  module_defaults:
    group/{{ namespace }}.{{ collection_name }}.api: >-
      {{ '{{ product_connection }}' }}
  block:
    - name: "Delete the scenario family"
      {{ namespace }}.{{ collection_name }}.fixture_family:
        name: "molecule_fixture_family"
        state: "absent"
